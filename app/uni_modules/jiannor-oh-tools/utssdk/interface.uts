/**
 * interface.uts
 * 插件接口定义文件
 */

// 通用回调参数
export type CommonCallbackResult = {
	errMsg : string
}
export type CommonErrorCallBackResult = {
	errCode ?: number
	errMsg : string
}
// 保持屏幕常亮参数
export type KeepScreenOnOptions = {
	keepScreenOn ?: boolean
	success ?: (res : CommonCallbackResult) => void
	fail ?: (res : any) => void
	complete ?: (res : any) => void
}

// 保持屏幕常亮函数类型
export type SetKeepScreenOn = (options : KeepScreenOnOptions) => void

// 获取当前的地理位置参数
export type GetLocationOptions = {
	/**
	 * 定位类型，可选值：wgs84（GPS坐标），gcj02（国测局坐标）
	 */
	type ?: string
	/**
	 * 传入 true 会返回高度信息，由于获取高度需要较高精确度，会减慢接口返回速度
	 */
	altitude ?: boolean
	/**
	 * 高精度定位超时时间(ms)，指定时间内返回最高精度，该值3000ms以上高精度定位才有效果
	 */
	highAccuracyExpireTime ?: number
	/**
	 * 开启高精度定位
	 */
	isHighAccuracy ?: boolean
	/**
	 * 成功回调
	 */
	success ?: (res : GetLocationSuccess) => void
	/**
	 * 失败回调
	 */
	fail ?: (res : any) => void
	/**
	 * 完成回调
	 */
	complete ?: (res : any) => void
}

// 获取当前的地理位置成功回调结果
export type GetLocationSuccess = {
	/**
	 * 纬度，范围为 -90~90，负数表示南纬
	 */
	latitude : number
	/**
	 * 经度，范围为 -180~180，负数表示西经
	 */
	longitude : number
	/**
	 * 速度，单位 m/s
	 */
	speed : number
	/**
	 * 位置的精确度
	 */
	accuracy : number
	/**
	 * 高度，单位 m
	 */
	altitude ?: number
	/**
	 * 垂直精度，单位 m（Android 无法获取，返回 0）
	 */
	verticalAccuracy ?: number
	/**
	 * 水平精度，单位 m
	 */
	horizontalAccuracy ?: number
	/**
	 * 调用结果
	 */
	errMsg : string
}

// 获取当前的地理位置函数类型
export type GetLocation = (options : GetLocationOptions) => void

// 设置应用角标数字参数
export type SetBadgeNumberOptions = {
	badgeNumber : number,
	/**
	 * 成功回调
	 */
	success ?: (res : SetBadgeNumberSuccess) => void
	/**
	 * 失败回调
	 */
	fail ?: (res : CommonCallbackResult) => void
	/**
	 * 完成回调
	 */
	complete ?: (res : any) => void
}

// 设置应用角标数字成功回调结果
export type SetBadgeNumberSuccess = {
	errMsg : string
}

// 设置应用角标数字函数类型
export type SetBadgeNumber = (options : SetBadgeNumberOptions) => void

// 获取应用ID参数
export type GetAppIdOptions = {
	/**
	 * 成功回调
	 */
	success ?: (res : GetAppIdSuccess) => void
	/**
	 * 失败回调
	 */
	fail ?: (res : any) => void
	/**
	 * 完成回调
	 */
	complete ?: (res : any) => void
}

// 获取应用ID成功回调结果
export type GetAppIdSuccess = {
	/**
	 * 应用ID
	 */
	appId : string
	/**
	 * 调用结果
	 */
	errMsg : string
}

// 获取应用ID函数类型
export type GetAppId = (options : GetAppIdOptions) => void

// ============ 位置变化监听相关接口定义 ============

// 位置变化回调结果
export type OnLocationChangeCallbackResult = {
	/**
	 * 纬度，范围为 -90~90，负数表示南纬
	 */
	latitude : number
	/**
	 * 经度，范围为 -180~180，负数表示西经
	 */
	longitude : number
	/**
	 * 速度 (m/s)
	 */
	speed : number
	/**
	 * 位置的精确度
	 */
	accuracy : number
	/**
	 * 高度 (m)
	 */
	altitude ?: number
	/**
	 * 垂直精度 (m)
	 */
	verticalAccuracy ?: number
	/**
	 * 水平精度 (m)
	 */
	horizontalAccuracy ?: number
	/**
	 * 定位到的城市信息
	 */
	city ?: string
	/**
	 * 城市编码
	 */
	cityCode ?: string
	/**
	 * 街道名称
	 */
	street ?: string
	/**
	 * 国家
	 */
	country ?: string
	/**
	 * 国家代码
	 */
	countryCode ?: string
	/**
	 * 省份
	 */
	province ?: string
	/**
	 * 街道号码
	 */
	streetNumber ?: string
	/**
	 * 区
	 */
	district ?: string
	/**
	 * 是不是精确定位信息
	 */
	isFullAccuracy ?: boolean
	/**
	 * 海拔的精确度信息
	 */
	altitudeAccuracy ?: number
}

// 位置变化错误回调结果
export type OnLocationChangeErrorCallbackResult = {
	/**
	 * 错误码
	 */
	errCode : number
	/**
	 * 错误信息
	 */
	errMsg : string
}

// 开始位置更新参数
export type StartLocationUpdateOptions = {
	/**
	 * 定位类型，可选值：wgs84（GPS坐标），gcj02（国测局坐标）
	 */
	type ?: string
	/**
	 * 成功回调
	 */
	success ?: (res : CommonCallbackResult) => void
	/**
	 * 失败回调
	 */
	fail ?: (res : any) => void
	/**
	 * 完成回调
	 */
	complete ?: (res : any) => void
}

// 停止位置更新参数
export type StopLocationUpdateOptions = {
	/**
	 * 成功回调
	 */
	success ?: (res : CommonCallbackResult) => void
	/**
	 * 失败回调
	 */
	fail ?: (res : any) => void
	/**
	 * 完成回调
	 */
	complete ?: (res : any) => void
}
export type StartAbilitySuccess = {
	errMsg : string
}

export type StartAbilityFailResult = {
	errCode : number,
	errMsg : string
}

export type StartAbilityByTypeFailResult = {
	errCode ?: number,
	errName ?: string
	errMsg : string
}

export type StartAbilityOptions = {
	url : string
	success ?: (res : StartAbilitySuccess) => void
	fail ?: (err : StartAbilityFailResult) => void
	complete ?: (res : any) => void
}

export type StartAbilityByNavigationOptions = {
	originLatitude : number,
	originLongitude : number,
	originName : string,
	destinationLatitude : number,
	destinationLongitude : number,
	destinationName : string,
	success ?: (res : StartAbilitySuccess) => void
	fail ?: (err : StartAbilityByTypeFailResult) => void
	complete ?: (res : any) => void
}

export type LoacationOptions = {
	latitude : number,
	longitude : number,
}
export type LocationChoosingOptionsCallBackResult = {
	location : LoacationOptions,
	searchEnabled : boolean,
	showNearbyPoi : boolean,
	success ?: (res : ChoosingLocationResult) => void,
	fail ?: (err : CommonCallbackResult) => void,
	complete ?: (res : any) => void
}

export type ChoosingLocationResult = {
	errMsg : string,
	siteId : string,
	location : LoacationOptions,
	name : string,
	address : string,
	zoom : number,
	// addressInfo:string
}
export enum BluetoothStateEnum {
	STATE_ERR = -1,
	STATE_OFF = 0,
	STATE_TURNING_ON = 1,
	STATE_ON = 2,
	STATE_TURNING_OFF = 3,
	STATE_BLE_TURNING_ON = 4,
	STATE_BLE_ON = 5,
	STATE_BLE_TURNING_OFF = 6
}

export type GetBluetoothStateCallbackResult = {
	success ?: (res : BluetoothStateEnum) => void,
	fail ?: (err : CommonCallbackResult) => void,
	complete ?: (res : any) => void
}
// 位置变化监听器函数类型
export type OnLocationChangeCallback = (result : OnLocationChangeCallbackResult) => void
export type OnLocationChangeErrorCallback = (result : OnLocationChangeErrorCallbackResult) => void

// 位置变化监听函数类型
export type OnLocationChange = (callback : OnLocationChangeCallback) => void
export type OffLocationChange = (callback ?: OnLocationChangeCallback) => void
export type OnLocationChangeError = (callback : OnLocationChangeErrorCallback) => void
export type OffLocationChangeError = (callback ?: OnLocationChangeErrorCallback) => void
export type StartLocationUpdate = (options : StartLocationUpdateOptions) => void
export type StopLocationUpdate = (options : StopLocationUpdateOptions) => void
export type StartAbility = (options : StartAbilityOptions) => void
export type StartAbilityByNavigation = (options : StartAbilityByNavigationOptions) => void
export type LocationChoosing = (options : LocationChoosingOptionsCallBackResult) => void
export type GetBluetoothState = (options : GetBluetoothStateCallbackResult) => void

// 蓝牙状态变化回调结果
export type OnBluetoothStateChangeCallbackResult = {
	/**
	 * 蓝牙状态
	 */
	state : BluetoothStateEnum
	/**
	 * 错误信息
	 */
	errMsg ?: string
}

// 蓝牙状态变化监听器函数类型
export type OnBluetoothStateChangeCallback = (result : OnBluetoothStateChangeCallbackResult) => void
export type OnBluetoothStateChangeErrorCallback = (result : CommonCallbackResult) => void

// 蓝牙状态变化监听函数类型
export type OnBluetoothStateChange = (callback : OnBluetoothStateChangeCallback) => void
export type OffBluetoothStateChange = (callback ?: OnBluetoothStateChangeCallback) => void
export type OnBluetoothStateChangeError = (callback : OnBluetoothStateChangeErrorCallback) => void
export type OffBluetoothStateChangeError = (callback ?: OnBluetoothStateChangeErrorCallback) => void

