<template>
	<view class="container">
		<!-- 引导层 -->
		<!-- <GuideLayer :show="isShowGuild != 8" :height="mapHeight" :src="GuildSrc" :screenheight="screenheight"
			:statusBarHeight="WindowInfo.statusBarHeight" @click="addlocateGuild" /> -->
		<!-- 顶部信息栏 (Android) v-if="isShowGuild === 8 && loadobject"-->
		<TopInfoBar v-if="!showHaveDevice" :data="topBarData" @showFloorTitle="showFloorTitle"
			@nagivation="handleOpenMap(true)" @refresh="reFresh(true)" @change-target="changeTarget"
			@model-change="toModelChange" />
		<AlertModal v-if='showFloor' :infodata=locateInfoData :height="mapHeight" @closeFloor="showFloorTitle" @correct="openCorrect"  />
		<view class="mask" :style="{ height: mapHeight+'px' }" v-if="toMapping" style="z-index: 999;width: 750rpx;"
			@touchstart.stop @touchmove.stop @touchend.stop>
			<view class="col_center" style="margin-top: 800rpx;" :style="{ width: screenwidth+'px'}">
				<view style="background-color: #FFFFFF;width:500rpx;border-radius: 40rpx;">
					<view class="row_center" style="height: 100rpx;border-bottom: 0.5px solid rgba(229, 229, 229, 1);">
						<text style=" line-height: 50rpx;color:rgba(255, 87, 51, 1);">选择地图应用</text>
					</view>
					<view @click="toMapAPP(0)" class="row_center"
						style="height: 100rpx;border-bottom: 0.5px solid rgba(229, 229, 229, 1);">
						<text style=" line-height: 50rpx;">百度地图</text>
					</view>
					<view @click="toMapAPP(1)" class="row_center" style="height: 100rpx;">
						<text style=" line-height: 50rpx;">高德地图</text>
					</view>

				</view>
				<view class="row_center" style="width: 500rpx;margin-top: 30rpx;border-radius: 15px;">
					<view
						style="background-image: linear-gradient(to right, rgba(255, 88, 88, 1), rgba(240, 152, 25, 1));height: 34px; display: flex;align-items: center;justify-content: center; width: 500rpx;border-radius: 60rpx;"
						@click="handleOpenMap(false)">
						<text style="color: #FFFFFF;">取消</text>
					</view>
				</view>
			</view>
		</view>
		<view :style="{ height: mapHeight+'px' }" style="position: relative;">
			<map id='map' enable-rotate="false" :enable-satellite='enableSatellite' :show-location="false" class="map"
				enable-overlooking='true' :latitude="latitude" :longitude="longitude" :polygons="polygons"
				@tap="onMapTap" @markertap="markertap" @callouttap="callouttap" @regionchange="onregionchange"
				:scale="mapScale" :markers="markers" :circles="circles">
				<view style="position: relative;">
					<!-- <view
						style=" position: absolute;right: 8px;top:80rpx;display: flex;flex-direction: column;align-items: center;">
						<image @click="openHelp" class="help-icon" :src="darkMode=='light'?'/static/new/icon-help.svg':'/static/new/icon-help-light.svg'" mode=""
							style="width: 120rpx;height: 120rpx;"></image>
						<text class="help-text">帮助</text>
					</view>
					<view
						style=" position: absolute;right: 8px;top:200rpx;display: flex;flex-direction: column;align-items: center;">
						<image @click="openCorrect" src="/static/imgs/locate/correct.png"
							style="width: 120rpx;height: 120rpx;"></image>
					</view> -->
					<view class="top-button">
						<view class="help-wrapper" @click="openHelp">
							<image class="help-icon"
								:src="darkMode=='light'?'/static/new/icon-help-png.png':'/static/new/icon-help-png.png'"
								mode=""></image>
							<text class="help-text">帮助</text>
						</view>
						<view class="setting-correct">
							<view class="sc-area" @click="toBellSetting">
								<image class="help-icon"
									:src="darkMode=='light'?'/static/new/icon-setting-png.png':'/static/new/icon-setting-light.svg'"
									mode=""></image>
								<text class="help-text">设置</text>
							</view>
							<view class="divider-sc"></view>
							<view class="sc-area" @click="openCorrect">
								<image class="help-icon"
									:src="darkMode=='light'?'/static/new/icon-correct-png.png':'/static/new/icon-correct-light.svg'"
									mode=""></image>
								<text class="help-text">纠偏</text>
							</view>
						</view>
					</view>
					<!-- <view style="position: absolute;left: 8px;display: flex;flex-direction: column;align-items: center;"
						:style="{top:let_right_bottom+'px'}">
						<image @click="handleOpenMap(true)" src='/static/imgs/locate/navigation.png'
							style="width: 120rpx;height: 120rpx;"></image>
						<view class="row_center" style="height: 15rpx;width:120rpx">
						</view>
						<image @click="ladarPet" :src="ladarUrl" style="width: 120rpx;height: 120rpx;"></image>
						<view class="row_center" style="height: 15rpx;width:120rpx;">
						</view>
						<image @click="railPet" :src="railUrl" style="width: 120rpx;height: 120rpx;"></image>
						<view class="row_center" style="height: 15rpx;width:120rpx;">
						</view>
						<image @click="leadPet" :src="leadUrl" style="width: 120rpx;height: 120rpx;"></image>
					</view> -->
					<view class="left-tools" :style="{top:let_right_bottom+'rpx'}">
						<view class="sc-area" style="border-radius: 12rpx;"
							:style="{height:'140rpx',backgroundColor:stopLadarToast?(darkMode=='light'?'rgba(255, 87, 51, 0.1)':'#3d3d3d'):(darkMode=='light'?'#FFF':'#000')}"
							@click="ladarPet">
							<image class="tool-icon" :src="ladarUrl" mode=""></image>
							<text class="tool-text">寻宠</text>
						</view>
						<view class="divider-tools"></view>
						<view class="sc-area"
							:style="{height:'140rpx',backgroundColor:railToast||railing?(darkMode=='light'?'rgba(255, 87, 51, 0.1)':'#3d3d3d'):(darkMode=='light'?'#FFF':'#000')}"
							@click="railPet">
							<image class="tool-icon" :src="railUrl" mode=""></image>
							<text class="tool-text">围栏</text>
						</view>
						<view class="divider-tools"></view>
						<view class="sc-area"
							:style="{height:'140rpx',backgroundColor:leading?(darkMode=='light'?'rgba(255, 87, 51, 0.1)':'#3d3d3d'):(darkMode=='light'?'#FFF':'#000')}"
							@click="leadPet">
							<image class="tool-icon" :src="leadUrl" mode=""></image>
							<text class="tool-text">牵引</text>
						</view>
						<view class="divider-tools"></view>
						<view class="sc-area" @click="dataRoute" :style="{height:'140rpx'}">
							<image class="tool-icon" src="/static/new/5@3x.png" mode=""></image>
							<text class="tool-text">轨迹</text>
						</view>
					</view>
					<view class="right-tools" :style="{top:let_right_bottom+'rpx'}">
						<view class="setting-correct">
							<view class="sc-area" style="border-radius: 12rpx;" @click="clickedRgbOrBell('bell')"
								:style="{backgroundColor:clickBell?(darkMode=='light'?'rgba(255, 87, 51, 0.1)':'#3d3d3d'):(darkMode=='light'?'#FFF':'#000')}">
								<image class="help-icon"
									:src="darkMode=='light'?'/static/new/icon-buzzer-png.png':'/static/new/icon-buzzer-light.svg'"
									mode=""></image>
								<text
									:class="waitBellText !== '' ? 'control-text' : 'help-text'">{{waitBellText !== ''?waitBellText:'响铃'}}</text>
							</view>
							<view class="divider-sc"></view>
							<view class="sc-area" @click="clickedRgbOrBell('rgb')" style="border-radius: 12rpx;"
								:style="{backgroundColor:clickRgb?(darkMode=='light'?'rgba(255, 87, 51, 0.1)':'#3d3d3d'):(darkMode=='light'?'#FFF':'#000')}">
								<image class="help-icon"
									:src="darkMode=='light'?'/static/new/icon-rgb-png.png':'/static/new/icon-rgb-light.svg'"
									mode=""></image>
								<text
									:class="waitRgbText !== '' ? 'control-text' : 'help-text'">{{waitRgbText!=''?waitRgbText:'灯光'}}</text>
							</view>
						</view>
						<view class="location-switch" @click="changeTarget">
							<image class="sight-icon"
								:src="darkMode=='light'?'/static/new/icon-sight-png.png':'/static/new/icon-sight-light.svg'">
							</image>
						</view>
					</view>
					<view v-if="stopLadarToast" class="rssi-contant"
						:style="{top:marginTopHeight-240 * WindowInfo.pixelRatio-65-550*WindowInfo.pixelRatio,left:'130rpx'}">
						<view class="row_center" style="width: 490rpx;height: 550rpx;position: relative;">
							<view class="rotate-background" :style="{ transform: 'rotate('+ladarRotateAngle+'deg)'}">
								<image src="/static/imgs/locate/ladarSearch.png" style="width: 320rpx;height: 320rpx;">
								</image>
							</view>
							<view class="rssi-flicker">
								<view class="blinking-text"><text
										style="font-size: 50rpx;color: #FFFFFF;">{{RSSI}}</text></view>
							</view>
							<view class="rotate-bottom-text">
								<view class="row_center" style="height: 50rpx;"><text
										style="font-size: 28rpx;color:  rgba(255, 87, 51, 1);;">信号数值范围0~100</text>
								</view>
								<view class="row_center" style="height: 50rpx;"><text
										style="font-size: 28rpx;color:  rgba(255, 87, 51, 1);;">{{RSSIText}}
									</text><text v-if="!bluetoothConnect">{{dots}} </text></view>
							</view>
						</view>

					</view>

					<view class="maplabel_rail" v-if="outinside" :style="{ width: screenwidth+'px'}">
						<view class="col_center" style="width: 220px;background-color: #ffffff;border-radius: 30px;">
							<view style="align-items: center;padding-left: 5px;margin-top: 20rpx;">
								<text style="width: 200px;">宠悦悦提醒您，您的宠物已经越过电子围栏</text>
							</view>
							<view class="row_around" style="margin-top: 15rpx;margin-bottom: 20rpx;width: 200px;">
								<view @click="closeRail(actionPolygonIndex)" class="myButton"><text
										style="color: #ffffff;">关闭</text>
								</view>
								<view @click="sureRail(1)" class="myButton"><text style="color: #ffffff;">重置</text>
								</view>
							</view>
						</view>
					</view>
					<view v-if="showCountdown" style="position: absolute;flex-direction: row;justify-content: center;"
						:style="countdownTopType">
						<view style="display: flex;
							flex-direction: row;
							align-items: center;
							width: 190px;
							height: 65px;
							justify-content: center;
							position: relative;">
							<image src="../../static/xixin/countdown.png" style="width:190px;height:65px;">
							</image>
							<view
								style="position: absolute;flex-direction: column;align-items: center;justify-content: center;padding-left: 80rpx;">
								<text style="color: rgba(255, 87, 51, 1);font-size: 28rpx;">{{countdown}}</text>
								<text style="font-size: 28rpx;">内切换到高频</text>
							</view>
						</view>
					</view>
					<view v-if="petDistanceOver" class="maplabel_rail" :style="{ width: screenwidth+'px'}">
						<view class="distanceview">
							<view><cach-image url="/static/imgs/home/logo.png" fileMd5="/static/imgs/home/logo.png"
									width="80rpx" height="80rpx" radius="50%"></cach-image></view>
							<view style="align-items: center;padding-left: 5px;">
								<text style="width: 150px;">宠悦悦提醒您，您的宠物已离开您的牵引范围</text>
							</view>
						</view>
					</view>
					<view class="mask" :style="{ height: mapHeight+'px' }" style="width: 750rpx;" v-if="showHaveDevice">
						<view class="drawtoast">
							<view style="background-color: #ffffff;width:250px;border-radius: 30px;">
								<view class="topBar">
									<text class="title">温馨提示</text>
								</view>
								<view style="align-items: center;padding-left: 5px;">
									<text
										style="padding-left: 20rpx;padding-right: 20rpx; line-height: 50rpx;">地图界面需要设备数据，请先回主页添加设备</text>
								</view>
								<view
									style="flex-direction: row;justify-content: space-between;width: 250px;margin-bottom: 15rpx;">
									<view></view>
									<view class="myButton" @click="goHome"><text style="color: #FFFFFF;">确定</text>
									</view>
									<view></view>
								</view>

							</view>
						</view>
					</view>
					<view class="mask" :style="{ height: mapHeight+'px' }" style="width: 750rpx;" v-if="showWifiPoint">
						<view class="drawtoast">
							<view style="background-color: #ffffff;width:250px;border-radius: 30px;">
								<view class="topBar">
									<text class="title">温馨提示</text>
								</view>
								<view style="align-items: center;padding-left: 5px;">
									<text
										style="padding-left: 20rpx;padding-right: 20rpx; line-height: 50rpx;">设置家庭Wifi可以提高定位精度，点击确定前去设置</text>
								</view>
								<view
									style="flex-direction: row;justify-content: space-between;width: 250px;margin-bottom: 15rpx;margin-top: 10rpx;">
									<view></view>
									<view class="myButton" @click="cancWifiSet">
										<text style="color: #FFFFFF;">取消</text>
									</view>
									<view class="myButton" @click="setWifi"><text style="color: #FFFFFF;">确定</text>
									</view>
									<view></view>
								</view>
								<view @click="nolonger()"
									style="flex-direction: row; width: 250px;justify-content: center;align-items: center;height:70rpx;">
									<view style="width: 50rpx;height: 30rpx;">
										<view v-if="!remind"
											style=" width:25rpx;height: 25rpx;border-radius: 12rpx;border:solid #c5c5c5 1px;margin-right: 20rpx;">
										</view>
										<view v-if="remind"
											style=" width:25rpx;height: 25rpx;border-radius: 12rpx;border:solid #c5c5c5 1px;margin-right: 20rpx;background-color: rgba(255, 87, 51, 1);">
										</view>
									</view>
									<text style="font-size: 23rpx;color: rgb(125,125,125);">不再提醒</text>
								</view>
							</view>
						</view>
					</view>
					<view class="mask" :style="{ height: mapHeight+'px' }" style="width: 750rpx;"
						v-if="showDeleteRailTitle!=-1">
						<view class="drawtoast">
							<view style="background-color: #FFFFFF;width:250px;border-radius: 30px;">
								<view class="topBar">
									<text class="title">温馨提示</text>
								</view>
								<view style="align-items: center;padding-left: 5px;">
									<text
										style="padding-left: 20rpx;padding-right: 20rpx; line-height: 50rpx;">点击确定后将删除此条围栏，请点击确认删除</text>
								</view>
								<view
									style="flex-direction: row;justify-content: space-between;width: 250px;margin-bottom: 15rpx;">
									<view></view>
									<view class="myButton" @click="sureDeleteRail(0)">
										<text style="color: #FFFFFF;">取消</text>
									</view>
									<view class="myButton" @click="sureDeleteRail(1)"><text
											style="color: #FFFFFF;">确定</text></view>
									<view></view>
								</view>
							</view>
						</view>
					</view>
					<view class="mask" style="width: 750rpx;" :style="{height:screenheight+'px'}" v-if="ladarToast"
						@touchstart.stop @touchmove.stop @touchend.stop>
						<view class="drawtoast" style="width:250px">
							<view style="background-color: #FFFFFF;width:250px;border-radius: 30px;">
								<view class="topBar">
									<text class="title">雷达寻宠</text>
								</view>
								<view style="align-items: center;padding-left: 5px;">
									<text
										style="padding-left: 20rpx;padding-right: 20rpx;line-height: 50rpx;">开启雷达寻宠，蓝牙将持续搜索您附近已关联宠物的绑定设备
										，信号值越强说明设备与您距离越近,是否开启该功能.</text>
									<text
										style="padding-left: 20rpx;padding-right: 20rpx;line-height: 50rpx;">（搜索过程中请勿关闭蓝牙，蓝牙探测范围15米左右）</text>
								</view>
								<view
									style="flex-direction: row;justify-content: space-between;width: 250px;padding-bottom: 15rpx;padding-top: 10rpx;">
									<view></view>
									<view class="myButton" @click="cancleLadar">
										<text style="color: #FFFFFF;">取消</text>
									</view>
									<view class="myButton" @click="sureLadar(true)"><text
											style="color: #FFFFFF;">确定</text></view>
									<view></view>
								</view>
							</view>
						</view>
					</view>
					<view class="mask" style="width: 750rpx;" :style="{height:screenheight+'px'}" v-if="drawToast">
						<view class="drawtoast">
							<view class="lead">
								<view class="topBar">
									<text class="title">电子牵引</text>
								</view>
								<view style="align-items: center;display: flex;justify-content: center;">
									<text
										style="padding: 20rpx;line-height: 50rpx;">开启电子牵引，围绕本人设置一个半径30米范围，宠物离开这个范围App会发送通知
										（开启过程中请不要关闭App）</text>
								</view>
								<view
									style="flex-direction: row;justify-content: space-between;width: 250px;margin-bottom:15rpx">
									<view></view>
									<view class="myButton" @click="cancleLead(true)">
										<text style="color: #FFFFFF;">取消</text>
									</view>
									<view class="myButton" @click="sureLead">
										<text style="color: #FFFFFF;">确定</text>
									</view>
									<view></view>
								</view>
							</view>

						</view>
					</view>
					<view class="mask" style="width: 750rpx;" :style="{height:screenheight+'px'}"
						v-if="showOfflineTitle">
						<view class="drawtoast" style="width: 600rpx;">
							<view class="lead" style="width: 600rpx;">
								<view class="topBar" style="width: 600rpx;">
									<text class="title">温馨提示</text>
								</view>
								<view style="align-items: center;display: flex;justify-content: center;">
									<text style="padding: 20rpx;line-height: 50rpx;">您的项圈设备已离线，可能是因为电量不足或信号不佳。</text>
								</view>
								<view
									style="align-items: center;display: flex;justify-content: left;flex-direction: row;">
									<text style="padding: 0px 20rpx;line-height: 50rpx;">尝试以下操作：</text>
								</view>
								<view style="align-items: center;display: flex;justify-content: center;">
									<text
										style="padding: 0px 20rpx;line-height: 50rpx;">1.检查电量：设备可能因电量耗尽而离线。若电量低，请立即充电。</text>
								</view>
								<view style="align-items: center;display: flex;justify-content: center;">
									<text
										style="padding: 0px 20rpx;line-height: 50rpx;">2.检查信号：设备可能处于信号较弱或无信号区域（地下室，山区）。请将设备移至开阔区域，等待信号恢复。</text>
								</view>
								<view style="align-items: center;display: flex;justify-content: center;">
									<text
										style="padding: 0px 20px 0rpx 20rpx;line-height: 50rpx;">3.联系客服：如果问题仍未解决，请点击联系客服，进一步获取帮助</text>
								</view>
								<view
									style="flex-direction: row;justify-content: space-between;width: 600rpx;margin-bottom:20rpx;margin-top: 20rpx;">
									<view></view>
									<view class="myButton" @tap="closeOfflineTitle(0)">
										<text style="color: #FFFFFF;">我知道了</text>
									</view>
									<view class="myButton" @tap="closeOfflineTitle(1)">
										<text style="color: #FFFFFF;">联系客服</text>
									</view>
									<view></view>
								</view>
							</view>

						</view>
					</view>
					<cover-view v-if="railToast" class="row_center" style="position: absolute;"
						:style="{ width: screenwidth+'px',top:marginTopHeight-240 * WindowInfo.pixelRatio-65-350*WindowInfo.pixelRatio-10 +'px'}">
						<cover-view v-if="!showNewRail" class="col_start"
							style="z-index: 1; width: 400rpx;background-color: #FFFFFF;height: 350rpx; border-radius: 40rpx;">
							<view class="row_between" style="width: 360rpx;margin-top: 10rpx;">
								<view style="width: 30rpx;height: 50rpx;"></view>
								<view><text style="font-size: 28rpx;">电子围栏</text></view>
								<view @click="railPet()" class="row_center" style="width: 50rpx;height: 70rpx;">
									<image src="/static/imgs/global/close.png" style="width: 20rpx;height: 20rpx;">
									</image>
								</view>
							</view>
							<view class="col_between" style="width: 360rpx;height: 240rpx;padding-top: 30rpx;">
								<view v-for="(item, index) in localSavePolygons">
									<view v-if="item.points.length>0" class="row_start"
										style=" height: 52rpx; width: 360rpx;border:1px solid rgba(222, 222, 222, 0.5); border-radius: 20px;">
										<view @click="clickNewRail(item,index)" class="row_start"
											style="width: 220rpx;">
											<view>
												<image src="/static/imgs/locate/rail_home.png"
													style="width: 25rpx;height: 25rpx;margin-left: 20rpx;"></image>
											</view>
											<view style="margin-left: 25rpx;"><text
													style="lines: 1;text-overflow:ellipsis;width: 150rpx; font-size:25rpx; color: rgba(255, 87, 51, 1);">{{item.name}}</text>
											</view>
										</view>
										<view class="row_end" style="width: 140rpx;">
											<image @click="switchRail(index)"
												:src="item.switch?'/static/imgs/locate/on.png':'/static/imgs/locate/off.png'"
												src="" style="width: 65rpx;height: 65rpx;margin-right: 25rpx;"></image>
											<image @click="deleteRail(index)" src="/static/imgs/locate/delete.png"
												style="width: 35rpx;height: 35rpx;margin-right: 20rpx;"></image>
										</view>
									</view>
									<view @click="clickNewRail(item,index)" v-if="item.points.length<=0"
										class="row_start"
										style=" height: 52rpx; width: 360rpx;border:1px solid rgba(222, 222, 222, 0.5); border-radius: 20px;">
										<view class="row_start" style="width:220rpx;">
											<view>
												<image src="/static/imgs/locate/add.png"
													style="width: 25rpx;height: 25rpx;margin-left: 20rpx;"></image>
											</view>
											<view style="margin-left: 25rpx;"><text
													style="lines: 1;text-overflow:ellipsis;width: 150rpx; font-size:25rpx; color: rgba(166, 166, 166, 1);">新建围栏</text>
											</view>
										</view>
									</view>
								</view>
							</view>
						</cover-view>
						<cover-view v-if="showNewRail" class="col_start"
							style="z-index: 2; width: 400rpx;background-color: #FFFFFF;height: 450rpx; border-radius: 40rpx;">
							<view class="row_between" style="width: 360rpx;margin-top: 20rpx;">
								<view style="width: 30rpx;height: 50rpx;"></view>
								<view><text
										style="font-size: 28rpx;width: 200rpx;color: rgba(255, 87, 51, 1);">按顺序点击地图上位置形成围栏</text>
								</view>
								<view @click="cancleRail" class="row_center" style="width: 50rpx;height: 70rpx;">
									<image src="/static/imgs/global/close.png" style="width: 20rpx;height: 20rpx;">
									</image>
								</view>
							</view>
							<view>
								<image src="/static/imgs/locate/railGuild.png" style="width: 238rpx;height: 180rpx;">
								</image>
							</view>
							<view class="row_between"
								style="margin-top: 20rpx; width: 300rpx;border-bottom: 0.5px solid rgba(229, 229, 229, 1);">
								<view style="width: 180rpx;"><text
										style="color:rgba(56, 56, 56, 1);font-size: 28rpx;">围栏名称</text></view>
								<view style="width: 180rpx;"> <input type="text"
										v-model="localSavePolygons[clickPolygonIndex].name" maxlength="4"
										placeholder="请输入"
										style="margin-left: 5rpx; font-size: 28rpx; height: 50rpx;text-align: end;" />
								</view>
							</view>
							<view class="row_around" style="width: 360rpx;margin-top: 20rpx;">
								<view @click="reDrawRail()" class="myButton" style="width: 120rpx;height: 60rpx;"><text
										style="color: #FFFFFF;font-size: 30rpx;">重绘</text></view>
								<view @click="saveNewRail()" class="myButton" style="width: 120rpx;height: 60rpx;"><text
										style="color: #FFFFFF;font-size: 30rpx;">保存</text></view>
							</view>
						</cover-view>
					</cover-view>
					<cover-view class="row_center" :style="topType"></cover-view>
				</view>
			</map>
		</view>
	</view>
</template>

<script>
	// var bgKeepAlive = uni.requireNativePlugin("wrs-bgKeepAlive");
