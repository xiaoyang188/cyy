		result.success = false;
		result.errMsg = err.errMsg
		return result
	}
}

/**
 * 清空Preferences
 *
 * uni-app项目中（vue/nvue）调用示例：
 * 1、引入方法声明 import { clearPreferences } from "@/uni_modules/jiannor-preference"
 * 2、方法调用
 * clearPreferences({
 *   name: 'myPrefs',
 *   success: (res) => {
 *      console.log(res)
 *   }
 * });
 * 
 * @uniPlatform {
 *   "app": {
 *     "android": {
 *       "osVer": "5.0",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     },
 *     "ios": {
 *       "osVer": "12.0",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     },
 *     "harmony": {
 *       "osVer": "x",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     }
 *   }
 * }
 * @uniVersion 4.25
 * @uniVueVersion 2,3
 * @autotest { generated: true }
 */
export const clearPreferences : ClearPreferences = function (options : ClearPreferencesOptions) {
	// 参数校验
	if (options.name == null || options.name.length == 0) {
		const error = new PreferencesFailImpl(9010005);
		options.fail?.(error);
		options.complete?.(error);
		return;
	}

	try {
		// 获取UserDefaults实例
		const userDefaults = getUserDefaults(options.name);

		// 获取所有键并删除
		const dictionary = userDefaults.dictionaryRepresentation();
		const keys = dictionary.keys;

		for (const key in keys) {
			userDefaults.removeObject(forKey = key);
		}

		userDefaults.synchronize();

		const result : ClearPreferencesResult = {
			success: true
		};
		options.success?.(result);
		options.complete?.(result);
	} catch (error) {
		console.error(`Failed to clear preferences. Error:${error}`);
		const err = new PreferencesFailImpl(9010005);
		options.fail?.(err);
		options.complete?.(err);
	}
}

export function clearPreferencesSync(name : string) : PreferencesSyncResult {
	let result : PreferencesSyncResult = {
		success: false,
		data: "",
		errMsg: ""
	}

	if (name == null || name.trim() == '') {
		const err = new PreferencesFailImpl(9010005);
		console.error("clearPreferencesSync参数错误: name为空或无效", err);
		result.success = false;
		result.errMsg = err.errMsg
		return result
	}

	try {
		const userDefaults = getUserDefaults(name);

		// 获取所有键并删除
		const dictionary = userDefaults.dictionaryRepresentation();
		const keys = dictionary.keys;

		for (const key in keys) {
			userDefaults.removeObject(forKey = key);
		}

		userDefaults.synchronize();
		result.success = true;
		result.data = null;
		return result
	} catch (error) {
		console.error("clearPreferencesSync捕获错误:", error);
		const err = new PreferencesFailImpl(9010004);
		console.error("clearPreferencesSync抛出错误:", err);
		result.success = false;
		result.errMsg = err.errMsg
		return result
	}
}
/**
 * 删除Preferences文件
 *
 * uni-app项目中（vue/nvue）调用示例：
 * 1、引入方法声明 import { deletePreferences } from "@/uni_modules/jiannor-preference"
 * 2、方法调用
 * deletePreferences({
 *   name: 'myPrefs',
 *   success: (res) => {
 *      console.log(res)
 *   }
 * });
 * 
 * @uniPlatform {
 *   "app": {
 *     "android": {
 *       "osVer": "5.0",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     },
 *     "ios": {
 *       "osVer": "12.0",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     },
 *     "harmony": {
 *       "osVer": "x",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     }
 *   }
 * }
 * @uniVersion 4.25
 * @uniVueVersion 2,3
 * @autotest { generated: true }
 */
export const deletePreferences : DeletePreferences = function (options : DeletePreferencesOptions) {
	// 参数校验
	if (options.name == null || options.name.length == 0) {
		const error = new PreferencesFailImpl(9010003);
		options.fail?.(error);
		options.complete?.(error);
		return;
	}

	try {
		// 获取UserDefaults实例
		const userDefaults = getUserDefaults(options.name);

		// 获取所有键并删除
		const dictionary = userDefaults.dictionaryRepresentation();
		const keys = dictionary.keys;

		for (const key in keys) {
			userDefaults.removeObject(forKey = key);
		}

		userDefaults.synchronize();

		// 从缓存中移除
		userDefaultsMap.delete(options.name);

		const result : DeletePreferencesResult = {
			success: true
		};
		options.success?.(result);
		options.complete?.(result);
	} catch (error) {
		console.error(`Failed to delete preferences. Error:${error}`);
		const err = new PreferencesFailImpl(9010003);
		options.fail?.(err);
		options.complete?.(err);
	}
}

