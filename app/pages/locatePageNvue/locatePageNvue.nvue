			},
			startCountdown(targetTime) {
				console.log('targetTime', targetTime)
				const now = new Date();
				const target = new Date(targetTime);
				if (target <= now) {
					// console.log('目标时间已过');
					this.getPetPositionNew(this.loadobject, false, true);
					this.countdown = '1(分钟)'
					return;
				}
				const diff = target - now;
				this.countdown = Math.floor(diff / 1000); // 转换为分钟
				if (this.countdown > 60) {
					this.countdown = Math.floor(this.countdown / 60)
					this.countdown = this.countdown.toString() + '(分钟)'
				} else {
					this.countdown = '1(分钟)'
				}
				// this.countdownTimer = setInterval(() => {
				// const newNow = new Date();
				// const newDiff = target - newNow;
				// let second = Math.floor(newDiff / 1000);
				// if (newDiff <= 0) {
				// 	this.countdown = '1(分钟)'
				// 	this.getPetPositionNew(this.loadobject, false, true);
				// 	// clearInterval(this.countdownTimer);
				// 	console.log('倒计时结束1');
				// } else {
				// 	if (second > 60) {
				// 		second = Math.floor(second / 60)
				// 		this.countdown = second.toString() + '(分钟)'
				// 	} else {
				// 		this.countdown = '1(分钟)'
				// 	}
				// 	// console.log('this.countdown', this.countdown)
				// }
				// }, 30000); // 每10秒更新一次
			},
			initData() {
				this.outinside = false
				this.drawRange = 30
				this.leadTime = null
				this.stopLadarToast = false
				this.ladarToast = false
				this.ladaring = false
				this.drawToast = false
				this.railToast = false
				this.railing = false
				this.leading = false
				this.mapScale = 16
				this.petDistanceOver = false
				this.petDistance = 0
				this.leadUrl = '/static/new/2@3x.png'
				this.railUrl = '/static/new/3@3x.png'
				this.ladarUrl = '/static/new/1@3x.png'
				this.markers = new Array()
				this.polygonsPoints = new Array(),
					this.localSavePolygons = [{
						points: new Array(),
						name: "",
						switch: false,
					}, {
						points: new Array(),
						name: "",
						switch: false,
					}, {
						points: new Array(),
						name: "",
						switch: false,
					}]
				this.actionPolygonIndex = 0
				this.polygons = [{
					points: [

					],
					strokeWidth: 2,
					strokeColor: '#FF0000',
					fillColor: '#00FF00',
					zIndex: 1,
				}, ]
				this.circles = []
				this.sureleading = false
				this.blueToothDeviceId = null
				this.clickBell = false
				this.clickRgb = false
				this.clickBellImgSrc = '/static/imgs/locate/bell.png'
				this.clickRgbImgSrc = '/static/imgs/locate/light.png'
				this.focusTarget = 0
			},

			isEqual(arr1, arr2) {
				if (arr1.length !== arr2.length) return false;
				for (let i = 0; i < arr1.length; i++) {
					if (arr1[i].latitude !== arr2[i].latitude || arr1[i].longitude !== arr2[i].longitude) return false;
				}
				return true;
			},
			checkRail() {
				//查询一下服务器围栏开启状态，如果服务器围栏打开，但是本地是关闭就要同步一下
				//这种情况就本地添加服务器的围栏，默认保存到第一个 
				try {
					let geofenceUrl = getApp().globalData.internet + getApp().globalData
						.geofence;
					let para = {
						serial_code: this.loadobject.serialCode,
					}
					util.requestDataJsonGET(geofenceUrl, para).then((rebackData) => {
						console.log('获取到的围栏数据', rebackData)
						if (rebackData.code === 200) {
							let data = rebackData.data
							if (data.state === "on") {
								//本地添加围栏数据 服务器围栏打开 本地同步一下
								let polygon = data.geofence.polygon
								this.polygonsPoints = []
								for (let i = 0; i < polygon.length; i += 2) {
									var point = {
										latitude: polygon[i], // 偶数索引是纬度
										longitude: polygon[i + 1] // 奇数索引是经度
									}
									this.polygonsPoints.push(point);
								}
								var findIndex = -1
								let polysort = this.sortByClockwiseOrder(this.polygonsPoints);
								for (var index = 0; index < this.localSavePolygons.length; index++) {
									var element = this.localSavePolygons[index];
									this.localSavePolygons[index].switch = false
									if (this.isEqual(element.points, polysort))
										findIndex = index
								}
								// console.error('this.localSavePolygons',this.localSavePolygons)
								if (findIndex === -1) {
									findIndex = this.localSavePolygons.findIndex(element => element.points
										.length <= 0);
									this.localSavePolygons[findIndex].name = '围栏' + this.actionPolygonIndex
										.toString()
								}
								// console.error('this.findIndex',findIndex)
								if (findIndex === -1)
									findIndex = 0
								this.actionPolygonIndex = findIndex
								var marker = this.markers.filter(item => item.id <= 3)
								this.markers = [];
								this.markers = marker;
								var poly = [{
									points: polysort,
									strokeWidth: 2,
									strokeColor: '#FF0000',
									fillColor: 'rgba(255,0,0,0.2)',
									zIndex: 1,
								}, ]
								this.polygons = poly
								//拿polysort 和本地的this.localSavePolygons做对比找出index 找不到就默认覆盖第一个
								this.railing = true
								this.localSavePolygons[findIndex].points = polysort
								this.localSavePolygons[findIndex].switch = true

								//显示围栏
							} else {
								//服务器围栏关闭 本地同步一下
								this.closeRail(this.actionPolygonIndex)
							}
						}
					})
				} catch (error) {
					console.log('error', error)
				}

			},
			loadPageData() {
				// console.log('获取缓存的页面缓存', data);
				this.firmwareVersion = getApp().globalData.myFirewareVersion
				console.log('this.firmwareVersion', this.firmwareVersion)
				if (this.loadobject.data != null) {
					let data = this.loadobject.data
					try {
						this.remind = data.remind
						this.outinside = data.outinside
						this.margintop = data.margintop
						this.drawRange = data.drawRange
						this.leadTime = data.leadTime
						this.signalStrength = data.signalStrength
						this.stopLadarToast = data.stopLadarToast
						this.ladarToast = data.ladarToast
						this.ladaring = data.ladaring
						this.drawToast = data.drawToast
						this.railToast = data.railToast
						this.railing = data.railing
						this.leading = data.leading
						this.mapScale = data.mapScale
						this.petDistanceOver = data.petDistanceOver
						this.petDistance = data.petDistance
						this.leadUrl = data.leadUrl
						this.railUrl = data.railUrl
						this.ladarUrl = data.ladarUrl
						this.categoryId = data.categoryId
						// if (this.markers.length > 1) {
						// 	data.markers[0] = this.markers[0]
						// 	data.markers[1] = this.markers[1]
						// }
						this.markers = data.markers
						this.polygonsPoints = data.polygonsPoints
						this.localSavePolygons = data.localSavePolygons
						this.actionPolygonIndex = data.actionPolygonIndex
						this.polygons = data.polygons
						this.circles = data.circles
						// this.petAvatar = data.petAvatar
						this.sureleading = data.sureleading
						this.blueToothDeviceId = data.blueToothDeviceId
						this.clickBell = data.clickBell
						this.clickRgb = data.clickRgb
						this.clickBellImgSrc = data.clickBellImgSrc
						this.clickRgbImgSrc = data.clickRgbImgSrc
						this.focusTarget = data.focusTarget
						if (this.stopLadarToast)
							setTimeout(() => {
								this.keepLadar()
							}, 700)
						if (this.sureleading)
							setTimeout(() => {
								this.keepLeading()
							}, 700)
						//如果markers里有null  这里加把缓存手机位置清除是为了解决有的用户反映手机位置和家庭wifi重合，位置不变
						console.log('过滤前marker', this.markers)
						this.markers = this.markers.filter(item => item !== null && item.id !== undefined);
						let newMarker = this.markers.slice(0);
						this.markers = new Array();
						this.markers = newMarker;
						this.moveToPet()
						console.log('过滤过的marker', this.markers)
					} catch (e) {
						console.log('获取页面缓存出错', e);
					}
				} else {
					//发生在宠物切换，另一只第一次进来不能显示之前的宠物位置，当时还没缓存
					this.initData()
				}
			},
			controltap(e) {
				let vm = this
				if (e.detail.controlId === 0) {
					this.reFresh();
				}
			},
			initCompass(res) {
				// console.log('罗盘回调', res);
				this.avatarDirection = res.direction - 180;
				if (this.avatarDirection < 0)
					this.avatarDirection += 360;
				let phone = this.markers.find(item => item.id === 0)
				if (phone) {
					let dis = Math.abs(phone.rotate - this.avatarDirection)
					if (phone && dis > 10) {
						phone.rotate = this.avatarDirection
						this.findeOrChangeById(phone, this.markers)
						let newMarker = this.markers.slice(0);
						this.markers = new Array();
						this.markers = newMarker;
						// console.log('phone',this.markers)
					}
				}
			},
			convertToFormat(head, str) {
				var constr = "";
				for (var i = 0; i < str.length; i++) {
					var char = str.charAt(i);
					if (char >= 'a' && char <= 'z') {
						char = char.toUpperCase();
					}
					constr += char;
				}

				var result = head + '-' + constr.slice(6);
				return result;
			},

			onregionchange() {
				let that = this
				this._mapContext.getScale({
					success: (res) => {
						// console.log('获取缩放尺度',res)
						let index = Math.trunc(res.scale) - 3
						// console.log('index',index)
						that.scaleShow = that.scaleArray[index]
						// console.log('that.mapScale',that.scaleShow)
					},
					fail: (err) => {

					}
				})
			},
			onMapTap(event) {
				// 当地图被点击时触发
				//点击了电子围栏才有效
				if (this.showNewRail) {
					const latitude = event.detail.latitude;
					const longitude = event.detail.longitude;
					// 更新经纬度信息
					// this.latitude = latitude;
					// this.longitude = longitude;
					var point = {
						latitude: latitude,
						longitude: longitude,
					}
					//判断是否有重叠，不重叠继续，重叠了提醒用户，并且不加
					this.polygonsPoints.push(point);
					// let polysort = this.sortByClockwiseOrder(this.polygonsPoints);
					var polygon = [{
						points: this.polygonsPoints,
						strokeWidth: 2,
						strokeColor: '#FF0000',
						fillColor: 'rgba(255,0,0,0.2)',
						zIndex: 1,
					}, ]
					this.polygons = polygon;
					console.log('this.polygonsPoints=', this.polygonsPoints);

					// 创建标记点
					var marker = [{
						id: this.markers[this.markers.length - 1].id + 4,
						latitude,
						longitude,
						iconPath: '../../static/xixin/railPoint.png', // 自定义标记图标路径
						width: 32,
						height: 32,
						callout: {
							content: "撤销",
							display: "ALWAYS",
							color: '#ff5500',
							bgColor: 'rgba(255, 255, 255, 1)',
							textAlign: 'center',
							borderRadius: '5px',
							borderColor: 'rgba(255, 85, 0, 1.0)',
							borderWidth: 1,
							padding: 4
						}
					}, ];
					var newMarker = this.markers.slice(0);
					newMarker.push(marker[0]);
					this.markers = newMarker;
					// console.log('this.polygonsPoints', this.polygonsPoints);
					// console.log('this.polygons', this.polygons);
					// console.log('this.markers', this.markers);
					// this.markers = marker;
				}

			},
			sortByClockwiseOrder(points) {
				// 计算数组中每个点的极坐标角度
				function getAngle(point) {
					const {
						latitude,
						longitude
					} = point;
					const y = latitude - center.latitude;
					const x = longitude - center.longitude;
					return Math.atan2(y, x);
				}

				// 计算数组中心点
				function getCenterPoint(points) {
					const sum = points.reduce(
						(accumulator, point) => {
							return {
								latitude: accumulator.latitude + point.latitude,
								longitude: accumulator.longitude + point.longitude
							};
						}, {
							latitude: 0,
							longitude: 0
						}
					);
					const count = points.length;
					return {
						latitude: sum.latitude / count,
						longitude: sum.longitude / count
					};
				}

				// 按照角度进行排序
				function compareAngles(point1, point2) {
					const angle1 = getAngle(point1);
					const angle2 = getAngle(point2);
					return angle1 - angle2;
				}

				const center = getCenterPoint(points);
				return points.sort(compareAngles);
			},

			stopLadar(options) {
				console.log('into stop ladar');
				
				if (options&&this.stopLadarToast) {
					if (getApp().globalData.myFirewareVersion > 34||this.loadobject.serialCode.substring(0,2)==='ae') {
						console.log('执行蓝牙关闭rgb和蜂鸣器', this.blueToothCharacteristicId)
						if (this.clickRgb)
							this.clickRgbFun('rgb', true, false, false)
						setTimeout(() => {
							if (this.clickBell)
								this.clickRgbFun('bell', true, false, false)
						}, 500)
					}
				}
				this.stopLadarToast = false;
				this.ladaring = false;
				this.RSSI = 0;
				this.progressNumber = 0;
				this.ladarRotateAngle = 0;
				clearInterval(this.intervalId2);
				this.intervalId2 = null;
				this.sendLocateMode(this.loadobject, 0);
			},
			ladarInterval(opt) {
				let cnt = 0;
				let that = this;
				this.intervalId2 = setInterval(() => {
					cnt++;
					if (this.stopLadarToast) {
						this.ladarRotateAngle += 20;
						if (this.ladarRotateAngle >= 360)
							this.ladarRotateAngle = 0;
						// console.log("getApp().globalData.myFirewareVersion", getApp().globalData.myFirewareVersion)
						if (opt&&cnt === 15 && (getApp().globalData.myFirewareVersion > 34||this.loadobject.serialCode.substring(0,2)==='ae')) {
							if (!this.clickRgb) {
								 console.log("进入蓝牙打开rgb")
								this.clickRgbFun('rgb', true, false, true)
							}
							setTimeout(() => {
								if (!this.clickBell) {
									this.clickRgbFun('bell', true, false, true)
								}
							}, 500)
						}
						if (cnt % 10 === 0) {
							// console.log('into get rssi')
							if (that.bluetoothConnect) {
								uni.getBLEDeviceRSSI({
									deviceId: this.blueToothDeviceId,
									success(res) {
										// console.log('拿到设备的蓝牙ssi', res);
										var RSSI = res.RSSI
										if (RSSI >= 0) {
											RSSI = -100;
										}
										that.RSSI = RSSI + 100;
										if (that.RSSI < 0)
											that.RSSI = 0;
										if (that.RSSI > 60)
											that.RSSI = 60
										that.RSSI = Math.floor(that.RSSI / 0.6)
									},
									fail(res) {
										console.log('获取ssi失败', res)

									}
								})

							}
						}
					}
				}, 100);
			},
			async sureLadar(option) {
				let that = this
				if (this.bluetoothAdapterAvailable === 2) {
					if (that.bluetoothConnect === false) {
						that.RSSIText = '蓝牙连接中'
					}
					that.ladarToast = false;
					that.stopLadarToast = true;
					that.ladaring = true;
					that.ladarToast = false;
					that.storageLocateStatue(true);
					//把图标变成黑色
					// this.ladarUrl = "../../static/xixin/clickladar.png"
					that.coverIcon(1)
					uni.showLoading({
						title: '蓝牙连接中'
					})
					console.log('this.blueToothDeviceId', that.blueToothDeviceId)
					console.log('this.bluetoothConnect', that.bluetoothConnect)
					uni.hideLoading()
					that.ladarInterval(option)
					that.savePage()

				} else {
					that.cancleLadar()
					uni.showModal({
						title: '提示',
						content: '此功能需要打开蓝牙，请检查蓝牙和权限'
					})
				}
			},

			sureLead() {
				if (this.bluetoothConnect === false) {
					uni.showModal({
						title: '提示',
						content: '此功能需要连接蓝牙，请靠近设备，蓝牙会自动连接。'
					})
					// this.searchBluetoothLogo=true
					this.cancleLead(true)
				} else {
					this.storageLocateStatue(true);
					this.sureleading = true;
					this.drawToast = false;
					this.mapScale = 18
				}
			},
			storageLocateStatue(statue) {
				const Index = getApp().globalData.locateIsRuningArray.findIndex(item => {
					return item.serial_code === this.loadobject.serialCode
				});
				if (Index !== -1) {
					getApp().globalData.locateIsRuningArray[Index].locateStatue = statue;
					let savedata = JSON.stringify(getApp().globalData.locateIsRuningArray);
					uni.setStorage({
						key: 'locateIsRuning',
						data: savedata,
						success: function() {
							console.log('railOut数据缓存成功');
						}
					});
				}
			},

			deleteRailPoint() {
				//多边形和marker的尾部去掉一个点
				if (this.polygonsPoints.length > 0) {
					var points = this.polygonsPoints.slice(0, this.polygonsPoints.length - 1);
					this.polygonsPoints = [];
					this.polygonsPoints = points;
					var polygon = [{
						points: points,
						strokeWidth: 2,
						strokeColor: '#FF0000',
						fillColor: 'rgba(255,0,0,0.2)',
						zIndex: 1,
					}, ]

					if (this.markers[this.markers.length - 1].id > 3) {
						var marker = this.markers.slice(0, this.markers.length - 1);
						this.markers = [];
						this.markers = marker;
					}
					// this.polygons = polygon;
					// console.log('this.polygons', this.polygons);
				} else {
					uni.showToast({
						title: '没点可删了',
						icon: 'none'
					})

				}
				// if (this.homeWifi != null) {
				// 	if (this.markers.length > 3) {
				// 		var marker = this.markers.slice(0, this.markers.length - 1);
				// 		this.markers = [];
				// 		this.markers = marker;
				// 	}
				// } else {
				// 	if (this.markers.length > 2) {
				// 		var marker = this.markers.slice(0, this.markers.length - 1);
				// 		this.markers = [];
				// 		this.markers = marker;
				// 	}
				// }

			},
			reDrawRail() {
				this.clearPolygonsPoints();
				// var marker = this.markers.slice(0, 2);
				let marker = this.markers.filter(item => item.id <= 3)
				this.markers = [];
				this.markers = marker;
				// this.localSavePolygons[this.clickPolygonIndex].points = []

			},
			saveNewRail() {
				if (this.polygonsPoints.length > 2) {
					let polysort = this.sortByClockwiseOrder(this.polygonsPoints);
					this.localSavePolygons[this.clickPolygonIndex].points = polysort
					//如果围栏是打开的 切换显示运行的围栏
					if (this.localSavePolygons[this.actionPolygonIndex].switch) {
						this.clearPolygonsPoints();
						this.polygonsPoints = this.localSavePolygons[this.actionPolygonIndex].points
						this.sureRail(1)
					}
					var marker = this.markers.filter(item => item.id <= 3)
					this.markers = [];
					this.markers = marker;

					this.showNewRail = false
					this.railToast = false
					setTimeout(() => {
						this.railToast = true
					}, 50)
				} else {
					uni.showToast({
						title: '至少要三个点哦',
						icon: 'none'
					})
				}
			},
			sureRail(source) {
				//是缓存还是按钮点击
				//把围栏点按照顺序排一遍
				let polysort = this.sortByClockwiseOrder(this.polygonsPoints);
				var polygon = [{
					points: polysort,
					strokeWidth: 2,
					strokeColor: '#FF0000',
					fillColor: 'rgba(255,0,0,0.2)',
					zIndex: 1,
				}, ]
				this.polygons = polygon;
				let ployToService = new Array();
				//把点集合成一维数组发给服务器
				console.log('polysort', polysort);
				for (let i = 0; i < polysort.length; i++) {
					console.log('polysort[i]', polysort[i]);
					ployToService.push(polysort[i].latitude);
					ployToService.push(polysort[i].longitude);
				}
				//判断多边形的点大于两个
				//然后开始循环十秒检测一次宠物位置
				//计算是否出圈
				console.log('this.polygons', this.polygons);
				if (this.polygons.length > 0) {
					if (this.polygons[0].points.length > 2) {
						//直接调用后端接口
						if (source === 1) {
							return new Promise((resolve, reject) => {
								var deviceAccount = getApp().globalData.internet + getApp().globalData
									.electronicFence;
								console.log('围栏url', deviceAccount)
								uni.request({
									url: deviceAccount, //仅为示例，并非真实接口地址。
									method: 'POST',
									data: {
										switch: 1,
										did: this.loadobject.did,
										serial_code: this.loadobject.serialCode,
										pid: this.loadobject.pid,
										pet_nickname: this.loadobject.pname,
										polygon: ployToService
									},
									header: {
										'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' //重点
									},
									success: (res) => {
										resolve(res);
									},
									fail: ((err) => {
										reject(err);
									})
								});
							}).then(res => {
								console.log('第一次给服务器发送开始围栏', res);
								if (res.data.code === 200) {
									this.railing = true;
									// this.localSavePolygons[this.actionPolygonIndex].points = this.polygons[0].points
									this.localSavePolygons[this.actionPolygonIndex].switch = true
									// this.storageLocateStatue(true);
									for (let i = 0; i < this.localSavePolygons.length; i++) {
										if (this.localSavePolygons[i].switch === true && i != this
											.actionPolygonIndex)
											this.localSavePolygons[i].switch = false
									}
									if (!res.data.data.inside) {
										this.outinside = true;
										getApp().globalData.railOut = true;
									} else {
										this.outinside = false;
										getApp().globalData.railOut = false;
									}
									this.savePage()
								} else {
									uni.showToast({
										title: res.data.msg,
										icon: 'none'
									})
								}

							}, err => {
								console.log('第一次给服务器发送开始围栏失败', err);
							});

						}
						// var point = {
						// 	longitude: this.markers[1].longitude,
						// 	latitude: this.markers[1].latitude
						// }
						// this.outinside = this.isPointInPolygon(point, this.polygons[0].points)
					} else {
						uni.showToast({
							title: '至少要三个点哦',
							icon: 'none'
						})
					}
				} else {
					uni.showToast({
						title: '至少要三个点哦',
						icon: 'none'
					})
				}
			},
			async leadPet(opt) {
				uni.showLoading({
					title: 'loading'
				})
				await new Promise((resolve) => setTimeout(resolve, 1000));
				uni.hideLoading()
				if (!this.drawToast && !this.railToast && !this.ladarToast && !this.stopLadarToast && !this.railing) {
					if (!this.leading) {
						this.drawToast = !this.drawToast;
						// if (this.drawToast) { //获取一下滑动条位置，半径
						// 	this.drawRange = 30
						// 	this.getsliderRect()
						// }
					}
					this.petDistanceOver = false;
					getApp().globalData.leadOut = false;
					let savedata = JSON.stringify(getApp().globalData.leadOut);
					uni.setStorage({
						key: 'leadOut',
						data: savedata,
						success: function() {
							console.log('railOut数据缓存成功');
						}
					});
					this.leading = !this.leading;
					if (this.leading === false) {
						this.drawToast = false;
						this.circles = new Array();
						//关闭后台位置检测
						this.sureleading = false;
					}
					console.log('this.leading', this.leading);
					if (this.leading) {
						// this.leadUrl = '../../static/xixin/clickLead.png';
						this.coverIcon(3)

					} else {
						// this.leadUrl = '../../static/xixin/Lead.png';
						this.coverIcon(0)
						// if (!this.ladaring && !this.railing) {
						// 	this.storageLocateStatue(false);
						// }
						//调用服务器的关闭lead接口
						//这里调用服务器打开牵引的接口
						let that = this;
						return new Promise((resolve, reject) => {
							var deviceAccount = getApp().globalData.internet + getApp().globalData
								.electronicTraction;
							uni.request({
								url: deviceAccount,
								method: 'POST',
								data: {
									switch: 0,
									did: that.loadobject.did,
									serial_code: that.loadobject.serialCode,
								},
								header: {
									'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
								},
								success: (res) => {
									resolve(res);
								},
								fail: ((err) => {
									reject(err);
								})
							});
						}).then(res => {
							console.log('给服务器发送关闭牵引', res);
						}, err => {
							console.log('发送关闭牵引出错', err);
						});
					}
				} else {
					uni.showToast({
						icon: 'loading',
						title: '请先关掉其他功能'
					})
				}
			},

			async ladarPet() {
				// console.log('this.railing', this.railing);
				// console.log('this.railToast', this.railToast);
				// console.log('this.drawToast', this.drawToast);
				// console.log('this.ladarToast', this.ladarToast);
				console.error('this.stopLadarToast', this.stopLadarToast);
				// console.log('this.leading', this.leading);
				uni.showLoading({
					title: 'loading'
				})
				await new Promise((resolve) => setTimeout(resolve, 1000));
				uni.hideLoading()
				if (!this.railing && !this.railToast && !this.drawToast && !this.ladarToast && !this.leading) {
					//显示弹窗关闭弹窗
					if (!this.ladaring) {
						this.ladarToast = !this.ladarToast;
					}
					this.ladaring = false;
					console.log('this.ladaring', this.ladaring);
					if (this.ladaring) {
						// this.ladarUrl = '../../static/xixin/clickladar.png';
						this.coverIcon(1)
					} else {
						if (!this.leading && !this.railing) {
							this.storageLocateStatue(false);
						}
						this.stopLadar(true);
						this.coverIcon(0)
					}
					this.savePage()
				} else {
					uni.showToast({
						icon: 'loading',
						title: '请先关掉其他功能'
					})
				}
			},
			async railPet() {
				// uni.showLoading({
				// 	title: 'loading'
				// })
				// await new Promise((resolve) => setTimeout(resolve, 1000));
				// uni.hideLoading()
				if (!this.drawToast && !this.ladarToast && !this.stopLadarToast && !this.leading) {
					this.railToast = !this.railToast;
					if (this.railToast) {
						this.coverIcon(2)
					} else {
						if (!this.railing) {
							this.clearPolygonsPoints();
							var marker = this.markers.filter(item => item.id <= 3)
							this.markers = [];
							this.markers = marker;
						}

						this.coverIcon(0)
					}
				} else {
					uni.showToast({
						icon: 'loading',
						title: '请先关掉其他功能'
					})
				}
			},
			clearPolygonsPoints() {
				// var points = this.polygonsPoints.slice(0, 0);
				// this.polygonsPoints = [];
				this.polygonsPoints = [];
				this.polygons = [{
					points: [],
					strokeWidth: 2,
					strokeColor: '#FF0000',
					fillColor: 'rgba(255,0,0,0.2)',
					zIndex: 1,
				}, ]
				// this.polygons = polygon;
			},
			cancleLadar() {
				this.ladarToast = false;
				this.ladaring = false;
			},
			cancleRail() {
				this.clearPolygonsPoints();
				var marker = this.markers.filter(item => item.id <= 3)
				this.markers = [];
				this.markers = marker;
				this.polygonsPoints = this.localSavePolygons[this.actionPolygonIndex].points
				this.polygons = [{
					points: this.polygonsPoints,
					strokeWidth: 2,
					strokeColor: '#FF0000',
					fillColor: 'rgba(255,0,0,0.2)',
					zIndex: 1,
				}, ]
				//没点保存应该复原本地原本存储的围栏

				this.showNewRail = false
				this.railToast = false
				setTimeout(() => {
					this.railToast = true
				}, 50)
			},
			keepLeading() {
				this.leading = true;
				this.sureleading = true;
				this.drawToast = false;
				console.log('keep lead petDistanceOver', this.petDistanceOver);
				this.coverIcon(3)
			},
			keepLadar() {
				this.ladarToast = false;
				this.stopLadarToast = true;
				this.ladaring = true;
				this.ladarToast = false;
				this.storageLocateStatue(true);
				this.ladarInterval(false)
				// this.blinkInterval = setInterval(() => {
				// 	this.dotCount = (this.dotCount + 1) % 4; // 循环增加点的数量，最多到3个
				// 	this.dots = '...'.substring(0, this.dotCount); // 根据点的数量设置dots的值
				// }, 500);
			},
			cancleLead(opt) {
				if (opt)
					this.drawToast = false;
				this.leading = false;
				this.sureleading = false;
				this.petDistanceOver = false;
				this.circles = new Array();
				// this.leadUrl = '../../static/xixin/Lead.png';
				this.coverIcon(0)
			},
			returnParent() {
				if (this.sureleading) {
					uni.showModal({
						title: '电子牵引',
						content: '返回主页电子牵引将被关闭',
						success: function(res) {
							if (res.confirm) {
								getApp().backParents();
							} else if (res.cancel) {

							}
						}
					})
				} else {
					getApp().backParents();
				}
			},
			async reFresh(show) {
				show = show ?? false;
				const now = Date.now();
				var diff = now - this.refreshTime; // 处理初始值为undefined的情况
				if (diff < 4000) {
					uni.showToast({
						title: '操作太频繁了',
						icon: 'none'
					})
					return; // 直接返回，不执行后续代码
				}
				// 立即更新时间戳，防止重复点击
				this.refreshTime = now;

				var commandUrl = getApp().globalData.internet_cyy + getApp().globalData.sendCommand;
				var data = {
					uid: this.loadobject.uid,
					serialCode: this.loadobject.serialCode,
					commandType: COMMAND_TYPE.SINGLE_LOCATION,
					commandValue: 1
				};
				sendCommand(data).then(res => {
					if (show) {
						uni.showToast({
							title: '发送成功请耐心等待',
							icon: 'none'
						})
					}
				}).catch(err => {
					this.refreshTime = 0;
				})
				// try {
				// const res = await util.requestDataJson(commandUrl, data);
				// console.log('res', res);
				// if (res.data.code === '200') {
				// 	if (show) {
				// 		uni.showToast({
				// 			title: '发送成功请耐心等待',
				// 			icon: 'none'
				// 		})
				// 	}
				// } else {
				// 	throw new Error('单次命令发送失败' + res.data.msg);
				// }
				// } catch (err) {
				// 	if (show) {
				// 		uni.showToast({
				// 			title: err.message || err.errMsg,
				// 			icon: 'none'
				// 		})
				// 	}
				// 	// 可选：请求失败时重置时间戳，允许用户重试
				// 	this.refreshTime = 0;
				// }
			},
			dataRoute() {
				//需要设备的数据 去轨迹界面查看
				// this.unpdataUserPosition = false;
				// uni.offCompassChange(this.initCompass);
				// if (!this.drawToast && !this.railToast && !this.ladarToast && !this.railing && !this.stopLadarToast && !
				// 	this.leading) {
				var obj = {
					did: this.loadobject.did,
