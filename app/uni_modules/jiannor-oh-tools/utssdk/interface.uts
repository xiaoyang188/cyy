export type onDataReceiveOptions = {
	dataReceive ?: (content : string) => void,
	receiveEnd ?: () => void
}

export type onDataReceiveCallback = (options : onDataReceiveOptions) => void

export type OnShareDataOptions = {
	dataReceive ?: (record : UTSJSONObject[]) => void,
	error ?: (err : any) => void
}

export type OnShareDataCallback = (options : OnShareDataOptions) => void

