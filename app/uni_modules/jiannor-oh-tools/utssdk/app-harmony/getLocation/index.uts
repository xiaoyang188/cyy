/**
 * 获取当前的地理位置
 * 使用鸿蒙原生 getCurrentLocation API 实现
 */
export const getLocation : GetLocation = function (options : GetLocationOptions) {
	// 默认参数
	const type = options.type || 'wgs84';
	const altitude = options.altitude || false;
	const isHighAccuracy = options.isHighAccuracy || false;
	const highAccuracyExpireTime = options.highAccuracyExpireTime || 3000;

	// 检查定位权限
	checkLocationPermission().then((hasPermission : boolean) => {
		if (!hasPermission) {
			const error = {
				errMsg: 'getLocation:fail 缺少定位权限',
				errCode: 1001
			};
			options.fail?.(error);
			options.complete?.(error);
			return;
		}

		// 配置定位请求参数
		const requestInfo : geoLocationManager.CurrentLocationRequest = {
			priority: isHighAccuracy ?
				geoLocationManager.LocationRequestPriority.ACCURACY :
				geoLocationManager.LocationRequestPriority.FIRST_FIX,
			scenario: geoLocationManager.LocationRequestScenario.UNSET,
			timeoutMs: highAccuracyExpireTime,
			maxAccuracy: isHighAccuracy ? 0 : 100
		};

		try {
			// 调用鸿蒙原生定位API
			geoLocationManager.getCurrentLocation(requestInfo, (err : BusinessError, location : geoLocationManager.Location) => {
				if (err) {
					console.error(TAG, 'getCurrentLocation failed:', err);
					const error = {
						errMsg: `getLocation:fail ${err.message}`,
						errCode: err.code
					};
					options.fail?.(error);
					options.complete?.(error);
					return;
				}

				// 获取原始坐标（WGS84）
				let resultLatitude = location.latitude;
				let resultLongitude = location.longitude;

				// 根据 type 参数进行坐标系转换
				if (type === 'gcj02') {
					// WGS84 到 GCJ02 的坐标转换

					const convertedCoords = wgs84ToGcj02(resultLongitude,resultLatitude)
					resultLongitude = convertedCoords[0];
					resultLatitude = convertedCoords[1];
				}

				// 构造返回结果
				const result : GetLocationSuccess = {
					latitude: resultLatitude,
					longitude: resultLongitude,
					speed: location.speed || 0,
					accuracy: location.accuracy || 0,
					horizontalAccuracy: location.accuracy || 0,
					altitude: altitude && location.altitude !== undefined ? location.altitude : null,
					verticalAccuracy: altitude && location.altitude !== undefined ? (location.accuracy || 0) : null,
					errMsg: 'getLocation:ok'
				};

				console.info(TAG, 'getCurrentLocation success:', result);
				options.success?.(result);
				options.complete?.(result);
			});
		} catch (exception) {
			console.error(TAG, 'getCurrentLocation exception:', exception);
			const error = {
				errMsg: `getLocation:fail ${exception.message || '定位失败'}`,
				errCode: -1
			};
			options.fail?.(error);
			options.complete?.(error);
		}
	}).catch((error) => {
		console.error(TAG, 'checkLocationPermission failed:', error);
		const err = {
			errMsg: 'getLocation:fail 权限检查失败',
			errCode: 1002
		};
		options.fail?.(err);
		options.complete?.(err);
	});
};

/**
 * 检查定位权限
 */
async function checkLocationPermission() : Promise<boolean> {
	try {
		const atManager = abilityAccessCtrl.createAtManager();
		const context = AppStorageV2.connect(UIContext, 'uiContext', () => new UIContext())?.getHostContext() as common.UIAbilityContext;

		// 检查精确定位权限
		const locationPermission : Permissions = 'ohos.permission.APPROXIMATELY_LOCATION';
		const preciseLocationPermission : Permissions = 'ohos.permission.LOCATION';

		const locationGrantStatus = await atManager.checkAccessToken(
			context.applicationInfo.accessTokenId,
			locationPermission
		);

		const preciseLocationGrantStatus = await atManager.checkAccessToken(
			context.applicationInfo.accessTokenId,
			preciseLocationPermission
		);

		return locationGrantStatus === abilityAccessCtrl.GrantStatus.PERMISSION_GRANTED ||
			preciseLocationGrantStatus === abilityAccessCtrl.GrantStatus.PERMISSION_GRANTED;
	} catch (error) {
		console.error(TAG, 'checkLocationPermission error:', error);
		return false;
	}
}