<template>
	<view class="container">
		<!-- 导航栏 -->
		<view class="map-view" :style="{ height: mapHeight+'px' }">
			<map id='map' class="map" :polyline="polyline" :enable-satellite='enableSatellite' :show-location="false"
				v-if="mapviz===true" :latitude="latitude" :scale="18" :longitude="longitude" :markers="markers"
				@markertap="markertap" @callouttap="callouttap" @regionchange="onregionchange">
				<view style="position: relative;">
					<view
						style="position: absolute;left: 18px;top:120rpx;display: flex;flex-direction: column;align-items: center;background-color: rgb(255,255,255);border-radius: 30rpx;">
						<image @click="returnParent" src="/static/icons/public/icon-back.png"
							style="width: 60rpx;height: 60rpx;"></image>
					</view>
					<view class="row_center" style="position: absolute;box-shadow: 0px 0px 4px rgba(0, 0, 0, 0.20);"
						:style="scrollStyle">
						<div class="row_center" :style="{width:dataWidth+'px'}" style="height: 150rpx;width: 700rpx;">
							<scroll-view class="scroll-view-container" scroll-x="true" show-scrollbar="false">
								<view class="col_start" v-for="(date, index) in dates" :key="index"
									@click="dateClick(date.date,index)">
									<view><text
											style="font-size: 26rpx;color: rgba(128, 128, 128, 1);">{{date.days}}</text>
									</view>
									<view :class="clickIndex!=index?'date-item':'date-item-clicked'"><text
											:class="clickIndex!=index?'date-text':'date-text-clicked'">{{ date.date.substring(8,10) }}</text>
									</view>
								</view>
							</scroll-view>
						</div>
					</view>
					<view class="dataShow" style="position: absolute;" :style="dataStyle">
						<div class="row_between" style="margin-bottom: 10rpx;" :style="{width:dataWidth+'px'}">
							<view class="row_start" style="width: 360rpx;height: 60rpx;">
								<view class="row_center"
									style=" width: 175rpx; height: 60rpx; padding-left: 5rpx;padding-right: 5rpx;border-radius: 25rpx;">
									<image src="/static/imgs/locate/gaode.png" style="width: 40rpx;height: 40rpx;">
									</image>
									<view class="col_center">
										<text style="font-size: 25rpx;color: #000000;font-weight: 700;">高德地图</text>
										<text style="font-size: 13rpx;">{{mapNumber}}</text>
									</view>
								</view>
								<view class="row_start"
									style="position: relative; width: 175rpx; height: 60rpx; padding-left: 5rpx;padding-right: 5rpx;border-radius: 25rpx;">
									<view class="scale-border" :style="scaleborderStyle"><text
											style="color: rgba(0, 0, 0, 0);margin-left: 10rpx;margin-right: 30rpx;font-size: 24rpx;">{{scaleShow}}</text>
									</view>
									<view style="position: absolute;left: 25rpx;top: 15rpx;"><text
											style="color: #000000;font-size: 24rpx;">{{scaleShow}}</text> </view>
								</view>
							</view>

							<view @click="clickPath" class="row_center"
								style="box-shadow: 0px 0px 4px rgba(0, 0, 0, 0.20); width: 185rpx; height: 50rpx;background-color: #ffffff; padding-left: 5rpx;padding-right: 5rpx;border-radius: 25rpx;margin-right: 3px;">
								<image src="/static/imgs/tragectory/pathIcon.png" style="width: 40rpx;height: 40rpx;">
								</image>
								<text style="font-size: 30rpx;color: #000000;">{{showPathTitle}}</text>
							</view>

						</div>
						<div class="col_start"
							style="border-radius: 20px;background: rgba(255, 255, 255, 1);box-shadow: 0px 0px 4px rgba(0, 0, 0, 0.20);  rgba(0, 0, 0, 0.25);">
							<view class="row_between" :style="{width:dataWidth+'px'}" style="margin-top: 20rpx;">
								<text style="font-size: 28rpx;margin-left: 20rpx;">{{clickDate}}</text>
								<text style="font-size: 28rpx;">设备编号:{{serial_code}}</text>
								<image style="width: 40rpx;height: 40rpx;"
									:src="locateTypeGps?'/static/imgs/locate/gps.png':'/static/imgs/locate/gpsGray.png'">
								</image>
								<view class="row_center"
									style="margin-right: 20rpx; border-radius: 20px;background: rgba(255, 87, 51, 1);padding-left: 8rpx;padding-right: 8rpx;">
									<text style="font-size: 28rpx;color: white;">{{locateType}}</text>
								</view>
							</view>
							<view class="row_start" style="height: 100rpx;" :style="{width:dataWidth+'px'}">
								<div class="col_center" style="width: 80rpx;height: 100rpx;">
									<image src="/static/imgs/tragectory/locate.png" style="width: 15px;height:17px;">
									</image>
								</div>
								<div class="row_start" style="height: 100rpx;"><text
										style="width: 630rpx;color: rgba(255, 87, 51, 1);font-size: 28rpx;">{{address}}</text>
								</div>
							</view>
						</div>
					</view>
					<view class="slider-container">
						<view class="row_between"
							style="width: 200rpx;height: 350px;border-radius: 15px;position: relative;">
							<view style="width: 120rpx;height: 350px;position: relative">
								<view v-if="showSliderCallout" class="slider-callout" :style="thumbStyle">
									<view class="row_center"
										style="width: 120rpx;height: 60rpx;border: solid 1rpx  #ff5500;border-radius: 30rpx;background-color: #ffffff;">
										<text style="color: #ff5500;">{{calloutContent}}</text>
									</view>
								</view>
							</view>
							<view class="col_center"
								style="width: 80rpx;height: 350px;border-radius: 15px;position: relative;">
								<view class="slider" id="slider">
								</view>
								<view class="slider-thumb" :style="thumbStyle" @touchstart.native="startThumb"
									@touchmove.native="moveThumb" @touchend.native="stopThumb">
									<view style="position: relative; width: 90rpx; height: 90rpx;">
										<image src="/static/imgs/tragectory/circleHalo.png"
											style="width: 90rpx; height: 90rpx; position: absolute; z-index: 1;">
										</image>
									</view>
								</view>
							</view>
						</view>
					</view>
					<view :style="dataContainer"></view>
				</view>
			</map>
		</view>
	</view>
</template>

