/**
 * 引用 iOS 系统库
 */
import { UserDefaults } from "Foundation";

/* 引入 interface.uts 文件中定义的变量 */
import {
	GetPreferencesOptions,
	SetPreferencesOptions,
	DeletePreferencesOptions,
	ClearPreferencesOptions,
	GetPreferencesValueOptions,
	DeletePreferencesValueOptions,
	GetPreferencesResult,
	SetPreferencesResult,
	DeletePreferencesResult,
	ClearPreferencesResult,
	GetPreferencesValueResult,
	DeletePreferencesValueResult,
	GetPreferences,
	SetPreferences,
	DeletePreferences,
	ClearPreferences,
	GetPreferencesValue,
	DeletePreferencesValue,
	PreferencesSyncResult
} from '../interface.uts';

/* 引入 unierror.uts 文件中定义的变量 */
import { PreferencesFailImpl } from '../unierror';

/**
 * UserDefaults实例缓存
 */
const userDefaultsMap = new Map<string, UserDefaults>();

/**
 * 获取UserDefaults实例
 */
function getUserDefaults(name : string) : UserDefaults {
	if (userDefaultsMap.has(name)) {
		return userDefaultsMap.get(name)!;
	}

	const userDefaults = UserDefaults(suiteName = name) ?? UserDefaults.standard;
	userDefaultsMap.set(name, userDefaults);
	return userDefaults;
}

//#ifdef UNI-APP-X
/**
 * 获取Preferences实例
 *
 * uni-app项目中（vue/nvue）调用示例：
 * 1、引入方法声明 import { getPreferences } from "@/uni_modules/jiannor-preference"
 * 2、方法调用
 * getPreferences({
 *   name: 'myPrefs',
 *   success: (res) => {
 *      console.log(res)
 *   }
 * });
 * 
 * uni-app x项目（uvue）中调用示例：
 * 1、引入方法及参数声明 import { getPreferences, GetPreferencesOptions } from "@/uni_modules/jiannor-preference";
 * 2、方法调用
 * getPreferences({
 *   name: 'myPrefs',
 *   success: (res) => {
 *      console.log(res)
 *   }
 * });
 * 
 * @uniPlatform {
 *   "app": {
 *     "android": {
 *       "osVer": "5.0",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     },
 *     "ios": {
 *       "osVer": "12.0",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     },
 *     "harmony": {
 *       "osVer": "x",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     }
 *   }
 * }
 * @uniVersion 4.25
 * @uniVueVersion 2,3
 * @autotest { generated: true }
 */
export const getPreferences : GetPreferences = function (options : GetPreferencesOptions) {
	// 参数校验
	if (options.name == null || options.name.length == 0) {
		const error = new PreferencesFailImpl(9010001);
		options.fail?.(error);
		options.complete?.(error);
		return;
	}

	try {
		// 获取UserDefaults实例
		const userDefaults = getUserDefaults(options.name);

		const result : GetPreferencesResult = {
			success: true,
			data: userDefaults
		};
		options.success?.(result);
		options.complete?.(result);
	} catch (error) {
		console.error(`Failed to get preferences. Error:${error}`);
		const err = new PreferencesFailImpl(9010001);
		options.fail?.(err);
		options.complete?.(err);
	}
}

export function getPreferencesSync(name : string) : PreferencesSyncResult {

	let result : PreferencesSyncResult = {
		success: false,
		data: "",
		errMsg: ""
	}

	if (name == null || name.length == 0) {
		const error = new PreferencesFailImpl(9010005);
		console.error("getPreferencesSync参数错误: name为空或无效", error);
		result.success= false;
		result.errMsg=error.errMsg
		return result
	}
	try {
		const userDefaults = getUserDefaults(name);
		result.success= true;
		result.data=userDefaults
		return result
	} catch (error) {
		console.error("getPreferencesSync捕获错误:", error);
		const err = new PreferencesFailImpl(9010001);
		result.success = false;
		result.errMsg = err.errMsg
		return result
	}
}
//#endif

/**
 * 设置Preferences键值对
 *
 * uni-app项目中（vue/nvue）调用示例：
 * 1、引入方法声明 import { setPreferences } from "@/uni_modules/jiannor-preference"
 * 2、方法调用
 * setPreferences({
 *   name: 'myPrefs',
 *   key: 'username',
 *   value: 'john',
 *   success: (res) => {
 *      console.log(res)
 *   }
 * });
 * 
 * @uniPlatform {
 *   "app": {
 *     "android": {
 *       "osVer": "5.0",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     },
 *     "ios": {
 *       "osVer": "12.0",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     },
 *     "harmony": {
 *       "osVer": "x",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     }
 *   }
 * }
 * @uniVersion 4.25
 * @uniVueVersion 2,3
 * @autotest { generated: true }
 */
export const setPreferences : SetPreferences = function (options : SetPreferencesOptions) {
	// 参数校验
	if (options.name == null || options.name.length == 0) {
		const error = new PreferencesFailImpl(9010002);
		options.fail?.(error);
		options.complete?.(error);
		return;
	}

	if (options.key == null || options.key.length == 0) {
		const error = new PreferencesFailImpl(9010002);
		options.fail?.(error);
		options.complete?.(error);
		return;
	}

	try {
		// 获取UserDefaults实例
		const userDefaults = getUserDefaults(options.name);

		// 设置键值对
		userDefaults.set(options.value, forKey = options.key);
		userDefaults.synchronize();

		const result : SetPreferencesResult = {
			success: true
		};
		options.success?.(result);
		options.complete?.(result);
	} catch (error) {
		console.error(`Failed to set preferences. Error:${error}`);
		const err = new PreferencesFailImpl(9010002);
		options.fail?.(err);
		options.complete?.(err);
	}
}

export function setPreferencesSync(name : string, key : string, value : string) : PreferencesSyncResult {
	let result : PreferencesSyncResult = {
		success: false,
		data: "",
		errMsg: ""
	}

	if (name == null || name.length == 0) {
		const error = new PreferencesFailImpl(9010005);
		console.error("setPreferencesSync参数错误: name或key为空或无效", error);
		result.success = false;
		result.errMsg = error.errMsg
		return result
	}

	if (key == null || key.length == 0) {
		const error = new PreferencesFailImpl(9010005);
		console.error("setPreferencesSync参数错误: key为空或无效", error);
		result.success = false;
		result.errMsg = error.errMsg
		return result
	}

	if (value == null) {
		const error = new PreferencesFailImpl(9010005);
		console.error("setPreferencesSync参数错误: value为空或无效", error);
		result.success = false;
		result.errMsg = error.errMsg
		return result
	}

	try {
		const userDefaults = getUserDefaults(name);

		// 设置键值对
		userDefaults.set(value, forKey = key);
		userDefaults.synchronize();
		console.log("setPreferencesSync写入成功")
		result.success = true;
		result.data = null;
		return result
	} catch (error) {
		console.error("setPreferencesSync捕获错误:", error);
		const err = new PreferencesFailImpl(9010002);
		console.error("setPreferencesSync抛出错误:", err);
		result.success = false;
		result.errMsg = err.errMsg
		return result
	}
}
