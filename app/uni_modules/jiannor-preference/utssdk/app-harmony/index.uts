
import {
	GetPreferencesOptions,
	SetPreferencesOptions,
	DeletePreferencesOptions,
	ClearPreferencesOptions,
	GetPreferencesValueOptions,
	DeletePreferencesValueOptions,
	GetPreferencesResult,
	SetPreferencesResult,
	DeletePreferencesResult,
	ClearPreferencesResult,
	GetPreferencesValueResult,
	DeletePreferencesValueResult,
	GetPreferences,
	SetPreferences,
	DeletePreferences,
	ClearPreferences,
	GetPreferencesValue,
	DeletePreferencesValue,
	PreferencesSyncResult
} from '../interface.uts';
import { PreferencesFailImpl } from '../unierror';
import { preferences } from '@kit.ArkData';
import { BusinessError } from '@kit.BasicServicesKit';
import { AppStorageV2, UIContext } from '@kit.ArkUI';
import { common } from '@kit.AbilityKit';

/**
 * 获取UIAbilityContext
 */
function getUIAbilityContext() : common.UIAbilityContext {
	return AppStorageV2.connect(UIContext, 'uiContext', () => new UIContext())?.getHostContext() as common.UIAbilityContext;
}

//#ifdef UNI-APP-X
/**
 * 获取Preferences实例
 *
 * uni-app项目中（vue/nvue）调用示例：
 * 1、引入方法声明 import { getPreferences } from "@/uni_modules/jiannor-preference"
 * 2、方法调用
 * getPreferences({
 *   name: 'myPrefs',
 *   success: (res) => {
 *      console.log(res)
 *   }
 * });
 * 
 * uni-app x项目（uvue）中调用示例：
 * 1、引入方法及参数声明 import { getPreferences, GetPreferencesOptions } from "@/uni_modules/jiannor-preference";
 * 2、方法调用
 * let options = {
 *   name: 'myPrefs',
 *   success: (res : GetPreferencesResult) => {
 *     console.log(res)
 *   }
 * } as GetPreferencesOptions;
 * getPreferences(options);
 */
export const getPreferences : GetPreferences = function (options : GetPreferencesOptions) {
	try {
		if (!options.name || options.name.trim() === '') {
			const err = new PreferencesFailImpl(9010005);
			options.fail?.(err);
			options.complete?.(err);
			return;
		}

		preferences.getPreferences(getUIAbilityContext(), options.name).then((prefs : preferences.Preferences) => {
			const res : GetPreferencesResult = {
				success: true,
				data: prefs
			};
			options.success?.(res);
			options.complete?.(res);
		}).catch((err : BusinessError) => {
			const error = new PreferencesFailImpl(9010001);
			options.fail?.(error);
			options.complete?.(error);
		});
	} catch (e) {
		const err = new PreferencesFailImpl(9010001);
		options.fail?.(err);
		options.complete?.(err);
	}
}
export function getPreferencesSync(name : string) : PreferencesSyncResult {
	let result : PreferencesSyncResult = {
		success: false,
		data: "",
		errMsg: ""
	}

	if (name == null || name.trim() === '') {
		const err = new PreferencesFailImpl(9010005);
		console.error("getPreferencesSync参数错误: name为空或无效", err);
		result.success = false;
		result.errMsg = JSON.stringify(err)
		return result
	}

	try {
		let preference = preferences.getPreferencesSync(getUIAbilityContext(), { name: name } as preferences.Options)
		console.log("getPreferencesSync获取成功")
		result.success = true;
		result.data = preference;
		return result
	} catch (error) {
		console.error("getPreferencesSync捕获错误:", error);
		const err = new PreferencesFailImpl(9010001);
		console.error("getPreferencesSync抛出错误:", err);
		result.success = false;
		result.errMsg = String(error)
		return result
	}
}
//#endif
/**
 * 设置Preferences值
 *
 * uni-app项目中（vue/nvue）调用示例：
 * 1、引入方法声明 import { setPreferences } from "@/uni_modules/jiannor-preference"
 * 2、方法调用
 * setPreferences({
 *   name: 'myPrefs',
 *   key: 'username',
 *   value: 'john',
 *   success: (res) => {
 *      console.log(res)
 *   }
 * });
 */
export const setPreferences : SetPreferences = function (options : SetPreferencesOptions) {
	try {
		if (!options.name || options.name.trim() === '' || !options.key || options.key.trim() === '') {
			const err = new PreferencesFailImpl(9010005);
			options.fail?.(err);
			options.complete?.(err);
			return;
		}

		preferences.getPreferences(getUIAbilityContext(), options.name).then((prefs) => {
			prefs.put(options.key, options.value).then(() => {
				prefs.flush().then(() => {
					const res : SetPreferencesResult = {
						success: true
					};
					options.success?.(res);
					options.complete?.(res);
				}).catch((err : BusinessError) => {
					const error = new PreferencesFailImpl(9010002);
					options.fail?.(error);
					options.complete?.(error);
				});
			}).catch((err : BusinessError) => {
				const error = new PreferencesFailImpl(9010002);
				options.fail?.(error);
				options.complete?.(error);
			});
		}).catch((err : BusinessError) => {
			const error = new PreferencesFailImpl(9010002);
			options.fail?.(error);
			options.complete?.(error);
		});
	} catch (e) {
		const err = new PreferencesFailImpl(9010002);
		options.fail?.(err);
		options.complete?.(err);
	}
}

export function setPreferencesSync(name : string, key : string, value : any) : PreferencesSyncResult {
	let result : PreferencesSyncResult = {
		success: false,
		data: "",
		errMsg: ""
	}

	if (!name || name.trim() === '') {
		const err = new PreferencesFailImpl(9010005);
		console.error("setPreferencesSync参数错误: name为空或无效", err);
		result.success = false;
		result.errMsg = JSON.stringify(err)
		return result
	}

	if (!key || key.trim() === '') {
		const err = new PreferencesFailImpl(9010005);
		console.error("setPreferencesSync参数错误: key为空或无效", err);
		result.success = false;
		result.errMsg = JSON.stringify(err)
		return result
	}

	if (value == null) {
		const err = new PreferencesFailImpl(9010005);
		console.error("setPreferencesSync参数错误: value为空", err);
		result.success = false;
		result.errMsg = JSON.stringify(err)
		return result
	}

	try {
		let preference = preferences.getPreferencesSync(getUIAbilityContext(), {
			name: name
		} as preferences.Options)
		preference.putSync(key, value)
		preference.flushSync()
		console.log("setPreferencesSync写入成功")
		result.success = true;
		return result
	} catch (error) {
		console.error("setPreferencesSync捕获错误:", error);
		const err = new PreferencesFailImpl(9010002);
		console.error("setPreferencesSync抛出错误:", err);
		result.success = false;
		result.errMsg = String(error)
		return result
	}
}

/**
 * 删除Preferences文件
 *
 * uni-app项目中（vue/nvue）调用示例：
 * 1、引入方法声明 import { deletePreferences } from "@/uni_modules/jiannor-preference"
 * 2、方法调用
 * deletePreferences({
 *   name: 'myPrefs',
 *   success: (res) => {
 *      console.log(res)
 *   }
 * });
 */
export const deletePreferences : DeletePreferences = function (options : DeletePreferencesOptions) {
	try {
		if (!options.name || options.name.trim() === '') {
			const err = new PreferencesFailImpl(9010005);
			options.fail?.(err);
			options.complete?.(err);
			return;
		}

		preferences.deletePreferences(getUIAbilityContext(), options.name).then(() => {
			const res : DeletePreferencesResult = {
				success: true
			};
			options.success?.(res);
			options.complete?.(res);
		}).catch((err : BusinessError) => {
			const error = new PreferencesFailImpl(9010003);
			options.fail?.(error);
			options.complete?.(error);
		});
	} catch (e) {
		const err = new PreferencesFailImpl(9010003);
		options.fail?.(err);
		options.complete?.(err);
	}
}

/**
 * 清空Preferences所有数据
 *
 * uni-app项目中（vue/nvue）调用示例：
 * 1、引入方法声明 import { clearPreferences } from "@/uni_modules/jiannor-preference"
 * 2、方法调用
 * clearPreferences({
 *   name: 'myPrefs',
 *   success: (res) => {
 *      console.log(res)
 *   }
 * });
 */
export const clearPreferences : ClearPreferences = function (options : ClearPreferencesOptions) {
	try {
		if (!options.name || options.name.trim() === '') {
			const err = new PreferencesFailImpl(9010005);
			options.fail?.(err);
			options.complete?.(err);
			return;
		}

		preferences.getPreferences(getUIAbilityContext(), options.name).then((prefs) => {
			prefs.clear().then(() => {
				prefs.flush().then(() => {
					const res : ClearPreferencesResult = {
						success: true
					};
					options.success?.(res);
					options.complete?.(res);
				}).catch((err : BusinessError) => {
					const error = new PreferencesFailImpl(9010004);
					options.fail?.(error);
					options.complete?.(error);
				});
			}).catch((err : BusinessError) => {
				const error = new PreferencesFailImpl(9010004);
				options.fail?.(error);
				options.complete?.(error);
			});
		}).catch((err : BusinessError) => {
			const error = new PreferencesFailImpl(9010004);
			options.fail?.(error);
			options.complete?.(error);
		});
	} catch (e) {
		const err = new PreferencesFailImpl(9010004);
		options.fail?.(err);
		options.complete?.(err);
	}
}

export function clearPreferencesSync(name : string) : PreferencesSyncResult {
	let result : PreferencesSyncResult = {
		success: false,
		data: "",
		errMsg: ""
	}

	if (name == null || name.trim() === '') {
		const err = new PreferencesFailImpl(9010005);
		console.error("clearPreferencesSync参数错误: name为空或无效", err);
		result.success = false;
		result.errMsg = JSON.stringify(err)
		return result
	}

	try {
		let preference = preferences.getPreferencesSync(getUIAbilityContext(), { name: name } as preferences.Options);
		preference.clearSync()
		preference.flushSync()
		console.log("clearPreferencesSync清除成功")
		result.success = true;
		return result
	} catch (error) {
		console.error("clearPreferencesSync捕获错误:", error);
		const err = new PreferencesFailImpl(9010004);
		console.error("clearPreferencesSync抛出错误:", err);
		result.success = false;
		result.errMsg = String(error)
		return result
	}
}

/**
 * 获取指定键的值
 * @param options 
 * 
 * @uniPlatform {
 *   "app": {
 *     "android": {
 *       "osVer": "x",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     },
 *     "ios": {
 *       "osVer": "x",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     },
 *     "harmony": {
 *       "osVer": "3.0.0",
 *       "uniVer": "4.25",
 *       "unixVer": "4.25"
 *     }
 *   }
 * }
 * @uniVersion 4.25
 * @uniVueVersion 2,3  //支持的vue版本
 * @autotest { generated: true }
 */
export const getPreferencesValue : GetPreferencesValue = function (options : GetPreferencesValueOptions) {
	// 参数校验
	if (options.name == null || options.name.length == 0) {
		const error = new PreferencesFailImpl(9010005);
		options.fail?.(error);
		options.complete?.(error);
		return;
	}

	if (options.key == null || options.key.length == 0) {
		const error = new PreferencesFailImpl(9010005);
		options.fail?.(error);
		options.complete?.(error);
		return;
	}

	try {
		// 获取Preferences实例
		preferences.getPreferences(getUIAbilityContext(), options.name, (err : BusinessError, data : preferences.Preferences) => {
			if (err) {
				console.error(`Failed to get preferences. Code:${err.code}, message:${err.message}`);
				const error = new PreferencesFailImpl(9010001);
				options.fail?.(error);
				options.complete?.(error);
				return;
			}

			// 获取指定键的值
			try {
				const value = data.getSync(options.key, options.defaultValue);
				const result : GetPreferencesValueResult = {
					success: true,
					value: value
				};
				options.success?.(result);
				options.complete?.(result);
			} catch (getError) {
				console.error(`Failed to get value. Error:${getError}`);
				const error = new PreferencesFailImpl(9010001);
				options.fail?.(error);
				options.complete?.(error);
			}
		});
	} catch (error) {
		console.error(`Failed to get preferences. Error:${error}`);
		const err = new PreferencesFailImpl(9010001);
		options.fail?.(err);
		options.complete?.(err);
	}
}

export function getPreferencesValueSync(name : string, key : string, defaultValue : any) : PreferencesSyncResult {
	let result : PreferencesSyncResult = {
		success: false,
		data: "",
		errMsg: ""
	}

	if (name == null || name.length == 0) {
		const error = new PreferencesFailImpl(9010005);
		console.error("getPreferencesValueSync参数错误: name为空或无效", error);
		result.success = false;
		result.errMsg = JSON.stringify(error)
		return result
	}

	if (key == null || key.length == 0) {
		const error = new PreferencesFailImpl(9010005);
		console.error("getPreferencesValueSync参数错误: key为空或无效", error);
		result.success = false;
		result.errMsg = JSON.stringify(error)
		return result
	}

	try {
		let preference = preferences.getPreferencesSync(getUIAbilityContext(), { name: name } as preferences.Options)
		let data = preference.getSync(key, defaultValue)
		console.log("getPreferencesValueSync获取成功")
		result.success = true;
		result.data = data;
		return result
	} catch (error) {
		console.error("getPreferencesValueSync捕获错误:", error);
		const err = new PreferencesFailImpl(9010001);
		console.error("getPreferencesValueSync抛出错误:", err);
		result.success = false;
		result.errMsg = String(error)
		return result
	}
}

/**
 * 删除指定键的值
 * @param options 
 * 
 * @uniPlatform {
 *   "app": {
 *     "android": {
 *       "osVer": "x",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     },
 *     "ios": {
 *       "osVer": "x",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     },
 *     "harmony": {
 *       "osVer": "3.0.0",
 *       "uniVer": "4.25",
 *       "unixVer": "4.25"
 *     }
 *   }
 * }
 * @uniVersion 4.25
 * @uniVueVersion 2,3  //支持的vue版本
 * @autotest { generated: true }
 */
export const deletePreferencesValue : DeletePreferencesValue = function (options : DeletePreferencesValueOptions) {
	// 参数校验
	if (options.name == null || options.name.length == 0) {
		const error = new PreferencesFailImpl(9010005);
		options.fail?.(error);
		options.complete?.(error);
		return;
	}

	if (options.key == null || options.key.length == 0) {
		const error = new PreferencesFailImpl(9010005);
		options.fail?.(error);
		options.complete?.(error);
		return;
	}

	try {
		// 获取Preferences实例
		preferences.getPreferences(getUIAbilityContext(), options.name, (err : BusinessError, data : preferences.Preferences) => {
			if (err) {
				console.error(`Failed to get preferences. Code:${err.code}, message:${err.message}`);
				const error = new PreferencesFailImpl(9010001);
				options.fail?.(error);
				options.complete?.(error);
				return;
			}

			// 删除指定键的值
			try {
				data.deleteSync(options.key);
				// 持久化数据
				data.flush((flushErr : BusinessError) => {
					if (flushErr) {
						console.error(`Failed to flush preferences. Code:${flushErr.code}, message:${flushErr.message}`);
						const error = new PreferencesFailImpl(9010006);
						options.fail?.(error);
						options.complete?.(error);
						return;
					}

					const result : DeletePreferencesValueResult = {
						success: true
					};
					options.success?.(result);
					options.complete?.(result);
				});
			} catch (deleteError) {
				console.error(`Failed to delete value. Error:${deleteError}`);
				const error = new PreferencesFailImpl(9010006);
				options.fail?.(error);
				options.complete?.(error);
			}
		});
	} catch (error) {
		console.error(`Failed to get preferences. Error:${error}`);
		const err = new PreferencesFailImpl(9010001);
		options.fail?.(err);
		options.complete?.(err);
	}
}

export function deletePreferencesValueSync(name : string, key : string) : PreferencesSyncResult {
	let result : PreferencesSyncResult = {
		success: false,
		data: "",
		errMsg: ""
	}

	if (name == null || name.length == 0) {
		const error = new PreferencesFailImpl(9010005);
		console.error("deletePreferencesValueSync参数错误: name为空或无效", error);
		result.success = false;
		result.errMsg = JSON.stringify(error)
		return result
	}

	if (key == null || key.length == 0) {
		const error = new PreferencesFailImpl(9010005);
		console.error("deletePreferencesValueSync参数错误: key为空或无效", error);
		result.success = false;
		result.errMsg = JSON.stringify(error)
		return result
	}

	try {
		let preference = preferences.getPreferencesSync(getUIAbilityContext(), { name: name } as preferences.Options)
		preference.deleteSync(key)
		preference.flushSync()
		console.log("deletePreferencesValueSync删除成功")
		result.success = true;
		return result
	} catch (error) {
		console.error("deletePreferencesValueSync捕获错误:", error);
		const err = new PreferencesFailImpl(9010001);
		console.error("deletePreferencesValueSync抛出错误:", err);
		result.success = false;
		result.errMsg = String(error)
		return result
	}
}

