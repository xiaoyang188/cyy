					url: '/pages/dataPathNvue/dataPathNvue?data=' + data
				})
				// }
			},
			getTextWidth(str) {
				const canvas = uni.createCanvasContext('measureCanvas');
				const text = str; // 获取文本内容
				canvas.setFontSize(15); // 设置字体大小
				const metrics = canvas.measureText(text); // 测量文本宽度
				return metrics.width;
			},
			phonelocation(la, lo) {
				var X = this.getTextWidth('铲屎官');
				var marker = {
					id: 0,
					latitude: la,
					longitude: lo,
					iconPath: '/static/xixin/owner.png',
					rotate: this.avatarDirection,
					anchor: {
						x: .5,
						y: .5
					},
					width: 30,
					height: 30,
				};

				this.findeOrChangeById(marker, this.markers)
				if (this.homeWifi != null) {
					this.findeOrChangeById(this.homeWifi, this.markers)
				}
				console.log('更新手机位置', this.markers)
				this.saveMarkers()
				if (this.sureleading) {
					var cir = [{
						latitude: marker.latitude, // 圆心纬度
						longitude: marker.longitude, // 圆心经度
						color: "#FF0000", // 圆的颜色
						fillColor: "rgba(255,0,0,0.2)", // 圆的填充颜色
						radius: 30, // 半径，单位为米
					}, ]
					this.circles = cir;
				}
			},
			saveMarkers() {
				let newMarker = this.markers.slice(0);
				this.markers = new Array();
				this.markers = newMarker;
			},
			isValidPosition(position) {
				console.log('isValidPosition', position)
				return position != null && position.time != null && position.loc_type === 1 && position.latitude != null;
			},
			findeOrChangeById(item, markers) {
				let found = false;
				// console.log("item and markers",item,markers)
				for (let i = 0; i < markers.length; i++) {
					if (markers[i] != null && markers[i].id === item.id) {
						markers[i] = item; // 找到了，赋值
						found = true;
						break;
					}
				}
				if (!found && item != null && item.hasOwnProperty('id')) {
					markers.push(item); // 没找到，添加
				}
				this.saveMarkers()
				// 排序
				// markers.sort((a, b) => a.id - b.id);
			},
			mergeToPhone() {
				let phoneMarker = this.markers.find(item => item.id === 0)
				if (phoneMarker) {
					const randomPoint = util.getRandomPointNearby(phoneMarker.latitude, phoneMarker
						.longitude, 5);
					let markerToUpdate1 = this.markers.find(marker => marker.id === 2);
					if (markerToUpdate1) {
						markerToUpdate1.latitude = randomPoint.latitude; // 修改找到的项的 la 值
						markerToUpdate1.longitude = randomPoint.longitude
					}
					this.saveMarkers()
					console.log('mergeToPhone', this.markers)
					uni.setStorageSync(this.loadobject.serialCode + 'refreshTime', util
						.getCurrentTimeMilliseconds())
				}
			},
			async getPetPositionNew(object, upmap, ismanual) {
				if (this.showHaveDevice)
					return
				var newMarker = new Array();
				getDeviceInfo(object.serialCode).then(res => {
					console.log('获取到的位置信息', res)
					if(res.data.motionInfo.battery)
					{
						this.loadobject.presentBattary=res.data.motionInfo.battery
						if(res.data.deviceInfo.onlineStatus==1&&this.loadobject.presentBattary<10)
							this.loadobject.presentBattary=0
					}
					if(res.data.deviceInfo.isCharing)
						this.isCharge=res.data.deviceInfo.isCharing
					var item = res.data.locationInfo;
					let that = this
					let labeltime = uni.getStorageSync(object.serialCode + 'refreshTime')
					const now = new Date();
					const target = new Date(item.atime);
					const diff = (now - target) / 1000 / 60;
					console.log('获取宠物位置', item)
					this.deviceOffline = "";
					this.locType = item.locType
					if (res.data.deviceInfo.onlineStatus != 2) {
						this.deviceOffline = "设备离线";
						this.locateInfoData="设备离线"
					}
					else {
						 this.deviceOffline="设备在线"
						 if((item.floor&&this.locType != 2&&item.floorStatus!=0)||(item.floor&&item.floor!=1&&this.locType === 2&&item.floorStatus!=0))
						 {
							 if(item.floor<-2)
								item.floor=-2
							 if(item.floor<0)
								this.locateInfoData ='可能在负'+Math.abs(item.floor)+'楼'
							 else
								this.locateInfoData ='可能在'+item.floor.toString()+'楼'
						 }
						 else
						 {
							 this.locateInfoData = "设备在线"
						 }
						// this.locateInfoData ='可能在'+item.floor.toString()+'楼'
					}

					let petMarker = null

					if (this.locType === 1) {
						this.positionSignal = "GPS信号弱"
					} else if (this.locType === 2) {
						this.positionSignal = "GPS信号强"
					} else if (this.locType === 4) {
						this.positionSignal = "家庭位置"
					}
					//如果高频模式定位时长超过10分钟
					// if (diff > 10 && this.DeviceConnectModol === 1)
					// 	this.positionSignal = "信号弱"
					petMarker = this.markers.find(item => item && item.hasOwnProperty('id') && item.id === 2);
					if (item.atime) {
						// console.log('into 2', item.location_time)
						labeltime = item.atime
						//这里是为了骗用户，显示的时候把时间设置为当前
						uni.setStorageSync(object.serialCode + 'refreshTime', labeltime)
						let avatarHeight = 60
						let avatarWight = 52.8
						if (this.petAvatar != this.loadobject.petIcon) {
							avatarHeight = 75
							avatarWight = 52.8
						}
						petMarker = {
						  id: 2,
						  latitude: item.latitude,
						  longitude: item.longitude,
						   ...(item.id && { locId: item.id }),
						  iconPath: this.petAvatar,
						  width: avatarWight,
						  height: avatarHeight,
						  time: item.locTime,
						  loc_type: item.locType,
						  // 👇 关键：只有存在时才添加该属性
						  ...(item.floor && { floor: item.floor }),
						  ...(item.locationRecoveryId&&{locationRecoveryId:item.locationRecoveryId}),
						  anchor: {
						    x: 0.5,
						    y: 1
						  }
						};
						console.log('petMarker', petMarker)
						this.findeOrChangeById(petMarker, this.markers)
					} else {
						labeltime = util.getCurrentTimeMilliseconds()
					}

					if (this.DeviceConnectModol === 1) {
						if (labeltime != '')
							that.locateTime = labeltime
					} else {
						if (labeltime != '')
							this.locateTime = labeltime.substring(5, 16)
					}
					this.lastLocateTime = labeltime.substring(5, 16)
					if (that.bluetoothConnect && !that.stopLadarToast) {
						if (item.locType && item.locType === 4) {
							//如果位置是家庭wifi 但是时间超过10分钟，连上蓝牙后以手机位置为主
							if (diff > 5) {
								this.mergeToPhone()
							}
						} else {
							this.mergeToPhone();
						}
					}
					this.savePage()
					//如果电子围栏是开启的话判断一下要不要显示出界
					if (this.railing) {
						let petPosition = this.markers.find(marker => marker.id === 2);
						if (petPosition) {
							let poly = this.localSavePolygons[this.actionPolygonIndex]
							if (poly) {
								this.outinside = !util.isPointInPolygon(petPosition, poly.points)
							}
						}
					}
					if (!upmap) {
						this.mapviz = true;
					}
					if (this.firstGetPetPose) {
						this.moveToPet()
						this.firstGetPetPose = false
					}
					uni.hideLoading()
				})
				// let deviceAccount = getApp().globalData.internet_cyy + getApp().globalData.deviceGetInfo + object
				// 	.serialCode;
				// util.requestDataJsonGET(deviceAccount, {}).then((res) => {
				// 	var item = res.data.locationInfo;
				// 	let that = this
				// 	const date = new Date(res.data.deviceInfo.latestCommunicationTime);
				// 	date.setMinutes(date.getMinutes() + 30);
				// 	this.nextCommunicate = date.toISOString().slice(0, 19).replace('T', ' ');
				// 	var X = this.getTextWidth(object.pname.toString());
				// 	let labeltime = uni.getStorageSync(object.serialCode + 'refreshTime')
				// 	const now = new Date();
				// 	const target = new Date(item.atime);
				// 	const diff = (now - target) / 1000 / 60;
				// 	console.log('获取宠物位置', item)
				// 	let petMarker = null
				// 	this.locType = item.locType
				// 	if (this.locType === 1) {
				// 		this.positionSignal = "GPS信号弱"
				// 	} else if (this.locType === 2) {
				// 		this.positionSignal = "GPS信号强"
				// 	} else if (this.locType === 4) {
				// 		this.positionSignal = "家庭位置"
				// 	}
				// 	//如果高频模式定位时长超过10分钟
				// 	// if (diff > 10 && this.DeviceConnectModol === 1)
				// 	// 	this.positionSignal = "信号弱"
				// 	petMarker = this.markers.find(item => item && item.hasOwnProperty('id') && item.id === 2);
				// 	if (item.atime) {
				// 		// console.log('into 2', item.location_time)
				// 		labeltime = item.atime
				// 		//这里是为了骗用户，显示的时候把时间设置为当前
				// 		uni.setStorageSync(object.serialCode + 'refreshTime', labeltime)
				// 		petMarker = {
				// 			id: 2,
				// 			latitude: item.latitude,
				// 			longitude: item.longitude,
				// 			locId: item.id,
				// 			iconPath: this.loadobject.petIcon,
				// 			width: 52.8,
				// 			height: 60,
				// 			time: item.locTime,
				// 			loc_type: item.locType,
				// 			anchor: {
				// 				x: .5,
				// 				y: 1
				// 			},
				// 		};
				// 		console.log('petMarker', petMarker)
				// 		this.findeOrChangeById(petMarker, this.markers)
				// 		//显示当前定位楼层或状态
				// 		if (item.floor) {
				// 			this.locateInfoData = item.floor
				// 		} else {
				// 			this.locateInfoData = this.deviceOffline
				// 			if (this.locateInfoData === "")
				// 				this.locateInfoData = "设备在线"
				// 		}
				// 	} else {
				// 		labeltime = util.getCurrentTimeMilliseconds()
				// 	}

				// 	if (this.DeviceConnectModol === 1) {
				// 		if (labeltime != '')
				// 			that.locateTime = labeltime
				// 	} else {
				// 		if (labeltime != '')
				// 			this.locateTime = labeltime.substring(5, 16)
				// 	}
				// 	this.lastLocateTime = labeltime.substring(5, 16)
				// 	if (that.bluetoothConnect && !that.stopLadarToast) {
				// 		if (item.locType && item.locType === 4) {
				// 			//如果位置是家庭wifi 但是时间超过10分钟，连上蓝牙后以手机位置为主
				// 			if (diff > 5) {
				// 				this.mergeToPhone()
				// 			}
				// 		} else {
				// 			this.mergeToPhone();
				// 		}
				// 	}
				// 	this.savePage()
				// 	//如果电子围栏是开启的话判断一下要不要显示出界
				// 	if (this.railing) {
				// 		let petPosition = this.markers.find(marker => marker.id === 2);
				// 		if (petPosition) {
				// 			let poly = this.localSavePolygons[this.actionPolygonIndex]
				// 			if (poly) {
				// 				this.outinside = !util.isPointInPolygon(petPosition, poly.points)
				// 			}
				// 		}
				// 	}

				// 	if (!upmap) {
				// 		this.mapviz = true;
				// 	}
				// 	if (this.firstGetPetPose) {
				// 		this.moveToPet()
				// 		this.firstGetPetPose = false
				// 	}
				// 	uni.hideLoading()
				// })
			},
			// 选择地图
			handleOpenMap(option) {
				if (!this.drawToast && !this.ladarToast) {
					this.toMapping = option;
				}
				console.log("this.toMapping", this.toMapping)
			},

			toMapAPP(opt) {
				let petMarker = this.markers.find(item => item.id === 2)
				let phoneMarker = this.markers.find(item => item.id === 0)
				if (!phoneMarker) {
					uni.showToast({
						title: '获取位置出错了',
						icon: 'none'
					})
					return
				}
				if (petMarker) {
					// "location": "120.02,30.2115",
					// "direction": "东北",
					// "name": "留漫巷",, 33.054195
					const la = 33.054195
					const lo = 117.37343733333333
					let str =
						'https://restapi.amap.com/v3/geocode/regeo?key=9f8eb22902ff76102e32ba52c7dee1e6&radius=2000&extensions=all&batch=false&roadlevel=0&location=' +
						petMarker.longitude + ',' + petMarker.latitude
					let that = this
					uni.request({
						url: str,
						data: {},
						method: 'GET',
						success: res => {
							uni.hideLoading()
							this.toMapping = false;
							console.log('res.data.', res)
							if (res.data.status === '1') {
								if (res.data.regeocode.pois.length > 0) {
									// var name = res.data.regeocode.roads[0].name;
									var pois = res.data.regeocode.pois;
									let item = pois[0];
									let maxdistance = 10000
									console.log('name0', item)
									for (var i = 0; i < pois.length; i++) {
										// console.log('pois[i].distance',pois[i].distance)
										if ((parseFloat(pois[i].distance) < parseFloat(maxdistance)) &&
											pois[i].address != "") {
											item = pois[i];
											maxdistance = pois[i].distance
											console.log('min distance', pois[i].distance, pois[i].address)
										}
									}
									let name = item.address;
									console.log('name', item);
									console.log('res.data.regeocode.roads[0]', res.data)

									let url = "",
										latitude = petMarker.latitude,
										longitude = petMarker.longitude

									if (plus.os.name == "Android") {
										switch (opt) {
											//下面是拼接url,不同系统以及不同地图都有不同的拼接字段
											case 0:
												url =
													`baidumap://map/marker?location=${latitude},${longitude}&title=${name}&coord_type=gcj02&src=andr.baidu.openAPIdemo`;
												// url= `baidumap: //map/direction?origin = name : 我的位置 | latlng:${that.markers[0].latitude} ,${that.markers[0].longitude} &destination = ${name} | latlng: ${latitude},${longitude}&src = andr.baidu.openAPIdemo `
												break;
											case 1:
												console.log('点击高德地图');
												url =
													`amapuri://route/plan?sourceApplication=chongyueyue&slat=${phoneMarker.latitude}&slon=${phoneMarker.longitude}&sname=我的位置&dlat=${latitude}&dlon=${longitude}&dname=${name}&dev=0&t=0`;
												break;
											default:
												break;
										}
									} else {
										switch (opt) {
											case 0:
												url =
													`baidumap://map/marker?location=${latitude},${longitude}&title=${name}&content=${name}&src=ios.baidu.openAPIdemo&coord_type=gcj02`;
												break;
											case 1:
												url =
													`iosamap://viewMap?sourceApplication=applicationName&poiname=${name}&lat=${latitude}&lon=${longitude}&dev=0`;
												break;
											default:
												break;
										}
									}
									if (url != "") {
										url = encodeURI(url);
										plus.runtime.openURL(url, function(e) {
											plus.nativeUI.alert("本机未安装指定的地图应用");
										});
									}
								} else {
									uni.showToast({
										icon: 'none',
										title: '未找到可导航地理位置，请自己手动导航'
									})
								}

							}
						},
						fail: res => {
							uni.hideLoading()
							this.toMapping = false;
							console.log('获取标记位置失败', res);
							uni.showToast({
								icon: 'none',
								title: '未找到可导航地理位置，可稍后重试，或自己手动导航'
							})
						},
					})
				} else {
					uni.hideLoading()
					this.toMapping = false;
					uni.showToast({
						title: '找不到宠物',
						icon: 'none'
					})
				}

			}
		}
	}
</script>

