		justify-content: center;
	}

	.center-com {
		width: 160rpx;
		height: 140rpx;
		position: absolute;
		left: 265rpx;
		top: 280rpx;
		display:flex;
		flex-direction: column;
		justify-content: start;
		align-items: center;
	}
	.center-com-wifiname {
		width: 160rpx;
