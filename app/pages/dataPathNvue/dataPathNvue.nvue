er_type': 0, 'filter_reason': ''}, {'latitude': 41.3442974, 'longitude': 123.8702447, 'HDOP': null, 'time': '22:41:02', 'DB_HZ': null, 'loc_type': 1, 'wifi_list': ['fe:83:c6:4f:49:17,-75'], 'wifi_ssid_list': ['Cindy'], 'filter_type': 1, 'filter_reason': 'wifi列表只有一个mac且时间间隔在15分钟以内'}, {'latitude': 41.3442863, 'longitude': 123.8715628, 'HDOP': null, 'time': '22:43:35', 'DB_HZ': null, 'loc_type': 1, 'wifi_list': ['e6:77:27:77:3d:38,-81'], 'wifi_ssid_list': ['小艾家'], 'filter_type': 1, 'filter_reason': 'wifi列表只有一个mac且时间间隔在15分钟以内'}, {'latitude': 41.3442792, 'longitude': 123.87049368333334, 'HDOP': null, 'time': '22:54:41', 'DB_HZ': null, 'loc_type': 1, 'wifi_list': ['9a:00:6a:fc:fd:7a,-85'], 'wifi_ssid_list': ['0'], 'filter_type': 1, 'filter_reason': 'wifi列表只有一个mac且 时间间隔在15分钟以内'}, {'latitude': 41.34425078333334, 'longitude': 123.87040278333333, 'HDOP': null, 'time': '23:27:21', 'DB_HZ': null, 'loc_type': 1, 'wifi_list': ['98:00:6a:fc:fd:7a,-87'], 'wifi_ssid_list': ['CMCC-5151'], 'filter_type': 0, 'filter_reason': ''}]
				
				}
				
		},
		onLoad(options) {
			console.log('into datapath onloac', options);
			this.screenheight = uni.getSystemInfoSync().screenHeight;
			this.screenwidth = uni.getSystemInfoSync().screenWidth;
			this.enableSatellite = getApp().globalData.mapShowMode
			if (!this.enableSatellite)
				this.mapNumber = 'GS (2023)551号'
			else
				this.mapNumber = 'GS (2023)4047号'
			this.dataWidth = this.screenwidth * 0.95
			this.mapHeight = this.screenheight;
			console.log('uni.getWindowInfo().windowHeight', uni.getWindowInfo())
			if (plus.os.name === 'iOS')
				this.scrollViewHeight = 15
			this.scrollViewHeight = (this.screenheight * this.scrollViewHeight) / 100;
			let pixelRatio = uni.getWindowInfo().screenWidth / 750
			this.dataViewHeight = 250 * pixelRatio
			// console.log('this.scrollViewHeight',this.scrollViewHeight)
			if (options.data) {
				let data = JSON.parse(options.data);
				this.serial_code = data.serialCode;
				// this.serial_code='be180202'
				this.Pid = data.pid;
				this.Did = data.did;
				if (data.dogulas_peuker_distance)
					this.dogulas_peuker_distance = data.dogulas_peuker_distance
			}
			if (uni.getSystemInfoSync().platform = "android") {
				this.scaleborderStyle = {
					margin: '5px 0px 0px 0px'
				}
			} else {
				this.scaleborderStyle = {
					top: "10px"
				}
			}
			this.showPolyLine = uni.getStorageSync("showPoline")
			console.log('this.showPolyLine', this.showPolyLine)
			if (this.showPolyLine === '' || this.showPolyLine === null)
				this.showPolyLine = true
		},
		computed: {
			thumbStyle() {
				return {
					top: this.thumbTop + 'px',

				};
			},
			scrollStyle() {
				return {
					top: this.screenheight - this.scrollViewHeight + 'px',
					left: '0px',
					backgroundColor: 'rgba(255, 255, 255, 1)',
					borderRadius: '30px 30px 0px 0px',
					width: this.screenwidth + 'px',
					height: this.scrollViewHeight + 'px',
				}
			},
			dataStyle() {
				return {
					top: this.screenheight - this.dataViewHeight - this.scrollViewHeight + 'px',
					left: '0px',
					// backgroundColor: 'rgba(255, 255, 255, 1)',
					borderRadius: '25rpx',
					width: this.screenwidth + 'px',
					height: this.dataViewHeight + 'px',
				}
			},
			dataContainer() {
				let style = {
					top: this.screenheight.toString() + 'px'
				}
				if (plus.os.name === 'Android') {
					style = {
						margin: (this.screenheight.toString()) + 'px 0px 0px 0px'
					}
				}
				return style
			}
		},
		onReady() {
			this._mapContext = uni.createMapContext("map", this);
			this._mapContext.initMarkerCluster({
				enableDefaultStyle: true,
				zoomOnClick: true,
				gridSize: 60,
				complete(res) {
					console.log('initMarkerCluster', res)
				}
			});
		},
		mounted() {
			// 在这里初始化地图组件
			this.initDates();
			// const currentDate = new Date();
			// const date = new Date(currentDate);
			// date.setDate(currentDate.getDate());
			// const formattedDate = this.formatDate(date);
			// console.log('当天日期', formattedDate);
			this.currentDate = getApp().globalData.currentDate;
			console.log('this.dateClick(this.currentDate)', this.currentDate)
			this.dateClick(this.currentDate, 0);
		},
		methods: {
			clickPath() {
				// this.showPolyLine = !this.showPolyLine
				// this.polyline.map(item => {
				// 	if (!this.showPolyLine) {
				// 		item.width = 0;
				// 	} else {
				// 		item.width = 15;
				// 	}
				// 	return item;
				// });
				// let polyline = this.polyline
				// this.polyline = new Array()
				// setTimeout(() => {
				// 	this.polyline = polyline
				// }, 10)
				// uni.setStorageSync("showPoline", this.showPolyLine)
				// console.log("this.polyline", this.showPolyLine)
				
				
				
				this.showPath++;
				if(this.showPath>2){
					this.showPath=0
				}
				if(this.showPath==0){
					this.polyline=new Array()
					this.markers=new Array()
					this.polyline=this.polylineData
					this.markers=this.markerData
					this.showPathTitle='点位路径'
				}else if(this.showPath==1){
					this.polylineData=this.polyline.splice(0)
					this.polyline=new Array()
					this.showPathTitle='运动点位'
				}else if(this.showPath==2){
					this.markerData=this.markers.splice(0)
					this.markers=new Array()
					this.polyline=this.polylineData
					this.showPathTitle='运动路径'
				}
			},
			callouttap(e) {
				console.log("callout", e)
			},
			timeToSeconds(timeStr) {
				const [dateStr, timeStrPart] = timeStr.split(' ');
				const [year, month, day] = dateStr.split('-').map(Number);
				const [hour, minute, second] = timeStrPart.split(':').map(Number);

				const date = new Date(year, month - 1, day, hour, minute, second);
				const startOfDay = new Date(year, month - 1, day, 0, 0, 0);

				return Math.floor((date - startOfDay) / 1000);
			},
			findClosestItemWithIndex(items, targetSeconds) {
				let closestItem = null;
				let closestIndex = -1;
				let minDifference = Infinity;
				items.forEach((item, index) => {
					const itemSeconds = this.timeToSeconds(item.time);
					const difference = Math.abs(itemSeconds - targetSeconds);
					// console.log('itemSeconds', itemSeconds, targetSeconds, difference)
					if (difference < minDifference) {
						minDifference = difference;
						closestItem = item;
					}
					//id===1000 是用来常显的marker 
					if (item.id === 1000)
						closestIndex = index;
				});
				return {
					closestItem,
					closestIndex
				};
			},
			startThumb(event) {
				this.showSliderCallout = true
				this.moveThumb(event);
			},
			moveThumb(event) {
				const {
					touches
				} = event;
				// const firstTouch = touches[0];
				// console.log(' {touches}', touches)
				const x = touches[0].screenX
				const y = touches[0].screenY
				// console.log('Y', y)
				const position = y - this.sliderTop;
				// console.log('position', position)
				if (position < 0) {
					this.thumbTop = 0;
				} else if (position > 300) {
					this.thumbTop = 300;
				} else {
					this.thumbTop = position;
				}
				const percent = ((this.sliderHight - this.thumbTop) / this.sliderHight) * 100;
				// console.log('percent', percent);
				this.drawRange = Math.round(percent * (this.maxValue - this.minValue)) / 100;
				let findeResult = this.findClosestItemWithIndex(this.markers, this.drawRange + this.minValue)
				this.calloutContent = findeResult.closestItem.callout.content
				this.slideIndex = findeResult.closestIndex
				// let tampMarkers = this.markers.slice(0)
				// //找到id===1000的点对应的index 来赋值
				// tampMarkers[findeResult.closestIndex].latitude = findeResult.closestItem.latitude
				// tampMarkers[findeResult.closestIndex].longitude = findeResult.closestItem.longitude
				// tampMarkers[findeResult.closestIndex].callout.content = findeResult.closestItem.callout.content
				// this.markers = new Array()
				// this.markers = tampMarkers
				// console.log("this.slideIndex ", this.slideIndex)
			},
			stopThumb() {
				// 停止拖动滑块
				this.showSliderCallout = false
				// console.log('into moveThumb', this.drawRange);
				// console.log('检测到停止滑块', this.markers)
				let findeResult = this.findClosestItemWithIndex(this.markers, this.drawRange + this.minValue)
				this.slideIndex = findeResult.closestIndex
				// console.log("找到目标", findeResult)
				let tampMarkers = this.markers.slice(0)
				tampMarkers[findeResult.closestIndex].latitude = findeResult.closestItem.latitude
				tampMarkers[findeResult.closestIndex].longitude = findeResult.closestItem.longitude
				tampMarkers[findeResult.closestIndex].callout.content = findeResult.closestItem.callout.content
				this.markers = new Array()
				this.markers = tampMarkers
				// this._mapContext.addMarkers({
				// 	markers: [this.markers],
				// 	clear:true,
				// 	success: (res) => {
				// 		console.log(res)
				// 	},
				// 	fail: (err) => {
				// 		console.log(err)
				// 	}
				// })
				console.log("this.markers",this.markers)
				const event = {
					detail: {
						markerId: findeResult.closestItem.id
					},
				};
				this.markertap(event);
				// this.callouttap(event)
				//根据时间更新滑块停止时的 位置
			},
			loAcquire(longitude, latitude) {
				let that = this;
				uni.showLoading({
					title: '加载中',
					mask: true
				});
				// String url = String.format(
				//               "https://restapi.amap.com/v3/geocode/regeo?output=JSON&key=你申请的key&radius=1000&extensions=all&batch=false&roadlevel=0&location=%s,%s",
				//               longitude, latitude);
				let str =
					'https://restapi.amap.com/v3/geocode/regeo?key=9f8eb22902ff76102e32ba52c7dee1e6&radius=1000&extensions=all&batch=false&roadlevel=0&location=' +
					latitude.toString() + ',' + longitude.toString()
				uni.request({
					url: str,
					data: {},
					method: 'GET',
					success: res => {
						uni.hideLoading()
						console.log('res.data.', res)
						if (res.data.status === '1') {
							this.address = res.data.regeocode.formatted_address;
							console.log('res.data.result.address', res.data.regeocode.formatted_address);
						}
					},
					fail: res => {
						uni.hideLoading()
						console.log('获取标记位置失败', res);
					},
				})
			},
			onregionchange() {
				let that = this
				this._mapContext.getScale({
					success: (res) => {
						// console.log('获取缩放尺度',res)
						let index = Math.trunc(res.scale) - 3
						// console.log('index',index)
						that.scaleShow = that.scaleArray[index]
						// console.log('that.mapScale',that.scaleShow)
					},
					fail: (err) => {

					}
				})
			},
			markertap(e) {
				var clickid = e.detail.markerId;
				console.log("click e=", e);
				console.log('this.markers', this.markers);
				console.log('time', this.markers[clickid].time);
				this.coverTime = this.markers[clickid].time;
				switch (this.markers[clickid].loc_type) {
					case 1:
						this.locateType = "GPS信号弱"
						this.locateTypeGps = false
						break;
					case 2:
						this.locateTypeGps = true
						this.locateType = "GPS信号强"	
						break;
					case 3:
						this.locateTypeGps = false
						this.locateType = "基站"
						break;
					case 4:
						this.locateTypeGps = false
						this.locateType = "home"
						break;
					default:
						break;
				}
				this.loAcquire(this.markers[clickid].latitude, this.markers[clickid].longitude);
				// this._mapContext.moveToLocation({
				// 	longitude: this.markers[clickid].longitude,
				// 	latitude: this.markers[clickid].latitude
				// })
			},
			adjustMapView() {
				try {
					console.log('start')
					if (!this._mapContext || this.markers.length === 0) return;

					// 调用地图组件的 includePoints 方法
					this._mapContext.includePoints({
						points: this.markers,
						padding: [90, 90, 90, 90] // 上右下左的边距
					});
					console.log('end')

				} catch (e) {
					console.log('包裹点出错', e)
				}

			},
			// 新的轨迹显示方法
			showNewMarker(data, date) {
			  let that = this;
			  if (data != null && data.length > 0) {
			    console.log('轨迹数据:', data);
			    let dataArray = data; // 可以直接使用数据，或进行过滤处理
			    // dataArray = util.filterData(data) // 如果需要过滤可以使用
			    var markarray = new Array();
			    try {
			      let cnt = 0;
			      
			      for (let i = 0; i < dataArray.length; i++) {
			        let item = dataArray[i];
			        
			        // 构建callout显示内容
			        var marker = {
			          id: cnt,
			          latitude: item.latitude.toString(),
			          longitude: item.longitude.toString(),
			          loc_type: item.locType,
			          loc_type_desc: item.locTypeDesc,
			          iconPath: '/static/imgs/tragectory/trajectory.png',
			          width: "24",
			          height: "24",
			          time: item.atime,
			          callout: {
			            content: item.atime.substring(11,16),
			           display: "BYCLICK",
			           color: '#ff5500',
			           bgColor: 'rgba(255, 255, 255, 1)',
			           textAlign: 'center',
			           borderRadius: '5px',
			           borderColor: 'rgba(255, 85, 0, 1.0)',
			           borderWidth: 1,
			           padding: 4
			          },
			          // 额外信息用于点击事件
			          // extraInfo: {
			          //   id: item.id,
			          //   number: item.number,
			          //   filterType: item.filterType,
			          //   extendData: item.extendData
			          // }
			        };
			        markarray[cnt] = marker;
			        cnt++;
			      }
			      
			    } catch (e) {
			      console.log('处理轨迹点出错', e);
			    }
			    
			    if (markarray.length > 0) {
			      console.log('生成标记点数量:', markarray.length);
			      // 生成轨迹线
			      const newList = markarray.map(item => ({
			        latitude: item.latitude,
			        longitude: item.longitude
			      }));
			      
			      let width = this.showPolyLine ? 15 : 0;
			      let line = {
			        points: newList,
			        color: "#31c27c",
			        width: width,
			        arrowLine: true,
			        borderWidth: 2
			      }
			      this.polyline = [line];
			      // 设置时间范围
				  console.log('markarray[markarray.length - 1].time)',markarray)
			      this.maxValue = this.timeToSeconds(markarray[markarray.length - 1].time);
			      this.minValue = this.timeToSeconds(markarray[0].time);
			      console.log('时间范围:', this.minValue, '->', this.maxValue);
			      let calloutitem = JSON.parse(JSON.stringify(markarray[markarray.length - 1]));
			      const event = {
			      	detail: {
			      		markerId: calloutitem.id
			      	},
			      };
			      calloutitem.id = 1000
			      calloutitem.callout.display = "ALWAYS"
			      calloutitem.calloutitem = ''
			      markarray.push(calloutitem)
			      this.markers = new Array();
			      this.markers = markarray;
			      // 设置地图中心点为最后一个点
			      this.longitude = markarray[markarray.length - 1].longitude;
			      this.latitude = markarray[markarray.length - 1].latitude;
			      this.markertap(event);
			      // 调整地图视野
			      setTimeout(() => {
			        this.adjustMapView();
			      }, 500);
			    } else {
			      this.showNoDataMessage();
			    }
			  } else {
			    this.showNoDataMessage();
			  }
			},
			// 无数据时的处理
			showNoDataMessage() {
			  uni.showToast({
			    title: '当天无轨迹数据',
			    icon: 'error'
			  });
			  this.markers = new Array();
			  this.polyline = new Array();
			  this.resetToCurrentLocation();
			},
			
			// 重置到当前位置
			resetToCurrentLocation() {
			  let that = this;
			  plus.geolocation.getCurrentPosition(function(p) {
			    console.log('当前位置的经度：' + p.coords.longitude);
			    console.log('当前位置的纬度：' + p.coords.latitude);
			    let pos = wgs84_to_gcj02(p.coords.longitude, p.coords.latitude);
			    that.latitude = pos[1];
			    that.longitude = pos[0];
			  }, function(e) {
			    console.error('获取位置失败：', e);
			    // 设置默认位置
			    that.latitude = 30.043543;
			    that.longitude = 120.808837;
			  });
			},
			getDistance(lat1, lon1, lat2, lon2) {
				// console.log('lat1',lat1)
				// console.log('lat1',lat2)
				// console.log('into getdistance',Math.PI)
				const radLat1 = lat1 * Math.PI / 180.0;
				// console.log('radLat1',radLat1)
				const radLon1 = lon1 * Math.PI / 180.0;
				const radLat2 = lat2 * Math.PI / 180.0;
				// console.log('radLat2',radLat2)
				const radLon2 = lon2 * Math.PI / 180.0;

				const a = radLat1 - radLat2;
				const b = radLon1 - radLon2;
				// console.log('a',a);
				const distance = 2 * Math.asin(Math.sqrt(
					Math.pow(Math.sin(a / 2), 2) +
					Math.cos(radLat1) * Math.cos(radLat2) *
					Math.pow(Math.sin(b / 2), 2)
				));
				// 地球平均半径（单位：米）
				const earthRadius = 6371000;

				// 计算距离（米）
				const resultDistance = distance * earthRadius;
				var result = Math.trunc(resultDistance);
				return result;
				// 	const radLat1 = lat1 * Math.PI / 180.0;
				// 	const radLon1 = lon1 * Math.PI / 180.0;
				// 	const radLat2 = lat2 * Math.PI / 180.0;
				// 	const radLon2 = lon2 * Math.PI / 180.0;
				// 	const a = radLat1 - radLat2;
				// 	const b = radLon1 - radLon2;
				// 	const distance = 2 * Math.asin(Math.sqrt(
				// 		Math.pow(Math.sin(a / 2), 2) +
				// 		Math.cos(radLat1) * Math.cos(radLat2) *
				// 		Math.pow(Math.sin(b / 2), 2)
				// 	));
				// 	// 地球平均半径（单位：米）
				// 	const earthRadius = 6371000;

				// 	// 计算距离（米）
				// 	const resultDistance = distance * earthRadius;
				// 	var result = Math.trunc(resultDistance);
				// 	return result;
			},
			// 新的数据获取方法
			getNewLocationList({serialCode = this.serial_code, queryDate = this.date}) {
			  return new Promise((resolve, reject) => {
			    getLocationList({serialCode, queryDate}).then((reciveData) => {
			      if (reciveData.success && reciveData.data && reciveData.data.length > 0) {
			        console.log('获取到轨迹数据:', reciveData.data);
			        this.showNewMarker(reciveData.data, queryDate);
			        resolve(reciveData.data);
			      } else {
			        uni.showToast({
			          title: '当天无位置数据',
			          icon: 'error'
			        });
			        this.markers = new Array();
			        this.polyline = new Array();
			        this.resetToCurrentLocation();
			        resolve([]);
			      }
			    }).catch(error => {
			      console.error('获取轨迹数据失败:', error);
			      reject(error);
			    });
			  });
			},
			dateClick(date, index) {
				uni.showLoading({
					title: date.toString(),
					mask: true
				})
				this.thumbTop = 0
				this.clickIndex = index;
				this.address = '';
				this.coverTime = '';
				this.locateType = '';
				const parts = date.split('-');
				this.clickDate = parts.join('/');
				//先去根据唯一标识去缓存里拿如果缓存里没有就请求数据，然后缓存
				//唯一标识怎末定呢
				//serial_code、date（格式2023-09-12）、points_number
				console.log('date click', date, this.serial_code)
				// 调用新的方法
				this.getNewLocationList({
				  serialCode: this.serial_code, 
				  queryDate: date
				})
				var storageKey = this.serial_code.toString() + date.toString();
				console.log('storageKey', storageKey);
				
				// return new Promise((resolve, reject) => {
				// 	var traDataUrl = getApp().globalData.internet + getApp().globalData
				// 		.trajectoryData;
				// 	console.log('参数', this.serial_code, date, this.Did, this.Pid)
				// 	uni.request({
				// 		url: traDataUrl,
				// 		method: 'POST',
				// 		data: {
				// 			serial_code: this.serial_code,
				// 			date: date,
				// 			did: this.Did,
				// 			pid: this.Pid
				// 		},
				// 		header: {
				// 			'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8', //重点
				// 			// 'token':cookie
				// 		},
				// 		success: (res) => {
				// 			resolve(res);
				// 		},
				// 		fail: (err) => {
				// 			reject(err);
				// 		}
				// 	})
				// }).then(res => {
				// 	uni.hideLoading();
				// 	if (res.data.code === 200) {
				// 		//缓存
				// 		console.log('获取日期路径成功', res);
				// 		var data = res.data.data;
				// 		//拿到数据后给marker赋值
				// 		uni.setStorageSync(storageKey, data)
				// 		this.showMarker(data, date);
				// 		console.log('新缓存一组日期路径数据', data);
				// 	} else {
				// 		console.log('获取日期路径失败', res);
				// 		var err = new Array();
				// 		this.showMarker(this.err, date);
				// 		uni.hideLoading()
				// 	}
				// }, err => {
				// 	uni.hideLoading()
				// 	uni.showToast({
				// 		title: '查询失败',
				// 		icon: 'error'
				// 	})
				// 	console.log('查询失败', err)
				// })

			},
			onTouchStart(event) {
				this.startX = event.touches[0].clientX; // 记录起始触摸位置
				this.isDragging = true; // 标记开始拖动
			},
			onTouchMove(event) {
				if (this.isDragging) {
					const deltaX = event.touches[0].clientX - this.startX; // 计算水平滑动距离
					this.scrollX += deltaX; // 更新滚动位置
					this.startX = event.touches[0].clientX; // 更新起始位置
					// 防止滚动超出边界，可以添加逻辑来限制滚动范围
					// 例如：if (this.scrollX < 0) this.scrollX = 0;
					//       if (this.scrollX > 最大滚动距离) this.scrollX = 最大滚动距离;
				}
			},
			onTouchEnd() {
				this.isDragging = false; // 结束拖动
			},
			getMapHeight() {
				const map = this.$refs.map;
				if (map) {
					return map.getBoundingClientRect().height;
				}
				return 0;
			},
			initDates() {
				const currentDate = new Date();
				for (let i = 0; i < 30; i++) {
					const date = new Date(currentDate);
					date.setDate(currentDate.getDate() - i);
					const formattedDate = this.formatDate(date);
					this.dates.push(formattedDate);
				}
			},
			formatDate(date) {
				const year = date.getFullYear();
				const month = (date.getMonth() + 1).toString().padStart(2, '0');
				const day = date.getDate().toString().padStart(2, '0');
				// return `${year}-${month}-${day}`;
				const weekdays = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
				return {
					days: weekdays[date.getDay()],
					date: `${year}-${month}-${day}`
				}
			},
			getNavHeight() {
				const nav = this.$refs.nav;
				if (nav) {
					return nav.getBoundingClientRect().height;
				}
				return 0;
			},
			getScrollViewHeight() {
				const scrollView = this.$refs.scrollView;
				if (scrollView) {
					return scrollView.getBoundingClientRect().height;
				}
				return 0;
			},
			returnParent() {
				getApp().backParents();
			},
			calculateTimeDifferenceInSeconds(startTime, endTime) {
				// 将时间字符串拆分为小时、分钟和秒
				const startParts = startTime.split(':');
				const endParts = endTime.split(':');

				// 将时间部分转换为整数
				const startHours = parseInt(startParts[0]);
				const startMinutes = parseInt(startParts[1]);
				const startSeconds = parseInt(startParts[2]);

				const endHours = parseInt(endParts[0]);
				const endMinutes = parseInt(endParts[1]);
				const endSeconds = parseInt(endParts[2]);

				// 将时间转换为秒
				const startTotalSeconds = (startHours * 3600) + (startMinutes * 60) + startSeconds;
				const endTotalSeconds = (endHours * 3600) + (endMinutes * 60) + endSeconds;

				// 计算时间差并返回结果
				const timeDifferenceInSeconds = Math.abs(endTotalSeconds - startTotalSeconds);
				return timeDifferenceInSeconds;
			}
		},
	};
</script>

