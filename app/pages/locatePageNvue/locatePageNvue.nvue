							icon: 'success',
						})
						this.pageStatues = 0
						setTimeout(() => {
							uni.navigateTo({
								url: "/pages/setting/firmware/firmware"
							})
						}, 500)

					}, 1000)
				}
			},
			cancWifiSet() {
				this.showWifiPoint = false
			},
			toModelChange() {
				this.pageStatues = 0
				uni.navigateTo({
					url: '/pages/locatePageNvue/bellSetting/locationModelSetting/locationModelSetting?serialcode=' +
						this.loadobject.serialCode +
						'&rute=0' +
						"&deviceId=" + this.blueToothDeviceId + '&modol=' + this.DeviceConnectModol
				})
			},
			compareVersions(version1, version2) {
				// 将版本号拆分为数组  
				const arr1 = version1.split('.');
				const arr2 = version2.split('.');

				// 找到两个数组中最长的长度  
				const maxLength = Math.max(arr1.length, arr2.length);

				// 逐位比较  
				for (let i = 0; i < maxLength; i++) {
					// 如果当前位不存在，则视为0  
					const num1 = parseInt(arr1[i] || 0, 10);
					const num2 = parseInt(arr2[i] || 0, 10);

					if (num1 > num2) {
						return 1; // version1 大于 version2  
					} else if (num1 < num2) {
						return -1; // version1 小于 version2  
					}
				}
				// 所有位都相等  
				return 0; // version1 等于 version2  
			},

			nolonger() {
				this.remind = !this.remind
				this.savePage()
			},
			getHomeWifi() {
				let url = getApp().globalData.internet + getApp().globalData.queryHomeWifi;
				let data = {
					serial_code: this.loadobject.serialCode
				}
				uni.request({
					url: url, //仅为示例，并非真实接口地址。
					method: 'POST',
					data: data,
					header: {
						'Content-Type': 'application/json' //重点
					},
					success: (res) => {
						if (res.data.data != null) {
							let transData = util.transformWifiData(res.data.data)
							console.log('获取到的家庭wifi数据', transData)
							this.homeWifi = {
								id: 1,
								latitude: transData.data[0].wifi_location.la,
								longitude: transData.data[0].wifi_location.lo,
								iconPath: "/static/xixin/home.png",
								anchor: {
									x: .5,
									y: .5
								},
								width: 40,
								height: 40,
							};
						} else {
							if (!this.remind && this.pageStatues === 1) {
								this.showWifiPoint = true
							}
							this.homeWifi = null
							this.markers = this.markers.filter(item => item.id != 1)
						}
						let newMarker = this.markers.slice(0);
						// newMarker[1] = marker;
						this.markers = new Array();
						this.markers = newMarker;
					},
					fail: ((err) => {
						console.log('require wifi list fail', JSON.stringify(err))
					})
				});
			},
			checkWifiIsSet() {
				console.log('this.loadobject.serialCode', this.loadobject)
				let versioncomapre = this.compareVersions(getApp().globalData.appVersion, '1.5.9')
				if (versioncomapre === -1) {
					uni.showModal({
						title: '温馨提示',
						content: '家庭wifi功能已上线，此功能可以提升定位效果，将app升级到最新版本即可体验'
					})
				} else {
					this.getHomeWifi()
				}
			},
			openHelp() {
				this.pageStatues = 0
				uni.navigateTo({
					url: '/pages/locatePageNvue/help/help'
				})
			},
			showFloorTitle() {
				if (this.locateInfoData != '设备在线' && this.locateInfoData != '设备离线')
					this.showFloor = !this.showFloor
				else if (this.locateInfoData === '设备离线')
					this.clickOffline()
			},
			openCorrect() {
				if (this.firmwareVersion >= 60||this.loadobject.serialCode.substring(0,2)==='ae') {
					//携带参数 请求到的点
					let petpose = this.markers.filter(item => item.id === 2)
					console.log('petpose', petpose)
					if (petpose) {
						if (petpose[0].loc_type === 1) {
							this.pageStatues = 0
							uni.navigateTo({
								url: '/pages/locatePageNvue/correct/correct?para=' + JSON.stringify(petpose[0]) +
									"&rute=1"
							})
						} else {
							let message = 'gps不可纠偏，请尝试刷新'
							if (petpose[0].loc_type === 4)
								message = '家庭位置不可纠偏，请尝试刷新'
							else if (petpose[0].loc_type === 3)
								message = '基站位置不可纠偏，请尝试刷新'

							uni.showToast({
								title: message,
								icon: 'none'
							})
						}
					} else {
						uni.showToast({
							title: '没有可纠偏点位',
							icon: 'none'
						})
					}
				} else {
					uni.showToast({
						title: '请先升级固件',
						icon: 'none'
					})
					setTimeout(() => {
						uni.showToast({
							title: '即将自动跳转',
							icon: 'success',
						})
						this.pageStatues = 0
						setTimeout(() => {
							uni.navigateTo({
								url: "/pages/setting/firmware/firmware"
							})
						}, 500)

					}, 1000)
				}


			},
			toBellSetting() {
				// if(getApp().globalData.myFirewareVersion>=41)
				// {
				let phoneMarker = this.markers.find(item => item.id === 0)
				if (phoneMarker) {
					this.savePage()
					this.pageStatues = 0
					uni.navigateTo({
						url: '/pages/locatePageNvue/bellSetting/bellSetting?serialcode=' + this.loadobject
							.serialCode +
							"&deviceId=" + this.blueToothDeviceId + "&la=" + phoneMarker.latitude + "&lo=" +
							phoneMarker.longitude
					})
				} else {
					uni.showToast({
						title: '获取位置出错了',
						icon: 'none'
					})
				}
			},
			leadTimeClick(index) {
				this.leadClick = index
			},
			coverIcon(opt) {
				if (opt === 1) {
					this.ladarUrl = '/static/new/1@3x.png'
					this.railUrl = '/static/new/3@3x-nouse.png'
					this.leadUrl = '/static/new/2@3x-nouse.png'
				} else if (opt === 2) {
					this.ladarUrl = '/static/new/1@3x-nouse.png'
					this.railUrl = '/static/new/3@3x.png'
					this.leadUrl = '/static/new/2@3x-nouse.png'
				} else if (opt === 3) {
					this.ladarUrl = '/static/new/1@3x-nouse.png'
					this.railUrl = '/static/new/3@3x-nouse.png'
					this.leadUrl = '/static/new/2@3x.png'
				} else if (opt === 0) {
					this.ladarUrl = '/static/new/1@3x.png'
					this.railUrl = '/static/new/3@3x.png'
					this.leadUrl = '/static/new/2@3x.png'
				}
			},
			getWorkModeNew(serialCode) {
				getDeviceWorkMode(serialCode).then(res => {
					let mode = 0
					console.log('获取设备工作状态', res)
					if (res.data.workMode.continuous) {
						mode = res.data.workMode.continuous
					} else {
						mode = res.data.control.continuous
					}
					if (mode === 0) {
						this.serviceLocateMode = '标准定位'
					} else if (mode === 1) {
						this.serviceLocateMode = '快速定位'
					}
					if ((res.data.workMode.rgb != res.data.control.rgb)) { //&& this.DeviceConnectModol === 1
						setTimeout(() => {
							this.clickRgbFun('rgb', false, false, true)
						}, 200)
					} else {
						this.waitRgbText = ''
						this.clickRgb = res.data.control.rgb
					}
					if ((res.data.workMode.buzzer != res.data.control.buzzer)) {
						setTimeout(() => {
							this.clickRgbFun('bell', false, false, true)
						}, 400)
					} else {
						this.waitBellText = ''
						this.clickBell = res.data.control.buzzer
					}
					this.DeviceConnectModol = res.data.workMode.connect
					if (res.data.workMode.connect != res.data.control.connect) {
						this.deviceConnectModolStatue = '切换中'
						if (res.data.control.connect === 1) {
							//拿一个上次通讯时间
							console.log('this.nextCommunicate',this.nextCommunicate)
							if (this.nextCommunicate) {
								this.showCountdown = true
								this.startCountdown(this.nextCommunicate)
							}
						}
					} else {
						this.showCountdown = false
						clearInterval(this.countdownTimer);
						if (this.DeviceConnectModol === 0) {
							this.deviceConnectModolStatue = '标准模式'
						}

						if (this.DeviceConnectModol === 1) {
							this.deviceConnectModolStatue = '高频模式'
						}
					}
					this.petAvatar = this.loadobject.petIcon
					if (res.data.workMode.rgb === 1) {
						this.petAvatar = this.loadobject.petLightIcon
						// this.clickRgb = true
					}
					if (res.data.workMode.buzzer === 1) {
						//加一个响铃图标
						this.petAvatar = this.loadobject.petBellIcon
						// this.clickBell = true
						if (res.data.workMode.rgb === 1)
							this.petAvatar = this.loadobject.petBLIcon
					}
					this.getPetPositionNew(this.loadobject, false, false)
				})
			},
			sendLocateMode(serialcode, mode) {
				// console.error("into ")
				var data = {
					uid: this.loadobject.uid,
					serialCode: this.loadobject.serialCode,
					commandType: COMMAND_TYPE.CONTINUOUS_LOCATION,
					commandValue: mode
				};
				sendCommand(data).then(recivedata => {
					console.log('设置定位模式成功', success)
				})
				// let setlocate = {
				// 	serial_code: serialcode,
				// 	continuous_mode: mode
				// }
				// util.requestService(getApp().globalData.locateMode, setlocate).then(
				// 	(success) => {
