}

// 检查位置服务是否启用函数类型
export type IsLocationEnabled = (options : IsLocationEnabledCallbackResult) => void

// 媒体类型
export type MediaType = 'network' | 'local'

// 媒体文件类型
export type MediaFileType = 'image' | 'video'

// 网络图片下载进度信息
export type DownloadProgressInfo = {
	/**
	 * 已下载的字节数
	 */
	downloadedBytes : number
	/**
	 * 总字节数，可能为 -1 表示未知
	 */
	totalBytes : number
	/**
	 * 下载进度百分比 (0-100)，当 totalBytes 未知时为 -1
	 */
	progress : number
}

// 保存媒体文件到相册参数
export type SaveImageToAlbumOptions = {
	/**
	 * 媒体文件路径，支持网络文件(http/https)和本地沙盒目录文件
	 */
	imageUrl : string
	/**
	 * 媒体文件类型，'image' 表示图片，'video' 表示视频
	 * 如果不传此参数，会根据文件扩展名自动判断
	 */
	fileType ?: MediaFileType
	/**
	 * 媒体来源类型，'network' 表示网络文件，'local' 表示本地文件
	 * 如果不传此参数，会根据 imageUrl 自动判断
	 */
	mediaType ?: MediaType
	/**
	 * 网络文件下载开始回调（仅对网络文件有效）
	 */
	onDownloadStart ?: () => void
	/**
	 * 网络文件下载完成回调（仅对网络文件有效）
	 */
	onDownloadComplete ?: (filePath : string) => void
	/**
	 * 成功回调
	 */
	success ?: (res : SaveImageToAlbumResult) => void
	/**
	 * 失败回调
	 */
	fail ?: (err : SaveImageToAlbumErrorResult) => void
	/**
	 * 完成回调
	 */
	complete ?: (res : any) => void
}

// 保存媒体文件到相册成功结果
export type SaveImageToAlbumResult = {
	/**
	 * 错误码，0表示成功
	 */
	errCode : number
	/**
	 * 错误信息
	 */
	errMsg : string
	/**
	 * 保存后的文件路径
	 */
	savedPath ?: string
}

// 保存媒体文件到相册失败结果
export type SaveImageToAlbumErrorResult = {
	/**
	 * 错误码
	 */
	errCode : number
	/**
	 * 错误信息
	 */
	errMsg : string
}

// 保存媒体文件到相册函数类型
export type SaveImageToAlbum = (options : SaveImageToAlbumOptions) => Promise<SaveImageToAlbumResult>

// ============ 保存文件到Download目录相关接口定义 ============

// 保存文件到Download目录参数
export type SaveToDownloadOptions = {
	/**
	 * 文件内容，可以是字符串或Uint8Array（当使用content时）
	 */
	content ?: string | Uint8Array
	/**
	 * 文件URL，支持网络URL或本地文件路径（当使用fileUrl时）
	 */
	fileUrl ?: string
	/**
	 * 文件名，包含扩展名
	 */
	fileName : string
	/**
	 * 文件MIME类型，如 'text/plain', 'application/json' 等
	 */
	mimeType ?: string
	/**
	 * 媒体类型，'network' 表示网络文件，'local' 表示本地文件
	 * 如果不指定，会根据 fileUrl 自动判断
	 */
	mediaType ?: MediaType
	/**
	 * 下载开始回调（仅网络文件有效）
	 */
	onDownloadStart ?: () => void
	/**
	 * 下载完成回调（仅网络文件有效）
	 */
	onDownloadComplete ?: (filePath : string) => void
	/**
	 * 成功回调
	 */
	success ?: (res : SaveToDownloadResult) => void
	/**
	 * 失败回调
	 */
	fail ?: (err : SaveToDownloadErrorResult) => void
	/**
	 * 完成回调
	 */
	complete ?: (res : any) => void
}

// 保存文件到Download目录成功结果
export type SaveToDownloadResult = {
	/**
	 * 错误码，0表示成功
	 */
	errCode : number
	/**
	 * 错误信息
	 */
	errMsg : string
	/**
	 * 保存后的文件路径
	 */
	savedPath ?: string
}

// 保存文件到Download目录失败结果
export type SaveToDownloadErrorResult = {
	/**
	 * 错误码
	 */
	errCode : number
	/**
	 * 错误信息
	 */
	errMsg : string
}

// 保存文件到Download目录函数类型
export type SaveToDownload = (options : SaveToDownloadOptions) => Promise<SaveToDownloadResult>

