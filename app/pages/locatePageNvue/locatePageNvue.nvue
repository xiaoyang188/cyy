									.stringify(paramater)
							})
						}
					} else {
						uni.showToast({
							title: '获取位置出错了',
							icon: 'none'
						})
					}

				} else {
					uni.showToast({
						title: '请先升级固件',
						icon: 'none'
					})
					setTimeout(() => {
						uni.showToast({
