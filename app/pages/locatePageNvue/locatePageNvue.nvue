			sureDeleteRail(opt) {
				if (opt === 1) {
					//删除 showDeleteRailTitle序列号的围栏
					if (this.localSavePolygons[this.showDeleteRailTitle].switch) {
						uni.showToast({
							title: "请先关闭围栏",
							icon: 'none'
						})
					} else {
						this.localSavePolygons[this.showDeleteRailTitle] = {
							points: [],
							name: "",
							switch: false
						}
					}

				}
				this.showDeleteRailTitle = -1
			},
			closeRail(index) {
				let requestFenceUrl = getApp().globalData.internet + getApp().globalData.electronicFence;
				let para = {
					switch: 0,
					did: this.loadobject.did,
					serial_code: this.loadobject.serialCode,
				}
				util.requestDataFrom(requestFenceUrl, para).then((rebackData2) => {
					console.log('查询围栏', rebackData2);
					if (rebackData2.data.code === 200) {
						this.railing = false;
						this.clearPolygonsPoints();
						var marker = this.markers.filter(item => item.id <= 3);
						this.outinside = false;
						this.markers = [];
						this.markers = marker;
						getApp().globalData.railOut = false;
						let savedata = JSON.stringify(getApp().globalData.railOut);
						uni.setStorage({
							key: 'railOut',
							data: savedata,
							success: function() {
								console.log('railOut数据缓存成功');
							}
						});
						this.localSavePolygons[index].switch = false
						this.savePage()
					} else {
						uni.showToast({
							title: rebackData2.data.msg,
							icon: 'none'
						})
					}
				})
			},

			switchRail(index) {
				this.actionPolygonIndex = index
				let offOn = !this.localSavePolygons[index].switch
				//1  直接关  2 直接开  3 关一个 开一个 等于直接开
				if (offOn === false) {
					//调用结束围栏的接口
					this.closeRail(index)
				} else {
					this.clearPolygonsPoints();
					var marker = this.markers.filter(item => item.id <= 3)
					this.markers = [];
					this.markers = marker;
					this.polygonsPoints = this.localSavePolygons[index].points
					this.sureRail(1)
				}

			},
			undoRailPoint(e) {
				let clickid = e.detail.markerId;
				console.log('点击了气泡点', e.detail)
				// this.markers.splice(clickid, 1);
				let clickItem = this.markers.find(item => item.id === clickid)
				console.log('点击的item', clickItem)
				console.log('clickid', clickid)
				console.log("marker删除前", this.markers)
				if (clickid > 3)
					this.markers = this.markers.filter(item => item.id != clickid)
				console.log("marker删除后", this.markers)
				// this.clearPolygonsPoints();

				console.log("polygonsPoints删除前", this.polygonsPoints)
				this.polygonsPoints = this.polygonsPoints.filter(item => item.latitude != clickItem.latitude)
				console.log("polygonsPoints删除后", this.polygonsPoints)
				// if (this.homeWifi != null)
				// 	points.splice(clickid - 4, 1)
				// else
				// 	points.splice(clickid - 3, 1)
				var polygon = [{
					points: this.polygonsPoints,
					strokeWidth: 2,
					strokeColor: '#FF0000',
					fillColor: 'rgba(255,0,0,0.2)',
					zIndex: 1,
				}, ]
				this.polygons = []
				this.polygons = polygon;
			},
			callouttap(e) {
				this.undoRailPoint(e)
			},

			markertap(e) {
				this.undoRailPoint(e)
			},
			deleteRail(index) {
				this.showDeleteRailTitle = index
			},
			clickNewRail(item, index) {
				//如果围栏是打开的 提醒先关闭
				if (this.localSavePolygons[index].switch) {
					uni.showToast({
						title: '请先关闭围栏，再点击编辑',
						icon: 'none'
					})
					return
				}
				//清除显示围栏
				this.clearPolygonsPoints();
				var marker = this.markers.filter(item => item.id <= 3)
				this.markers = [];
				this.markers = marker;
				//要区分一下围栏功能有没有正在开启 
				// console.log('item', item)
				this.clickPolygonIndex = index
				for (let i = 0; i < item.points.length; i++) {
					let element = item.points[i];
					let latitude = element.latitude
					let longitude = element.longitude;
					var point = {
						latitude: latitude,
						longitude: longitude,
					}
					this.polygonsPoints.push(point);
					console.log('this.polygonsPoints=', this.polygonsPoints);
					// 创建标记点
					var marker = [{
						id: this.markers.length + 4,
						latitude,
						longitude,
						title: '点击位置',
						iconPath: '../../static/xixin/railPoint.png', // 自定义标记图标路径
						width: 32,
						height: 32,
						callout: {
							content: "撤销",
							display: "ALWAYS",
							color: '#ff5500',
							bgColor: 'rgba(255, 255, 255, 1)',
							textAlign: 'center',
							borderRadius: '5px',
							borderColor: 'rgba(255, 85, 0, 1.0)',
							borderWidth: 1,
							padding: 4
						}
					}, ];
					var newMarker = this.markers.slice(0);
					newMarker.push(marker[0]);
					this.markers = newMarker;
				}
				let polysort = this.sortByClockwiseOrder(this.polygonsPoints);
				var polygon = [{
					points: polysort,
					strokeWidth: 2,
					strokeColor: '#FF0000',
					fillColor: 'rgba(255,0,0,0.2)',
					zIndex: 1,
				}, ]
				this.polygons = polygon;
				// console.log('this.markers', this.markers)
				this.showNewRail = true
				this.railToast = false
				setTimeout(() => {
					this.railToast = true
				}, 50)

			},

			clickedRgbOrBell(rgbOrBell) {
				let that = this
				const now = Date.now()
				if (rgbOrBell === 'bell') {
					if (now - this.lastClickBellTime < 2500) {
						uni.showToast({
							title: '操作太频繁了',
							icon: 'none'
						})
					} else {
						let ss = '关闭'
						if (!this.clickBell)
							ss = '开启'
						uni.showModal({
							title: "温馨提示",
							content: "点击确定发送" + ss + "响铃命令",
							success(res) {
								if (res.confirm) {
									that.clickRgbFun(rgbOrBell, true, false, true)
									that.lastClickBellTime = now
								}
							}
						})
					}
				} else if (rgbOrBell === 'rgb') {
					if (now - this.lastClickRGBTime < 2500) {
						uni.showToast({
							title: '操作太频繁了',
							icon: 'none'
						})
					} else {
						let ss = '关闭'
						if (!this.clickRgb)
							ss = '开启'
						uni.showModal({
							title: "温馨提示",
							content: "点击确定发送" + ss + "灯光命令",
							success(res) {
								if (res.confirm) {
									that.clickRgbFun(rgbOrBell, true, false, true)
									that.lastClickRGBTime = now
								}
							}
						})
					}
				}
			},
			clickRgbFun(rgbOrBell, opt, opt2, opt3) {
				//opt 代表是否变更状态  opt2 代表是否禁用 opt3代表是否弹关闭命令已发送的接口
				console.log('开关rgb和 蜂鸣器', rgbOrBell, opt, this.clickRgb, this.clickBell)
				let buttonClick = this.clickRgb
				if (rgbOrBell === 'bell')
					buttonClick = this.clickBell
				if (opt)
					buttonClick = !buttonClick
				let cmd = 0
				if (buttonClick)
					cmd = 1
				console.log("into click rgb", cmd)
				let setrgb = {
					serial_code: this.loadobject.serialCode,
					rgb_control: cmd
				}
				var data = {
					uid: this.loadobject.uid,
					serialCode: this.loadobject.serialCode,
					commandType: COMMAND_TYPE.RGB_LIGHT,
					commandValue: cmd
				};
				let setRgbcontrol = setRgb(cmd)
				let url = getApp().globalData.setRgb
				if (rgbOrBell === 'bell') {
					setRgbcontrol = setBuzzer(cmd)
					url = getApp().globalData.setBuzzer
					setrgb = {
						serial_code: this.loadobject.serialCode,
						buzzer_control: cmd
					}
					data = {
						uid: this.loadobject.uid,
						serialCode: this.loadobject.serialCode,
						commandType: COMMAND_TYPE.BUZZER,
						commandValue: cmd
					};
				}
				sendCommand(data).then((recivedata) => {
					console.log('响铃 recivedata', recivedata)
					if (rgbOrBell === 'bell') {
						this.clickBell = buttonClick
						this.clickBellImgSrc = this.clickBell ? '/static/imgs/locate/bellYellow.png' :
							'/static/imgs/locate/bell.png'
						if (cmd === 0)
							this.waitBellText = '关闭中'
						else
							this.waitBellText = '开启中'
					} else {
						this.clickRgb = buttonClick
						this.clickRgbImgSrc = this.clickRgb ? '/static/imgs/locate/lightYellow.png' :
							'/static/imgs/locate/light.png'
						if (cmd === 0)
							this.waitRgbText = '关闭中'
						else
							this.waitRgbText = '开启中'
					}
					if (this.bluetoothConnect) {
						console.log('准备蓝牙发送')
						util.BleWrite(setRgbcontrol, this.blueToothDeviceId, this.blueToothServiceId, this
							.blueToothCharacteristicId); //给设备发灯的请求
					}
					this.savePage()
				}).catch((err) => {
					uni.showToast({
						icon:'none',
						title:'打开响铃灯光失败，请稍后重试'
					})
				})
			},
			changeMapLevel() {
				if (this.loadobject.serialCode)
					this.enableSatellite = !this.enableSatellite
			},

			setWifi() {
				let that = this
				this.showWifiPoint = false
				let phoneMarker = this.markers.find(item => item.id === 0)
				if (getApp().globalData.myFirewareVersion >= 44||this.loadobject.serialCode.substring(0,2)==='ae') {
					console.log('点击了跳转')
					if (phoneMarker) {
						uni.showLoading({
							title: '跳转中...',
						});
						let paramater = {
							serialCode: that.loadobject.serialCode,
							rute: 'set',
							la: phoneMarker.latitude,
							lo: phoneMarker.longitude,
							wifi_la: '',
							wifi_lo: ''
						}
						uni.hideLoading()
						console.log('执行跳转命令')
						this.pageStatues = 0
						uni.closeBluetoothAdapter({
							success(res) {
								console.error('onhide关闭蓝牙模块', res);
							}
						});
						if (getApp().globalData.myHardwareVersion >= 38) {
							uni.navigateTo({
								url: '/pages/my/wifiSetting/wifiSetting?paramater=' + JSON
									.stringify(paramater)
							})
						} else {
							uni.navigateTo({
