<template>
	<view class="container">
		<!-- 导航栏 -->
		<!-- <div class="row_between" style="flex-direction: row;" :style="{ height: navHeight+'px' }">
			<view class="nav_icon_view" @click="returnParent">
				<uni-icons type="left" style="" size="20" width="100rpx"
					color="rgb(18, 18, 18)"></uni-icons>
			</view>
			<view style="display: flex;justify-content: center;width: 100%;">
				<text style="font-size: 50rpx;">家庭WiFi</text>
			</view>
			<view  style="width: 150rpx;">
				<image
					:src="bluetoothConnect ? '/static/icons/wifi_settings/bluetooth.png':'/static/icons/wifi_settings/bluetoothGray.png'"
					style="width: 24rpx;height: 35rpx;"></image>
			</view>
		</div> -->
		<view v-if="isShowGuild===6" @click="closeGuild" class="mask"
			:style="{ height: mapHeight+'px',width :screenWidth+'px'}">
			<view style="position: relative;" :style="{ height: mapHeight+'px',width :screenWidth+'px'}">
				<view @click="skipGuild" class="col_start" style="position:absolute;top: 120rpx;left:100rpx">
					<image src="/static/imgs/home/skip.png" style="width: 70rpx;height: 70rpx;"></image>
					<text style="margin-top: 3rpx;color: #ffffff;font-size: 20rpx;">跳过引导</text>
				</view>
				<view
					style="height: 300rpx;flex-direction: column;justify-content: space-between;justify-content: space-between;align-items: center;"
					:style="labelMarginTop">
					<view style="height: 140rpx;background-color: rgb(255, 255, 255);border-radius: 10px;
						display: flex;flex-direction: column;justify-content: space-around;align-items: flex-start" :style="labelWidth">
						<view style="padding-left: 15rpx;"><text style="font-size: 30rpx;">请将WiFi移动到当前项圈所在位置：</text>
						</view>
						<view
							style="padding-left: 15rpx;display: flex;flex-direction: row;align-items: center;justify-content: start;">
							<cover-image src="/static/xixin/railPoint.png"
								style="width: 40rpx;height: 40rpx;margin-right: 15rpx;"></cover-image>
							<text
								style=" font-size: 30rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;color: rgb(229, 156, 134);">{{locateName}}</text>
						</view>
					</view>
					<button @click="sureChange" style="margin-top: 30rpx; height: 80rpx;background-color: rgba(255, 87, 51, 1);border-radius: 10px;display: flex;flex-direction: row;
						justify-content: center;align-items: center;" :style="labelWidth">
						<text style="font-size: 35rpx; color: aliceblue;">确认</text>
					</button>
					<view style="display: flex;flex-direction: row;" :style="labelWidth">
						<view style="display: flex;flex-direction: column;height: 50rpx;position: relative;">
							<view class="scale-border"><text
									style="color: rgba(0, 0, 0, 0);margin-left: 10rpx;margin-right: 30rpx;">{{scaleShow}}</text>
							</view>
							<view style="position: absolute;left: 10px;">{{scaleShow}}</view>
						</view>
					</view>
				</view>
			</view>

		</view>
		<view v-if="showFimwareTitle" class="mask" style="width: 750rpx;" :style="{height:mapHeight+'px'}">
			<view class="drawtoast" style="width: 100%;height: 550rpx;">
				<view style="background-color: #FFFFFF;width:250px;height: 550rpx;border-radius: 30px;">
					<view class="topBar">
						<text style="color: #FFFFFF;">温馨提示</text>
					</view>
					<view style="margin-top: 10px;align-items: center;padding-left: 5px;">
						<text style="padding: 20rpx;line-height: 45rpx;">家庭WiFi功能需要固件版本大于44，请先升级固件后回到本页面设置</text>
					</view>

					<view style="flex-direction: row;justify-content: space-between;width: 250px;margin-top: 10px;">
						<view></view>
						<button @click="goUpgrade(false)" class="myButton">
							<text style="color: #FFFFFF;">跳过</text></button>
						<button @click="goUpgrade(true)" class="myButton"><text
								style="color: #FFFFFF;">去升级</text></button>
						<view></view>
					</view>
				</view>
			</view>
		</view>
		<view v-if="showDateLineTitle" class="mask" style="width: 750rpx;" :style="{height:mapHeight+'px'}">
			<view class="drawtoast" style="width: 100%;">
				<view style="background-color: #FFFFFF;width:250px;border-radius: 30px;">
					<view class="topBar">
						<text style="color: #FFFFFF;">温馨提示</text>
					</view>
					<view style="align-items: center;padding-left: 5px;">
						<text style="padding: 20rpx;line-height: 45rpx;">{{timeLineText}}</text>
					</view>
					<view style="flex-direction: row;justify-content: space-between;width: 250px;margin-top: 10px;">
						<view></view>
						<button @click="goUpgrade(false)" class="myButton" style="margin-bottom: 10rpx;">
							<text style="color: #FFFFFF;">确定</text></button>
						<view></view>
					</view>
				</view>
			</view>
		</view>
		<view v-if="showProgressTitle" class="mask" style="width: 750rpx;" :style="{height:mapHeight+'px'}">
			<view class="drawtoast" style="width: 100%;">
				<view style="background-color: #FFFFFF;width:250px;border-radius: 30px;">
					<view class="topBar">
						<text style="color: #FFFFFF;">温馨提示</text>
					</view>
					<view style="margin-top: 10px;align-items: center;padding-left: 5px;">
						<div
							style="width: 140rpx;height: 140rpx;display: flex;align-items: center;justify-content: center;">
							<div class="rotate-background" :style="{ transform: 'rotate('+ladarRotateAngle+'deg)'}">
								<image src="/static/xixin/rotate-background.png" style="width: 140rpx;height: 140rpx;">
								</image>
							</div>
							<text style="font-size: 50rpx;">{{ssidText}}</text>
							<text style="font-size: 18rpx;">信号</text>
						</div>
					</view>
					<view style="align-items: center;padding-left: 5px;">
						<text style="padding: 20rpx;line-height: 45rpx;">{{titleContent}}</text>
					</view>
					<view style="flex-direction: row;justify-content: space-between;width: 250px;margin-bottom: 15rpx;">
						<view></view>
						<button @click="returnParent" class="myButton">
							<text style="color: #FFFFFF;">不设置了</text></button>
						<button @click="sureChange" :class="{ 'myButton': maxSsid>0, 'disabledButton': maxSsid<0 }"
							:disabled="maxSsid<0">
							<text style="color: #FFFFFF;">确定</text></button>
						<view></view>
					</view>
				</view>
			</view>
		</view>
		<view :style="{ height: mapHeight+'px' }">
			<map id='map' class="map" :show-location="false" enable-overlooking='true' :markers="markers"
				:scale="mapSclae" @regionchange="regionchange" :circles="circles">
				<view style="position: relative;">
					<view
						style=" position: absolute;left: 18px;top:120rpx;display: flex;flex-direction: column;align-items: center;background-color: rgb(255,255,255);border-radius: 30rpx;">
						<image @click="returnParent" src="/static/icons/public/icon-back.png"
							style="width: 60rpx;height: 60rpx;"></image>
					</view>
					<view
						style=" position: absolute;right: 18px;top:120rpx;display: flex;flex-direction: column;align-items: center;background-color: rgb(255,255,255);border-radius: 30rpx;">
						<image
							:src="bluetoothConnect ? '/static/icons/wifi_settings/bluetooth.png':'/static/icons/wifi_settings/bluetoothGray.png'"
							style="width: 24rpx;height: 35rpx;"></image>
					</view>
					<!-- <view style="position: fixed;background-color: black;z-index: 9999;" :style="{ height: mapHeight+'px',width:screenWidth+'px' }"></view> -->
					<view
						style="height: 300rpx;flex-direction: column;justify-content: space-between;justify-content: space-between;align-items: center;"
						:style="labelMarginTop">
						<view style="height: 140rpx;background-color: rgb(255, 255, 255);border-radius: 10px;
							display: flex;flex-direction: column;justify-content: space-around;align-items: flex-start" :style="labelWidth">
							<view style="padding-left: 15rpx;"><text style="font-size: 30rpx;">请将WiFi移动到当前项圈所在位置：</text>
							</view>
							<view
								style="padding-left: 15rpx;display: flex;flex-direction: row;align-items: center;justify-content: start;">
								<cover-image src="/static/xixin/railPoint.png"
									style="width: 40rpx;height: 40rpx;margin-right: 15rpx;"></cover-image>
								<text
									style=" font-size: 30rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;color: rgb(229, 156, 134);">{{locateName}}</text>
							</view>
						</view>
						<button @click="sureChange" style="margin-top: 30rpx; height: 80rpx;background-color: rgba(255, 87, 51, 1);border-radius: 10px;display: flex;flex-direction: row;
							justify-content: center;align-items: center;" :style="labelWidth">
							<text style="font-size: 35rpx; color: aliceblue;">确认</text>
						</button>
						<view style="display: flex;flex-direction: row;" :style="labelWidth">
							<view style="display: flex;flex-direction: column;height: 50rpx;position: relative;">
								<view class="scale-border"><text
										style="color: rgba(0, 0, 0, 0);margin-left: 10rpx;margin-right: 30rpx;">{{scaleShow}}</text>
								</view>
								<view style="position: absolute;left: 10px;">{{scaleShow}}</view>
							</view>
						</view>
					</view>
					<view style="position: absolute;height: 120rpx;display: flex;flex-direction:column;
						justify-content: start;align-items: center;" :style="scaleTopType">

						<view style="width: 120rpx;height: 65rpx;background-color: rgb(229, 156, 134);border-radius: 30rpx;display: flex;flex-direction: row;
							justify-content: center;align-items: center;">
							<cover-image src="/static/xixin/wifi0.png"
								style="width: 35rpx;height: 35rpx;margin-right: 9rpx;">
							</cover-image>

							<text style="color: rgb(255, 255, 255);font-size: 35rpx;font-weight: bold;">家</text>

						</view>
						<view style="width: 5rpx;height: 40rpx;background-color: rgb(229, 156, 134);"></view>
					</view>
				</view>
			</map>
		</view>
	</view>
</template>

<script>
	import util from '/common/util';
	import fileParse from '/common/fileParesUtil'
	import logger from '/common/logger.js'
	import {
		wgs84_to_gcj02
	} from '/common/wgs84ToGcj02';
	import { $uni } from "@/utils/main.js"

	export default {
		data() {
			return {
				showDateLineTitle: false,
				timeLineText: '耗时过长可以尝试从新进入界面',
				maxSsid: 0,
				ssidText: '差',
				ladarRotateAngle: 0,
				titleContent: "当期检测到WIFI信号太差，请将设备移动到信号源附近",
				pointerIntervel: null,
				readFailCnt: 0,
				circles: new Array(),
				rute: '',
				scaleArray: ['1000km', '500km', '200km', '100km', '50km', '30km', '20km', '10km', '5km', '2km', '1km',
					'500m', '200m', '100m', '50m', '25m', '10m', '5m'
				],
				mapSclae: 18,
				scaleShow: '',
				locateName: '',
				scaleTopType: '',
				labelTopType: '',
				wifiData: '',
				navHeight: 10, // 导航栏高度百分比
				mapHeight: 100, // 地图高度百分比
				mapviz: false,
				marginTopHeight: 0,
				labelMarginTop: 0,
				labelWidth: 0,
				center: {
					la: 39.9096045,
					lo: 116.3972282
				},
				markers: [{
					id: 0,
					latitude: 39.9096045,
					longitude: 116.3972282,
					iconPath: "/static/xixin/owner.png",
					width: 30,
					height: 30
				}],
				communciateType: '',
				characteristicIdwrite: "0000FFE1-0000-1000-8000-00805F9B34FB",
				intervalId: null,
				serviceId: "0000FFE0-0000-1000-8000-00805F9B34FB",
				showLoading: '',
				wifiCount: 0,
				serialCode: '',
				scrollTop: 0,
				freshing: false,
				bluetoothConnect: false,
				blueToothDeviceId: '',
				longitude: '',
				latitude: '',
				showWiFiList: new Array(),
				wifiMacList: new Array(),
				downLoadingWifiList: '',
				lastScanWifiList: new Array(),
				saveWifiList: new Array(),
				checkBluetoothAdapterIntervel: null,
				cnnectCnt: 0,
				bluetoothOpening: true,
				isShowHelp: false,
				scanwificnt: 0,
				clickSureChange: false,
				searchBluetoothIntervel: null,
				screenwidth: 0,
				showFimwareTitle: false,
				showProgressTitle: false,
				getHomeWifiInterval: -70,
				androidTimeout: null,
				isShowGuild: 0
			}
		},
		onHide() {
			clearInterval(this.checkBluetoothAdapterIntervel)
			clearInterval(this.pointerIntervel)
		},
		onBackPress() {
			clearInterval(this.checkBluetoothAdapterIntervel)
			clearInterval(this.pointerIntervel)
			clearInterval(this.searchBluetoothIntervel)
			clearTimeout(this.androidTimeout)
			uni.hideLoading()
		},
		onUnload() {
			console.log('into onunload')
			getApp().globalData.settingWifiBluetooth = false
			uni.hideLoading()
			clearTimeout(this.androidTimeout)
			clearInterval(this.checkBluetoothAdapterIntervel)
			clearInterval(this.pointerIntervel)
			clearInterval(this.searchBluetoothIntervel)
			//#ifdef APP-HARMONY
			$uni.offBluetoothDeviceFound()
			$uni.offBLEConnectionStateChange()
			$uni.offBLECharacteristicValueChange()
			//#endif
			uni.$off("wifiBlueConnect")
			uni.$off("wifiCharacter")
			uni.$off("wifiDevice")
			// if (this.rute != 'set')
			this.stopBluetooth(() => {
				console.log('关闭蓝牙')
			})
		},
		onLoad(paramater) {
			let data = JSON.parse(paramater.paramater)
			console.log('paramater data', data)
			this.rute = data.rute
			this.serialCode = data.serialCode
			this.markers[0].longitude = data.lo
			this.markers[0].latitude = data.la
			// let setlocate = {
			// 	serial_code: this.serialCode,
			// 	continuous_mode: 0
			// }
			// util.requestService(getApp().globalData.locateMode, setlocate);
			if (getApp().globalData.myFirewareVersion < 44) {
				this.showFimwareTitle = true
			}
			this.getPhonePose()
			let wifi_la = data.la
			let wifi_lo = data.lo
			if (data.wifi_la != '') {
				wifi_la = data.wifi_la
				wifi_lo = data.wifi_lo
				let distance = util.getDistance(data.wifi_la, data.wifi_lo, data.la, data.lo)
				console.log('家到我的距离', distance)
				this.mapSclae = this.adjustZoomLevel(distance)
				let maker = {
					id: 1,
					latitude: data.wifi_la,
					longitude: data.wifi_lo,
					iconPath: "/static/xixin/home.png",
					width: 30,
					height: 30
				}
				this.markers.push(maker)
				let cir = [{
					latitude: data.wifi_la, // 圆心纬度
					longitude: data.wifi_lo, // 圆心经度
					strokeWidth: 0.8,
					color: "#d0d0d0", // 圆的颜色
					fillColor: "rgba(0, 170, 255, 0.1)", // 圆的填充颜色
					radius: 30, // 半径，单位为米
				}, ]
				this.circles = cir;
			}
			setTimeout(() => {
				that._mapContext.moveToLocation({
					longitude: wifi_lo,
					latitude: wifi_la,
					success: (res) => {
						// console.log('跳转地图中心点成功');
					},
					fail: (err) => {
						// console.log('跳转地图中心点失败');
					}
				})
			}, 200)
			let screenheight = uni.getSystemInfoSync().screenHeight;
			let screenwidth = uni.getSystemInfoSync().screenWidth;
			this.screenWidth = screenwidth
			var A = Number(screenheight);
			var B = Number(this.navHeight);
			console.log('A B', A, B)
			this.navHeight = A * B / 100;
			this.mapHeight = (A * this.mapHeight) / 100;
			this.marginTopHeight = this.mapHeight * 0.5;
			this.labelMarginTop = this.mapHeight * 0.72;
			console.log('w h', this.navHeight, this.mapHeight)
			this._mapContext = uni.createMapContext("map", this);
			this.labelWidth = {
				width: screenwidth * 0.9 + 'px'
			}

			let that = this
			//需要监听蓝牙连接状态
			this.isShowGuild = uni.getStorageSync("isGuild")
			if (this.isShowGuild === 4)
				this.isShowGuild = 6
			uni.setStorageSync('isGuild', this.isShowGuild)
			try {
				getApp().globalData.settingWifiBluetooth = true
				getApp().globalData.openLadarBluetooth = false;
				//判断下位置有没有打开
				plus.geolocation.getCurrentPosition(function(p) {
					console.log('获取位置权限成功')
					that.restartBluetooth()
				}, function(e) {
					console.log('获取位置权限失败')
					uni.showModal({
						title: '温馨提示',
						content: "请打开定位服务后重新进入界面",
						complete() {
							that.returnParent()
						}
					})
					console.log('检测到没打开定位服务')
					return
				});
				//查询蓝牙连接状态
				uni.$on('wifiBlueConnect', function(res) {
					that.cnnectCnt++
					let intocnt = 1
					if (plus.os.name === 'iOS')
						intocnt = 2
					clearInterval(that.searchBluetoothIntervel)
					if (res.connected && that.cnnectCnt === intocnt) {
						console.log('蓝牙设备已连接');
						that.bluetoothConnect = true
						that.cnnectCnt = 0
						that.showMessage('正在获取数据，请不要离开')
						if (that.blueToothDeviceId === '') {
							console.log('that.blueToothDeviceId === 空')
							that.blueToothDeviceId = getApp().globalData.locateBluetoothId
							console.log('that.blueToothDeviceId', that.blueToothDeviceId)
						}
						if (plus.os.name === 'iOS') {
							that.reFresh(150)
						} else if (plus.os.name === 'Android') {
							clearTimeout(that.androidTimeout)
							that.androidTimeout = setTimeout(() => {
								console.log('that.blueToothDeviceId', that.blueToothDeviceId)
								uni.getBLEDeviceServices({
									deviceId: that.blueToothDeviceId,
									success(res) {
										console.log('device services:', res)
									},
									fail(err) {
										console.log('获取service出错', err)
									}
								})
								uni.getBLEDeviceCharacteristics({
									// 这里的 deviceId 需要已经通过 createBLEConnection 与对应设备建立链接
									deviceId: that.blueToothDeviceId,
									// 这里的 serviceId 需要在 getBLEDeviceServices 接口中获取
									serviceId: "0000FFE0-0000-1000-8000-00805F9B34FB",
									success(res) {
										console.log('device getBLEDeviceCharacteristics:', res
											.characteristics)
										that.reFresh(150)
									},
									fail(err) {
										console.log('获取特征出错', err, that.blueToothDeviceId, that
											.serviceId)
									}
								})
							}, 15000)
						}
						uni.stopBluetoothDevicesDiscovery({
							success(res) {
								console.log('停止蓝牙搜索')
							}
						})

					}
					if (!res.connected && that.cnnectCnt === intocnt) {
						console.log('蓝牙设备已断开')
						// uni.showToast({
						// 	icon: 'none',
						// 	title: '与设备的蓝牙连接断开'
						// })
						that.cnnectCnt = 0
						that.bluetoothConnect = false
					}
				})

				uni.$on('wifiCharacter', function(res) {
					const byteBuffer = new Uint8Array(res.value);
					const hexArr = Array.prototype.map.call(
						new Uint8Array(res.value),
						function(bit) {
							return ('00' + bit.toString(16)).slice(-2)
						}
					)
					console.log('接收成功', hexArr)
					//处理蓝牙反馈
					that.callbackBluetoothData(byteBuffer)
				})
				uni.$on('wifiDevice', function(devices) {
					let id = util.convertToFormat('CYY', that.serialCode); //转到util
					let otaid = util.convertToFormat('OTA', that.serialCode);
					console.log('recive wifi', devices.devices[0].name, id)
					if (devices.devices[0].name === id || devices.devices[0].name === otaid || devices.devices[0]
						.localName === id || devices.devices[0].localName === otaid) {
						that.blueToothDeviceId = devices.devices[0].deviceId;
						console.log('发现目标蓝牙', devices.devices[0].name)
						util.connectBLEDevice(devices.devices[0].deviceId, (err, status) => {
							if (err) {} else if (status === 'alreadyConnected') {

							} else if (status === 'connected') {

							}
						})
					}
				})
				let requestStatueUrl = getApp().globalData.internet + getApp().globalData.getHomeWifiInterval;
				let para = {
					serial_code: this.serialCode
				}
				console.log('requestStatueUrl', requestStatueUrl, para)
				util.requestDataJson(requestStatueUrl, para).then((rebackData2) => {
					// console.log('查询家庭wifiintervel', rebackData2);
					// console.log('rebackData2.statusCode',rebackData2.statusCode)
					// console.log('rebackData2.data.data.rssi_interval',rebackData2.data.data.rssi_interval)
					if (rebackData2.statusCode === 200 && rebackData2.data.data.rssi_interval) {
						this.getHomeWifiInterval = rebackData2.data.data.rssi_interval
						console.log('获取服务器设置家庭wifi intervel成功', this.getHomeWifiInterval)
					}
				})

			} catch (e) {
				console.log('监听蓝牙事件出错', e)
			}
			//扫描连接蓝牙
			switch (uni.getSystemInfoSync().platform) {
				case 'android':
					console.log('运行Android上');
					this.scaleTopType = {
						margin: (this.marginTopHeight - 60).toString() + 'px 0px 0px 0px',
						width: screenwidth + 'px'
					}
					this.labelMarginTop = {
						margin: (this.labelMarginTop).toString() + 'px 0xpx 0px 0px',
						width: screenwidth + 'px'
					}

					break;
				case 'ios':
					console.log('运行iOS上');
					this.scaleTopType = {
						top: (this.marginTopHeight - 60).toString() + 'px',
						width: screenwidth + 'px'
					}
					this.labelMarginTop = {
						top: (this.labelMarginTop).toString() + 'px',
						width: screenwidth + 'px'
					}
				default:
					console.log('运行在开发者工具上');
					break;
					console.log('end onload')
			}
			console.log('finsh onload')
		},
		onShow() {
			//暂时先拿定位器位置
			let that = this
			this.pointerIntervel = setInterval(() => {
				if (this.showWiFiList.length <= 0 && !this.showProgressTitle) {
					// that.showMessage('耗时过长可以尝试从新进入界面')
					if (that.bluetoothConnect === false) {
						//显示蓝牙连接失败给退出
						this.timeLineText = '没有成功连接到蓝牙，请重试。'
					}
					clearInterval(this.checkBluetoothAdapterIntervel)
					// this.stopBluetooth()
					this.showDateLineTitle = true
					uni.hideLoading()
				}
			}, 80000)
			this.cnnectCnt = 0
		},
