/**
 * 删除Preferences键值
 *
 * uni-app项目中（vue/nvue）调用示例：
 * 1、引入方法声明 import { deletePreferencesValue } from "@/uni_modules/jiannor-preference"
 * 2、方法调用
 * deletePreferencesValue({
 *   name: 'myPrefs',
 *   key: 'username',
 *   success: (res) => {
 *      console.log(res)
 *   }
 * });
 * 
 * @uniPlatform {
 *   "app": {
 *     "android": {
 *       "osVer": "5.0",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     },
 *     "ios": {
 *       "osVer": "12.0",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     },
 *     "harmony": {
 *       "osVer": "x",
 *       "uniVer": "x",
 *       "unixVer": "x"
 *     }
 *   }
 * }
 * @uniVersion 4.25
 * @uniVueVersion 2,3
 * @autotest { generated: true }
 */
export const deletePreferencesValue : DeletePreferencesValue = function (options : DeletePreferencesValueOptions) {
	// 参数校验
	if (options.name == null || options.name.length == 0) {
		const error = new PreferencesFailImpl(9010006);
		options.fail?.(error);
		options.complete?.(error);
		return;
	}

	if (options.key == null || options.key.length == 0) {
		const error = new PreferencesFailImpl(9010006);
		options.fail?.(error);
		options.complete?.(error);
		return;
	}

	try {
		// 获取UserDefaults实例
		const userDefaults = getUserDefaults(options.name);

		// 删除键值
		userDefaults.removeObject(forKey = options.key);
		userDefaults.synchronize();

		const result : DeletePreferencesValueResult = {
			success: true
		};
		options.success?.(result);
		options.complete?.(result);
	} catch (error) {
		console.error(`Failed to delete preferences value. Error:${error}`);
		const err = new PreferencesFailImpl(9010006);
		options.fail?.(err);
		options.complete?.(err);
	}
}

