/**
 * interface.uts
 * 蓝牙适配器插件接口定义文件
 */

// 通用回调参数
export type CommonCallbackResult = {
	errMsg : string
}

// 错误码定义
export type BluetoothErrorCode = 0 | -1 | 10000 | 10001 | 10002 | 10003 | 10004 | 10005 | 10006 | 10007 | 10008 | 10009 | 10010 | 10011 | 10012 | 10013;

// 蓝牙错误回调参数
export interface BluetoothFail extends IUniError {
	errCode : BluetoothErrorCode
}

// 初始化蓝牙适配器参数
export type OpenBluetoothAdapterOptions = {
	success ?: (res : CommonCallbackResult) => void
	fail ?: (res : BluetoothFail) => void
	complete ?: (res : any) => void
}

// 关闭蓝牙适配器参数
export type CloseBluetoothAdapterOptions = {
	success ?: (res : CommonCallbackResult) => void
	fail ?: (res : BluetoothFail) => void
	complete ?: (res : any) => void
}

export type KeepScreenOnOptions = {
	keepScreenOn ?: boolean
	success ?: (res : CommonCallbackResult) => void
	fail ?: (res : any) => void
	complete ?: (res : any) => void
}

// 获取蓝牙适配器状态参数
export type GetBluetoothAdapterStateOptions = {
	success ?: (res : GetBluetoothAdapterStateResult) => void
	fail ?: (res : BluetoothFail) => void
	complete ?: (res : any) => void
}

// 获取蓝牙适配器状态结果
export type GetBluetoothAdapterStateResult = {
	available : boolean
	discovering : boolean
	errMsg : string
}

// 开始搜索蓝牙设备参数
export type StartBluetoothDevicesDiscoveryOptions = {
	services ?: Array<string>
	allowDuplicatesKey ?: boolean
	interval ?: number
	powerLevel ?: string
	success ?: (res : CommonCallbackResult) => void
	fail ?: (res : BluetoothFail) => void
	complete ?: (res : any) => void
}

// 停止搜索蓝牙设备参数
export type StopBluetoothDevicesDiscoveryOptions = {
	success ?: (res : CommonCallbackResult) => void
	fail ?: (res : BluetoothFail) => void
	complete ?: (res : any) => void
}

// 蓝牙设备信息
export type BluetoothDevice = {
	name : string
	deviceId : string
	RSSI : number
	advertisData : ArrayBuffer
	advertisServiceUUIDs : Array<string>
	localName : string
	serviceData : any
}

// 蓝牙设备信息别名（用于设备发现事件）
export type BluetoothDeviceInfo = BluetoothDevice

// 获取已发现的蓝牙设备参数
export type GetBluetoothDevicesOptions = {
	success ?: (res : GetBluetoothDevicesResult) => void
	fail ?: (res : BluetoothFail) => void
	complete ?: (res : any) => void
}

// 获取已发现的蓝牙设备结果
export type GetBluetoothDevicesResult = {
	devices : Array<BluetoothDevice>
	errMsg : string
}

// 连接低功耗蓝牙设备参数
export type CreateBLEConnectionOptions = {
	deviceId : string
	timeout ?: number
	success ?: (res : CommonCallbackResult) => void
	fail ?: (res : BluetoothFail) => void
	complete ?: (res : any) => void
}

// 断开低功耗蓝牙设备连接参数
export type CloseBLEConnectionOptions = {
	deviceId : string
	success ?: (res : CommonCallbackResult) => void
	fail ?: (res : BluetoothFail) => void
	complete ?: (res : any) => void
}

// 断开低功耗蓝牙设备连接成功结果
export type CloseBLEConnectionSuccess = {
	errMsg : string
}

// 获取蓝牙设备服务参数
export type GetBLEDeviceServicesOptions = {
	deviceId : string
	success ?: (res : GetBLEDeviceServicesSuccess) => void
	fail ?: (res : BluetoothFail) => void
	complete ?: (res : any) => void
}

// 获取蓝牙设备服务成功结果
export type GetBLEDeviceServicesSuccess = {
	services : Array<BLEService>
	errMsg : string
}

// 蓝牙服务信息
export type BLEService = {
	uuid : string
	isPrimary : boolean
}

// 获取蓝牙设备服务结果
export type GetBLEDeviceServicesResult = {
	services : Array<BLEService>
	errMsg : string
}

// 获取蓝牙设备特征值参数
export type GetBLEDeviceCharacteristicsOptions = {
	deviceId : string
	serviceId : string
	success ?: (res : GetBLEDeviceCharacteristicsResult) => void
	fail ?: (res : BluetoothFail) => void
	complete ?: (res : any) => void
}

// 蓝牙特征值属性
export type BLECharacteristicProperties = {
	read : boolean
	write : boolean
	notify : boolean
	indicate : boolean
	writeNoResponse : boolean
}

// 蓝牙特征值信息
export type BLECharacteristic = {
	uuid : string
	properties : BLECharacteristicProperties
}

// 获取蓝牙设备特征值结果
export type GetBLEDeviceCharacteristicsResult = {
	serviceUUID : string
	characteristics : Array<BLECharacteristic>
	errMsg : string
}

// 读取低功耗蓝牙设备特征值参数
export type ReadBLECharacteristicValueOptions = {
	deviceId : string
	serviceId : string
	characteristicId : string
	success ?: (res : CommonCallbackResult) => void
	fail ?: (res : BluetoothFail) => void
	complete ?: (res : any) => void
}

// 写入低功耗蓝牙设备特征值参数
export type WriteBLECharacteristicValueOptions = {
	deviceId : string
	serviceId : string
	characteristicId : string
	value : ArrayBuffer
	writeType ?: string
	success ?: (res : WriteBLECharacteristicValueSuccess) => void
	fail ?: (res : BluetoothFail) => void
	complete ?: (res : any) => void
}

// 写入低功耗蓝牙设备特征值成功回调类型
export type WriteBLECharacteristicValueSuccess = {
	errMsg : string
}

// 启用低功耗蓝牙设备特征值变化通知参数
export type NotifyBLECharacteristicValueChangeOptions = {
	deviceId : string
	serviceId : string
	characteristicId : string
	state : boolean
	success ?: (res : NotifyBLECharacteristicValueChangeSuccess) => void
	fail ?: (res : BluetoothFail) => void
	complete ?: (res : any) => void
}

// 启用低功耗蓝牙设备特征值变化通知成功回调类型
export type NotifyBLECharacteristicValueChangeSuccess = {
	errMsg : string
}

// 设置蓝牙最大传输单元参数
export type SetBLEMTUOptions = {
	deviceId : string
	mtu : number
	success ?: (res : SetBLEMTUSuccess) => void
	fail ?: (res : BluetoothFail) => void
	complete ?: (res : any) => void
}

// 设置蓝牙最大传输单元成功回调类型
export type SetBLEMTUSuccess = {
	mtu : number
	errMsg : string
}

// 设置蓝牙最大传输单元结果类型
export type SetBLEMTUResult = {
	mtu : number
	errMsg : string
}

// 函数类型定义
export type OpenBluetoothAdapter = (options ?: OpenBluetoothAdapterOptions) => void
export type CloseBluetoothAdapter = (options ?: CloseBluetoothAdapterOptions) => void
export type GetBluetoothAdapterState = (options ?: GetBluetoothAdapterStateOptions) => void
export type StartBluetoothDevicesDiscovery = (options ?: StartBluetoothDevicesDiscoveryOptions) => void
export type StopBluetoothDevicesDiscovery = (options ?: StopBluetoothDevicesDiscoveryOptions) => void
export type GetBluetoothDevices = (options ?: GetBluetoothDevicesOptions) => void
export type CreateBLEConnection = (options : CreateBLEConnectionOptions) => void
export type CloseBLEConnection = (options : CloseBLEConnectionOptions) => void
export type GetBLEDeviceServices = (options : GetBLEDeviceServicesOptions) => void
export type GetBLEDeviceCharacteristics = (options : GetBLEDeviceCharacteristicsOptions) => void
export type ReadBLECharacteristicValue = (options : ReadBLECharacteristicValueOptions) => void
export type WriteBLECharacteristicValue = (options : WriteBLECharacteristicValueOptions) => void
export type NotifyBLECharacteristicValueChange = (options : NotifyBLECharacteristicValueChangeOptions) => void
export type SetBLEMTU = (options : SetBLEMTUOptions) => void
export type SetKeepScreenOn = (options : KeepScreenOnOptions) => void

// 事件监听器相关类型定义
// BLE连接状态变化事件数据
export type OnBLEConnectionStateChangeCallbackResult = {
	deviceId : string
	connected : boolean
}

// BLE特征值变化事件数据
export type OnBLECharacteristicValueChangeCallbackResult = {
	deviceId : string
	serviceId : string
	characteristicId : string
	value : ArrayBuffer
}

// 蓝牙设备发现事件数据
export type OnBluetoothDeviceFoundCallbackResult = {
	devices : Array<BluetoothDeviceInfo>
}

// 蓝牙适配器状态变化事件数据
export type OnBluetoothAdapterStateChangeCallbackResult = {
	available : boolean
	discovering : boolean
}

// 事件监听器函数类型
export type OnBluetoothDeviceFoundCallback = (result : OnBluetoothDeviceFoundCallbackResult) => void
export type OnBLEConnectionStateChangeCallback = (result : OnBLEConnectionStateChangeCallbackResult) => void
export type OnBLECharacteristicValueChangeCallback = (result : OnBLECharacteristicValueChangeCallbackResult) => void
export type OnBluetoothAdapterStateChangeCallback = (result : OnBluetoothAdapterStateChangeCallbackResult) => void

export type OnBluetoothDeviceFound = (callback : OnBluetoothDeviceFoundCallback) => void
export type OnBLEConnectionStateChange = (callback : OnBLEConnectionStateChangeCallback) => void
export type OnBLECharacteristicValueChange = (callback : OnBLECharacteristicValueChangeCallback) => void
export type OnBluetoothAdapterStateChange = (callback : OnBluetoothAdapterStateChangeCallback) => void
export type OffBluetoothDeviceFound = (callback ?: OnBluetoothDeviceFoundCallback) => void
export type OffBLEConnectionStateChange = (callback ?: OnBLEConnectionStateChangeCallback) => void
export type OffBLECharacteristicValueChange = (callback ?: OnBLECharacteristicValueChangeCallback) => void
export type OffBluetoothAdapterStateChange = (callback ?: OnBluetoothAdapterStateChangeCallback) => void

// 检查蓝牙权限参数
export type CheckBluetoothPermissionOptions = {
	success ?: (res : CheckBluetoothPermissionResult) => void
	fail ?: (res : BluetoothFail) => void
	complete ?: (res : any) => void
}

// 蓝牙权限状态
export type BluetoothPermissionState = {
	authorized : boolean
	denied : boolean
}

// 位置权限状态
export type LocationPermissionState = {
	authorized : boolean
	denied : boolean
}

// 检查蓝牙权限结果
export type CheckBluetoothPermissionResult = {
	authorizationStatus : string
	bluetooth ?: BluetoothPermissionState
	location ?: LocationPermissionState
	granted ?: boolean  // 保持向后兼容
	errMsg : string
}

// 检查蓝牙权限成功回调类型
export type CheckBluetoothPermissionSuccess = CheckBluetoothPermissionResult

export enum CheckBluetoothPermissionReturn {
	ERROR = 'ERROR',
	GET = 'GET',
	NO_GET = 'NO_GET'
}

// 复数形式的权限类型定义（用于兼容）
export type CheckBluetoothPermissionsOptions = CheckBluetoothPermissionOptions
export type CheckBluetoothPermissionsResult = CheckBluetoothPermissionResult
export type CheckBluetoothPermissions = CheckBluetoothPermission

// 申请蓝牙权限参数
export type RequestBluetoothPermissionOptions = {
	success ?: (res : RequestBluetoothPermissionResult) => void
	fail ?: (res : BluetoothFail) => void
	complete ?: (res : any) => void
}

// 申请蓝牙权限结果
export type RequestBluetoothPermissionResult = {
	authorizationStatus : string
	bluetooth ?: BluetoothPermissionState
	location ?: LocationPermissionState
	granted ?: boolean  // 保持向后兼容
	errMsg : string
}

// 申请蓝牙权限成功回调类型
export type RequestBluetoothPermissionSuccess = RequestBluetoothPermissionResult

export enum RequestBluetoothPermissionReturn {
	ACCEPT = 'ACCEPT',
	REFUSE = 'REFUSE',
	ERROR = 'ERROR'
}

// 复数形式的申请权限类型定义（用于兼容）
export type RequestBluetoothPermissionsOptions = RequestBluetoothPermissionOptions
export type RequestBluetoothPermissionsResult = RequestBluetoothPermissionResult
export type RequestBluetoothPermissions = RequestBluetoothPermission

// 检查蓝牙权限函数类型
export type CheckBluetoothPermission = (options : CheckBluetoothPermissionOptions) => void
export type CheckBluetoothPermissionSync = () => CheckBluetoothPermissionResult
// 申请蓝牙权限函数类型
export type RequestBluetoothPermission = (options : RequestBluetoothPermissionOptions) => void

// 开启系统蓝牙开关参数
export type EnableBluetoothOptions = {
	success ?: (res : EnableBluetoothResult) => void
	fail ?: (res : BluetoothFail) => void
	complete ?: (res : any) => void
}

// 开启系统蓝牙开关结果
export type EnableBluetoothResult = {
	enabled ?: boolean
	errMsg : string
}

// 开启系统蓝牙开关成功回调类型
export type EnableBluetoothSuccess = EnableBluetoothResult

export enum EnableBluetoothReturn {
	SUCCESS = 'SUCCESS',
	FAILED = 'FAILED',
	ALREADY_ENABLED = 'ALREADY_ENABLED',
	ERROR = 'ERROR'
}

// 开启系统蓝牙开关函数类型
export type EnableBluetooth = (options : EnableBluetoothOptions) => void

// 监听寻找到新设备的事件的成功回调结果
export type OnBluetoothDeviceFoundListenerResult = {
	/**
	 * 新搜索到的设备列表
	 */
	devices : BluetoothDevice[]
}

// 监听蓝牙适配器状态变化事件的成功回调结果
export type OnBluetoothAdapterStateChangeListenerResult = {
	/**
	 * 蓝牙适配器是否可用
	 */
	available : boolean
	/**
	 * 是否正在搜索设备
	 */
	discovering : boolean
}

// 监听低功耗蓝牙连接状态的改变事件的成功回调结果
export type OnBLEConnectionStateChangeListenerResult = {
	/**
	 * 蓝牙设备 id
	 */
	deviceId : string
	/**
	 * 是否处于已连接状态
	 */
	connected : boolean
}

// 监听低功耗蓝牙设备的特征值变化事件的成功回调结果
export type OnBLECharacteristicValueChangeListenerResult = {
	/**
	 * 蓝牙设备 id
	 */
	deviceId : string
	/**
	 * 蓝牙特征值对应服务的 uuid
	 */
	serviceId : string
	/**
	 * 蓝牙特征值的 uuid
	 */
	characteristicId : string
	/**
	 * 特征值最新的值
	 */
	value : ArrayBuffer
}

// 读取低功耗蓝牙设备的特征值的成功回调结果
export type ReadBLECharacteristicValueSuccess = {
	/**
	 * 蓝牙特征值信息
	 */
	characteristic : BLECharacteristic
}

// 根据 service UUID 获取处于已连接状态的设备
export type GetConnectedBluetoothDevicesOptions = {
	/**
	 * 蓝牙设备主 service 的 uuid 列表
	 */
	services : string[]
	/**
	 * 成功则返回本机蓝牙适配器状态
	 */
	success ?: (res : GetConnectedBluetoothDevicesSuccess) => void
	/**
	 * 失败则返回错误码
	 */
	fail ?: (res : BluetoothFail) => void
	/**
	 * 接口调用结束的回调函数（调用成功、失败都会执行）
	 */
	complete ?: (res : any) => void
}

// 根据 service UUID 获取处于已连接状态的设备的成功回调结果
export type GetConnectedBluetoothDevicesSuccess = {
	/**
	 * 设备列表
	 */
	devices : BluetoothDevice[]
}

// 获取当前的地理位置参数
export type GetLocationOptions = {
	/**
	 * 定位类型，可选值：wgs84（GPS坐标），gcj02（国测局坐标）
	 */
	type ?: string
	/**
	 * 传入 true 会返回高度信息，由于获取高度需要较高精确度，会减慢接口返回速度
	 */
	altitude ?: boolean
	/**
	 * 高精度定位超时时间(ms)，指定时间内返回最高精度，该值3000ms以上高精度定位才有效果
	 */
	highAccuracyExpireTime ?: number
	/**
	 * 开启高精度定位
	 */
	isHighAccuracy ?: boolean
	/**
	 * 成功回调
	 */
	success ?: (res : GetLocationSuccess) => void
	/**
	 * 失败回调
	 */
	fail ?: (res : any) => void
	/**
	 * 完成回调
	 */
	complete ?: (res : any) => void
}

// 获取当前的地理位置成功回调结果
export type GetLocationSuccess = {
	/**
	 * 纬度，范围为 -90~90，负数表示南纬
	 */
	latitude : number
	/**
	 * 经度，范围为 -180~180，负数表示西经
	 */
	longitude : number
	/**
	 * 速度，单位 m/s
	 */
	speed : number
	/**
	 * 位置的精确度
	 */
	accuracy : number
	/**
	 * 高度，单位 m
	 */
	altitude ?: number
	/**
	 * 垂直精度，单位 m（Android 无法获取，返回 0）
	 */
	verticalAccuracy ?: number
	/**
	 * 水平精度，单位 m
	 */
	horizontalAccuracy ?: number
	/**
	 * 调用结果
	 */
	errMsg : string
}

// 获取当前的地理位置函数类型
export type GetLocation = (options : GetLocationOptions) => void

export type SetBadgeNumberOptions = {
	badgeNumber : number,
	/**
	 * 成功回调
	 */
	success ?: (res : SetBadgeNumberSuccess) => void
	/**
	 * 失败回调
	 */
	fail ?: (res : CommonCallbackResult) => void
	/**
	 * 完成回调
	 */
	complete ?: (res : any) => void
}

export type SetBadgeNumberSuccess = {
	errMsg : string
}
export type SetBadgeNumber = (options : SetBadgeNumberOptions) => void



// 获取应用ID参数
export type GetAppIdOptions = {
	/**
	 * 成功回调
	 */
	success ?: (res : GetAppIdSuccess) => void
	/**
	 * 失败回调
	 */
	fail ?: (res : any) => void
	/**
	 * 完成回调
	 */
	complete ?: (res : any) => void
}

// 获取应用ID成功回调结果
export type GetAppIdSuccess = {
	/**
	 * 应用ID
	 */
	appId : string
	/**
	 * 调用结果
	 */
	errMsg : string
}

// 获取应用ID函数类型
export type GetAppId = (options : GetAppIdOptions) => void

// ============ 位置变化监听相关接口定义 ============

// 位置变化回调结果
export type OnLocationChangeCallbackResult = {
	/**
	 * 纬度，范围为 -90~90，负数表示南纬
	 */
	latitude : number
	/**
	 * 经度，范围为 -180~180，负数表示西经
	 */
	longitude : number
	/**
	 * 速度 (m/s)
	 */
	speed : number
	/**
	 * 位置的精确度
	 */
	accuracy : number
	/**
	 * 高度 (m)
	 */
	altitude ?: number
	/**
	 * 垂直精度 (m)
	 */
	verticalAccuracy ?: number
	/**
	 * 水平精度 (m)
	 */
	horizontalAccuracy ?: number
	/**
	 * 定位到的城市信息
	 */
	city ?: string
	/**
	 * 城市编码
	 */
	cityCode ?: string
	/**
	 * 街道名称
	 */
	street ?: string
	/**
	 * 国家
	 */
	country ?: string
	/**
	 * 国家代码
	 */
	countryCode ?: string
	/**
	 * 省份
	 */
	province ?: string
	/**
	 * 街道号码
	 */
	streetNumber ?: string
	/**
	 * 区
	 */
	district ?: string
	/**
	 * 是不是精确定位信息
	 */
	isFullAccuracy ?: boolean
	/**
	 * 海拔的精确度信息
	 */
	altitudeAccuracy ?: number
}

// 位置变化错误回调结果
export type OnLocationChangeErrorCallbackResult = {
	/**
	 * 错误码
	 */
	errCode : number
	/**
	 * 错误信息
	 */
	errMsg : string
}

// 开始位置更新参数
export type StartLocationUpdateOptions = {
	/**
	 * 定位类型，可选值：wgs84（GPS坐标），gcj02（国测局坐标）
	 */
	type ?: string
	/**
	 * 成功回调
	 */
	success ?: (res : CommonCallbackResult) => void
	/**
	 * 失败回调
	 */
	fail ?: (res : any) => void
	/**
	 * 完成回调
	 */
	complete ?: (res : any) => void
}

// 停止位置更新参数
export type StopLocationUpdateOptions = {
	/**
	 * 成功回调
	 */
	success ?: (res : CommonCallbackResult) => void
	/**
	 * 失败回调
	 */
	fail ?: (res : any) => void
	/**
	 * 完成回调
	 */
	complete ?: (res : any) => void
}

// 位置变化监听器函数类型
export type OnLocationChangeCallback = (result : OnLocationChangeCallbackResult) => void
export type OnLocationChangeErrorCallback = (result : OnLocationChangeErrorCallbackResult) => void

// 位置变化监听函数类型
export type OnLocationChange = (callback : OnLocationChangeCallback) => void
export type OffLocationChange = (callback ?: OnLocationChangeCallback) => void
export type OnLocationChangeError = (callback : OnLocationChangeErrorCallback) => void
export type OffLocationChangeError = (callback ?: OnLocationChangeErrorCallback) => void
export type StartLocationUpdate = (options : StartLocationUpdateOptions) => void
export type StopLocationUpdate = (options : StopLocationUpdateOptions) => void

// ============ 应用路径获取相关接口定义 ============

// 应用沙盒路径信息
export type AppPathInfo = {
	/**
	 * 应用数据目录
	 */
	filesDir : string | null
	/**
	 * 应用缓存目录
	 */
	cacheDir : string | null
	/**
	 * 应用临时目录
	 */
	tempDir : string | null
	/**
	 * 应用数据库目录
	 */
	databaseDir : string | null
	/**
	 * 应用首选项目录
	 */
	preferencesDir : string | null
	/**
	 * 应用分布式文件目录
	 */
	distributedFilesDir : string | null
	/**
	 * 应用包代码目录
	 */
	bundleCodeDir : string | null
}

// 获取应用路径函数类型
export type GetAppPath = () => Promise<AppPathInfo>
export type GetSpecificPath = (pathType : 'files' | 'cache' | 'temp' | 'database' | 'preferences' | 'distributedFiles' | 'bundleCode') => Promise<string | null>
export type CheckPathExists = (path : string) => Promise<boolean>