				locateTime: -1,
				lastLocateTime: '',
				leadOutCnt: 0,
				testcnt: 0,
				checkBluetoothAdapterIntervel: null,
				showWifiPoint: false,
				showHaveDevice: false,
				DeviceConnectModol: 0,
				blueToothHeartCnt: 0,
				positionSignal: "GPS信号弱",
				deviceOffline: "",
				locType: '',
				homeWifi: null,
				isShowGuild: 8,
				guildImageClickCnt: 1,
				dogulas_peuker_distance: 20,
				platform: true,
				cnnectCnt: 0,
				startDiscover: null,
				let_right_bottom: 200,
				refreshTime: 0,
				firmwareVersion: -1,
				isCharge:false
			}
		},
		onReady() {

		},
		onUnload() {
			console.log('页面卸载触发')
			this.cleanupResources();
		},
		onShow() {
			console.log('into onshow')
			this.pageStatues = 1;
			// 初始化数据
			var obj = getApp().globalData.lacatePageData;
			console.log('进入地图哦那show加载数据', obj)
			this.loadobject = obj;

			if (getApp().globalData.presentDevice === null) {
				this.initData();
				this.showHaveDevice = true;
				return;
			} else {
				this.loadPageData();
				this.showHaveDevice = false;
			}
			if (this.loadobject.avatar && this.loadobject.avatar.substring(0, 6) === "static") {
				this.loadobject.avatar = getApp().globalData.internetDownload + '/' + this.loadobject.avatar;
			}

			this.unpdataUserPosition = false;
			this.myHardwareVersion = getApp().globalData.myHardwareVersion;
			this.batteryMode = getApp().globalData.batteryShowMode;

			// 地图图层
			this.enableSatellite = getApp().globalData.mapShowMode;
			this.mapNumber = this.enableSatellite ? 'GS (2023)4047号' : 'GS (2023)551号';

			getApp().globalData.openLadarBluetooth = true;
			this.loacateMode = 1;

			// this.getDeviceConnectModol();

			// 检查设备状态
			// let requestStatueUrl = getApp().globalData.internet + getApp().globalData.checkConnectStatue;
			// let para = {
			// 	serial_code: this.loadobject.serialCode
			// };
			// util.requestDataJson(requestStatueUrl, para).then((rebackData2) => {
			// 	console.log('查询设备是否离线', rebackData2);
			// 	if (rebackData2.statusCode === 200) {
			// 		this.deviceOffline = "";
			// 		if (rebackData2.data.data.connect_state != 1) {
			// 			this.deviceOffline = "设备离线";
			// 		}
			// 	}
			// });
			// 启动定时任务
			this.startIntervalTasks();

			// 监听位置变化
			this.widcnt = -1;


			if (plus.os.name === 'iOS')
				this.startLocationUpdate()
			else
				this.startLocationWatch();
			clearInterval(this.intervaldoBgTask);
			uni.setKeepScreenOn({
				keepScreenOn: true
			});

			// 监听事件
			this.setupEventListeners();

			// 启动蓝牙
			// if (this.isShowGuild === 8) {
			// this.reconnectAttempts = 0;
			// this.restartBlueToothWithRetry();
			this.restartBlueTooth(true)

			// }
		},
		mounted() {
			this.checkPermission();
		},
		onHide() {
			console.log("触发 locate onhide");
			this.pageStatues = 0
			this.showWifiPoint = false
			this.cleanupTimers();
			if (!this.showHaveDevice) {
				this.savePage();
			}
			this.stopBluetoothOperations();
		},
		onBackPress() {
			console.log('into onbackpress');
			this.pageStatues = 0;
			this.cleanupTimers();
			this.savePage();
			return false;
		},
		computed: {
			topBarData() {
				return {
					mapNumber: this.mapNumber,
					firmwareVersion: this.firmwareVersion,
					DeviceConnectModol: this.DeviceConnectModol,
					deviceConnectModolStatue: this.deviceConnectModolStatue,
					dots: this.dots,
					loadobject: this.loadobject,
					locType: this.locType,
					bluetoothConnect: this.bluetoothConnect,
					batteryMode: this.batteryMode,
					lastLocateTime: this.lastLocateTime,
					locateTime: this.locateTime,
					deviceOffline: this.deviceOffline,
					loacateClock: this.loacateClock,
					serviceLocateMode: this.serviceLocateMode,
					positionSignal: this.positionSignal,
					infoData: this.locateInfoData,
					isCharge:this.isCharge
				};
			},
			signalBarStyle() {
				return {
					width: `${this.signalStrength}%`,
				};
			},
		},
		onLoad(options) {
			console.log('into onload');
			getApp().globalData.blebluetoothConnect = false;
			this.platform = plus.os.name;
			let that = this;
			this.WindowInfo = uni.getWindowInfo();
			this.screenheight = this.WindowInfo.screenHeight;
			this.screenwidth = this.WindowInfo.windowWidth;
			let windowHeight = this.WindowInfo.windowHeight;
			this.mapHeight = windowHeight;
			this.marginTopHeight = this.mapHeight;
			// 初始化闪烁点
			this.blinkInterval = setInterval(() => {
				this.dotCount = (this.dotCount + 1) % 4;
				this.dots = '...'.substring(0, this.dotCount);
			}, 500);

			// 创建地图上下文
			this._mapContext = uni.createMapContext('map', this);

			// 加载页面数据
			var obj = getApp().globalData.lacatePageData;
			this.loadobject = obj;
			if (this.loadobject != null && this.loadobject.data != null && this.loadobject != '') {
				let data = this.loadobject.data;
				try {
					this.remind = data.remind;
					this.latitude = data.latitude;
					this.longitude = data.longitude;
					this.outinside = data.outinside;
					this.margintop = data.margintop;
					this.drawRange = data.drawRange;
					this.leadTime = data.leadTime;
					this.signalStrength = data.signalStrength;
					this.stopLadarToast = data.stopLadarToast;
					this.ladarToast = data.ladarToast;
					this.ladaring = data.ladaring;
					this.drawToast = data.drawToast;
					this.railToast = data.railToast;
					this.railing = data.railing;
					this.leading = data.leading;
					this.mapScale = data.mapScale;
					this.petDistanceOver = data.petDistanceOver;
					this.petDistance = data.petDistance;
					this.leadUrl = data.leadUrl;
					this.railUrl = data.railUrl;
					this.ladarUrl = data.ladarUrl;
					this.markers = data.markers;
					this.polygonsPoints = data.polygonsPoints;
					this.localSavePolygons = data.localSavePolygons;
					this.actionPolygonIndex = data.actionPolygonIndex;
					this.polygons = data.polygons;
					this.circles = data.circles;
					this.blueToothDeviceId = data.blueToothDeviceId;
					// this.getPetPositionNew(this.loadobject, false, false);
					this.getWorkModeNew(this.loadobject.serialCode)
				} catch (e) {
					console.log('获取页面缓存出错', e);
				}
			}

			this.setStyle();
			this.setupBluetoothListeners();

			this.isShowGuild = uni.getStorageSync("isGuild");
			getApp().globalData.mapShowMode = uni.getStorageSync('mapShowMode');
			if (getApp().globalData.mapShowMode === '') {
				getApp().globalData.mapShowMode = false;
			}
			// uni.$on('app-logout-cleanup',()=>{
			// 	console.log('退出登陆触发卸载页面')
			// 	this.cleanupResources()
			// });
		},
		beforeDestroy() {
			uni.offCompassChange(this.initCompass);
			this.removeBluetoothListeners();
		},
		methods: {
			/**
			 * 设置蓝牙监听器
			 */
			setupBluetoothListeners() {
				uni.$on('BluetoothAdapterStateChange', (res) => {
					console.log('蓝牙适配器状态变化:', res);
					if (this.bluetoothAdapterAvailable != res.state) {
						this.bluetoothAdapterAvailable = res.state;
						if (this.bluetoothAdapterAvailable === 2) {
							console.log('蓝牙适配器可用');
							this.handleBluetoothEnabled();
						} else {
							console.log('蓝牙适配器不可用');
							this.handleBluetoothDisabled();
						}
					}

				})
				// 监听蓝牙连接状态变化
				uni.$on('ladarConnect', (res) => {
					console.log('触发ladarConnect', res);
					this.cnnectCnt++;
					let intocnt = 1;
					// if (plus.os.name === 'iOS') {
					// 	intocnt = 2;
					// }
					console.log('触发次数',this.cnnectCnt)
					if (res.connected && this.cnnectCnt === intocnt) {
						this.cnnectCnt = 0;
						console.log('蓝牙设备已连接');
						this.RSSIText = '信号值越大越近定位器';
						this.dotCount = 1;
						this.dots = '';
						this.bluetoothConnect = true;
						getApp().globalData.blebluetoothConnect = true;
						getApp().globalData.locateAndWifisetStatue = '';
					} else if (!res.connected && this.cnnectCnt === intocnt) {
						this.cnnectCnt = 0;
						console.log('蓝牙设备已断开');
						this.RSSIText = '蓝牙连接断开';
						this.RSSI = 0;
						this.bluetoothConnect = false;
						getApp().globalData.blebluetoothConnect = false;
						if (this.pageStatues === 1)
							this.restartBlueTooth(true)
					}
				});
				// 监听发现设备
				uni.$on('ladarDevice', (devices) => {
					let id = this.convertToFormat('CYY', this.loadobject.serialCode);
					let otaid = this.convertToFormat('OTA', this.loadobject.serialCode);
					// console.log('发现蓝牙新设备',devices.devices)
					if (devices.devices && devices.devices.length > 0) {
						let targetDevice = devices.devices.find(device =>
							device.name === id ||
							device.name === otaid ||
							device.localName === id ||
							device.localName === otaid
						);

						if (targetDevice) {
							this.blueToothDeviceId = targetDevice.deviceId;
							getApp().globalData.locateBluetoothId = targetDevice.deviceId;
							getApp().globalData.locateAndWifisetStatue = '蓝牙连接中...';
							console.log('发现目标蓝牙', devices.devices);
							//如果是猫版就不用连接了 一直扫描，扫描到就认为连接
							//增加位置上传后 扫描到wifi直接上传手机位置
							// if (this.loadobject.serialCode.substring(0, 2) === 'ae') {
							// 	//猫版扫描到就认为连接,30秒没更新就断开
							// 	this.bluetoothConnect = true
							// 	this.catScanTimer = Date.now();
							// } else {
								//1.5和se
								this.connectAndLocate(targetDevice.deviceId);
								uni.stopBluetoothDevicesDiscovery({});
							// }
						}
					}
				});
			},

			/**
			 * 移除蓝牙监听器
			 */
			removeBluetoothListeners() {
				uni.$off('ladarConnect');
				uni.$off('ladarDevice');
				// uni.offBluetoothAdapterStateChange(); 会报错
			},

			/**
			 * 处理蓝牙被禁用
			 */
			handleBluetoothDisabled() {
				this.bluetoothConnect = false;
				getApp().globalData.blebluetoothConnect = false;
				this.RSSIText = '蓝牙未开启';
				this.RSSI = 0;

				// 清除重连定时器
				if (this.reconnectTimer) {
					clearTimeout(this.reconnectTimer);
					this.reconnectTimer = null;
				}

				// 停止蓝牙操作
				this.stopBluetoothOperations();
			},

			/**
			 * 处理蓝牙被启用
			 */
			handleBluetoothEnabled() {
				console.log('蓝牙被重新启用，开始重新连接');
				this.reconnectAttempts = 0;
				this.isReconnecting = false;

				// 延迟一会儿再重新启动蓝牙，确保适配器完全就绪
				setTimeout(() => {
					this.restartBlueTooth(true)
				}, 1000);
			},
			/**
			 * 重启蓝牙
			 */
			restartBlueTooth(isshow) {
				return new Promise((resolve, reject) => {
					let that = this;
					// 先关闭蓝牙适配器，确保状态清理
					uni.closeBluetoothAdapter({
						success: () => {
							console.log('关闭蓝牙适配器成功');
							// 延迟确保完全关闭
							setTimeout(() => {
								that.retryOpenBluetoothAdapter(isshow, resolve, reject);
							}, 800);
						},
						fail: (err) => {
							console.log('关闭蓝牙适配器失败，可能已经关闭', err);
							//把蓝牙适配器状态置为false
							// 即使关闭失败也继续尝试打开
							setTimeout(() => {
								that.retryOpenBluetoothAdapter(isshow, resolve, reject);
							}, 800);
						}
					});
				});
			},
			stopBluetoothOperations() {
				// 停止设备发现
				this.tryConnectBluetooth=false
				uni.stopBluetoothDevicesDiscovery({
					success: (res) => {
						console.log('停止蓝牙设备搜索成功');
					},
					fail: (err) => {
						console.log('停止蓝牙设备搜索失败:', err);
					}
				});

				// 如果有连接，关闭连接
				if (this.blueToothDeviceId && this.bluetoothConnect) {
					uni.closeBLEConnection({
						deviceId: this.blueToothDeviceId,
						success: () => {
							console.log('关闭蓝牙连接成功');
						},
						fail: (err) => {
							console.log('关闭蓝牙连接失败:', err);
						},
						complete: (res) => {
							this.bluetoothConnect = false;
							getApp().globalData.blebluetoothConnect = false;
						}
					});
				} else {
					console.log('蓝牙连接异常', this.blueToothDeviceId, this.bluetoothConnect)
					// this.bluetoothConnect=false
				}
			},
			/**
			 * 显示蓝牙权限引导
			 */
			showBluetoothPermissionGuide() {
				uni.showModal({
					title: '蓝牙权限提示',
					content: '需要蓝牙权限才能连接设备，请前往设置开启权限',
					confirmText: '去设置',
					success: (res) => {
						if (res.confirm) {
							// 打开应用设置页面
							uni.openSetting({
								success: (res) => {
									console.log('打开设置成功:', res);
								},
								fail: (err) => {
									console.log('打开设置失败:', err);
								}
							});
						}
					}
				});
			},
			retryOpenBluetoothAdapter(isshow, resolve, reject) {
				let that = this;
				if (that.pageStatues != 1) {
					console.log('已经离开定位界面')
					return
				}
				let retryCount = 0;
				const maxRetries = 3;
				// 提取扫描函数
				function startScanning(thatInstance) {
					console.log('into start scan', that.pageStatues);

					if (that.pageStatues === 1) {
						return new Promise((scanResolve) => {
							if (thatInstance.startDiscover) {
								clearTimeout(thatInstance.startDiscover);
							}
							thatInstance.startDiscover = setTimeout(() => {
								thatInstance.startBluetoothDeviceDiscovery();
								scanResolve({
									type: 'scan',
									success: true,
									message: '开始扫描设备'
								});
							}, 800);
						});
					} else {
						console.error('已经离开当前界面', that.pageStatues);
						return Promise.reject(new Error('已经离开当前界面，无法开始扫描'));
					}
				}
				async function tryOpen() {
					retryCount++;

					try {
						// 1. 打开蓝牙适配器
						const openResult = await new Promise((openResolve, openReject) => {
							uni.openBluetoothAdapter({
								success: openResolve,
								fail: openReject
							});
						});

						console.log('打开蓝牙适配器成功，尝试第' + retryCount + '次');

						// 延迟一下，让适配器完全初始化
						await new Promise(r => setTimeout(r, 200));

						// 2. 检查蓝牙适配器状态
						let stateRes;
						try {
							stateRes = await new Promise((stateResolve, stateReject) => {
								uni.getBluetoothAdapterState({
									success: stateResolve,
									fail: stateReject
								});
							});

							console.log('蓝牙适配器状态:', stateRes);

							if (!stateRes.available) {
								// 如果不可用，可能是用户没打开蓝牙
								if (isshow) {
									uni.showToast({
										icon: 'none',
										title: '请检查蓝牙是否已打开'
									});
								}
								throw new Error('蓝牙适配器不可用');
							}
						} catch (stateErr) {
							console.log('获取蓝牙适配器状态失败:', stateErr);
							// 状态获取失败，但可能已经打开，继续执行
							if (isshow) {
								uni.showToast({
									icon: 'none',
									title: '蓝牙状态获取失败，继续尝试...'
								});
							}
						}
						that.bluetoothAdapterAvailable = 2
						// 3. 停止之前的操作
						// that.stopBluetoothOperations();
						that.checkWifiIsSet();
						// 延迟一下，确保之前的操作完全停止
						await new Promise(r => setTimeout(r, 300));

						// 4. 检查是否已经有在扫描的设备
						console.log('that.blueToothDeviceId', that.blueToothDeviceId, that.pageStatues);

						let finalResult;

						// if (that.blueToothDeviceId && that.pageStatues === 1 && plus.os.name === 'Android') {
						// 	// 尝试重新连接已知设备
						// 	try {
						// 		console.log('尝试重新连接已知设备:', that.blueToothDeviceId);
						// 		// 等待连接结果
						// 		const connectResult = await that.connectAndLocate(that.blueToothDeviceId);
						// 		console.log('connectAndLocate 成功返回:', connectResult);

						// 		finalResult = {
						// 			type: 'reconnect',
						// 			success: true,
						// 			deviceId: that.blueToothDeviceId,
						// 			connectData: connectResult,
						// 			message: '设备重连成功',
						// 			timestamp: Date.now()
						// 		};

						// 	} catch (connectError) {
						// 		console.log('重连失败:', connectError);

						// 		// 重连失败，开始扫描新设备
						// 		const scanResult = await startScanning(that);

						// 		finalResult = {
						// 			...scanResult,
						// 			reconnectFailed: true,
						// 			reconnectError: connectError,
						// 			message: '设备重连失败，开始扫描新设备'
						// 		};
						// 	}
						// } else {
							// 直接开始扫描新设备
							console.log('开始扫描新设备')
							const scanResult = await startScanning(that);
							finalResult = scanResult;
						// }
						// 5. 将最终结果传递给外层 resolve
						resolve(finalResult);

					} catch (err) {
						console.log('打开蓝牙适配器失败，尝试第' + retryCount + '次:', err);
						if (retryCount < maxRetries) {
							// 指数退避重试
							const delay = Math.min(500 * Math.pow(2, retryCount), 2000);
							console.log('将在' + delay + 'ms后重试');
							await new Promise(r => setTimeout(r, delay));
							await tryOpen();
						} else {
							let errorMsg = '没连上蓝牙';

							if (err.code === 10001) {
								errorMsg = '蓝牙未打开，请在设置中打开蓝牙';
							} else if (err.code === 10004) {
								errorMsg = '没有蓝牙权限，请授权蓝牙权限';
							} else if (err.code === 10000) {
								errorMsg = '蓝牙初始化异常，请重启应用';
							}

							if (isshow && that.pageStatues === 1) {
								uni.showToast({
									icon: 'none',
									title: errorMsg
								});
								// 如果是权限问题，引导用户去设置
								if (err.code === 10004) {
									setTimeout(() => {
										that.showBluetoothPermissionGuide();
									}, 1500);
								}
								that.checkWifiIsSet();
							}
							reject({
								success: false,
								error: err,
								message: errorMsg,
								retryCount: retryCount
							});
						}
					}
				}

				// 开始尝试打开
				tryOpen();
			},

			/**
			 * 开始蓝牙设备发现
			 */
			startBluetoothDeviceDiscovery() {
				let that = this;
				console.log('开始蓝牙设备搜索');
				// 创建停止搜索的Promise，带超时控制
				const stopPromise = new Promise((resolve) => {
					let isResolved = false;

					// 设置超时（如果停止操作卡住，300ms后强制继续）
					const timeoutId = setTimeout(() => {
						if (!isResolved) {
							console.log('停止操作超时，强制继续');
							isResolved = true;
							resolve(false); // 超时返回false
						}
					}, 300);

					// 尝试停止搜索
					uni.stopBluetoothDevicesDiscovery({
						success: () => {
							if (!isResolved) {
								clearTimeout(timeoutId);
								console.log('停止搜索成功');
								isResolved = true;
								resolve(true); // 成功返回true
							}
						},
						fail: (err) => {
							if (!isResolved) {
								clearTimeout(timeoutId);
								console.log('停止搜索失败:', err);
								isResolved = true;
								resolve(false); // 失败返回false
							}
						}
					});
				});

				// 无论停止操作结果如何，都执行开始搜索
				stopPromise.finally(() => {
					// 等待一个短时间确保稳定性
					setTimeout(() => {
						console.log('执行蓝牙设备搜索');
						let allowDup = false
						// if (this.loadobject.serialCode.substring(0, 2) === 'ae')
						// 	allowDup = true
						uni.startBluetoothDevicesDiscovery({
							allowDuplicatesKey: allowDup,
							interval: 500,
							success: (res) => {
								console.log('蓝牙搜索成功启动');
								that.searchBluetoothLogo = true;
							},
							fail: (err) => {
								console.log('蓝牙搜索启动失败:', err);
								that.searchBluetoothLogo = false;

								// 错误提示
								if (err.code === 10004 || err.errMsg.includes('permission')) {
									uni.showToast({
										title: '蓝牙权限未开启',
										icon: 'none'
									});
								} else if (err.code === 10001) {
									uni.showToast({
										title: '蓝牙未开启',
										icon: 'none'
									});
								}
							}
						});
					}, 100); // 100ms延迟确保操作顺序
				});
			},
			/**
			 * 连接并定位
			 */
			async connectAndLocate(deviceId) {
				let that = this;

				// 先检查是否已经在连接
				if (this.bluetoothConnect) {
					console.log('已经在连接状态，跳过重复连接');
					return {
						success: true,
						status: 'already_connected',
						message: '已在连接状态'
					};
				}
				
				try {
					// 标记为正在连接
					// this.bluetoothConnect = true;
					if(this.tryConnectBluetooth===true)
					{
						console.log('已经在尝试连接...')
						return {
							success: true,
							status: 'connecting',
							message: '已经在尝试连接'
						};
					}
					console.log('尝试连接蓝牙中')
					this.tryConnectBluetooth=true
					const result = await this.openLocate(deviceId);
					
					console.log('连接成功返回');
					// 返回连接成功的详细数据
					return {
						success: true,
						status: 'connected',
						deviceId: deviceId,
						data: result,
						message: '设备连接成功'
					};

				} catch (error) {
					console.error('连接设备失败:', error);
					this.bluetoothConnect = false; // 只在失败时清除
					this.tryConnectBluetooth=false
					// 连接失败，尝试重新扫描
					if (this.reconnectAttempts < this.maxReconnectAttempts) {
						setTimeout(() => {
							if (that.pageStatues === 1) {
								that.startBluetoothDeviceDiscovery();
							}
						}, 1000);
					}

					// 抛出错误信息对象
					throw {
						success: false,
						status: 'connect_failed',
						deviceId: deviceId,
						error: error,
						message: error.message || '连接失败'
					};
				}
			},

			/**
			 * 打开定位
			 */
			openLocate(deviceId) {
				return new Promise((resolve, reject) => {
					uni.createBLEConnection({
						deviceId: deviceId,
						timeout: 10000,
						success: (res) => {
							this.tryConnectBluetooth=false
							console.log("蓝牙连接成功", deviceId)
							// 停止扫描
							uni.stopBluetoothDevicesDiscovery({
								success: (stopRes) => {
									console.log('停止蓝牙搜索成功');
									resolve(res);
								},
								fail: (stopErr) => {
									console.log('停止搜索失败，但连接成功');
									resolve(res);
								}
							});
						},
						fail: (res) => {
							this.tryConnectBluetooth=false
							console.log('蓝牙连接失败:', res);
							if (res.code === 10010 || res.code === -1) {
								console.log("蓝牙可能已经连接");
								resolve(res);
							} else if (res.code === 10012) {
								reject(new Error('连接超时'));
							} else {
								reject(res);
							}
						}
					});
				});
			},

			/**
			 * 蓝牙发送心跳
			 */
			bluetoothSendHeart() {
				const heart = new Uint8Array(1);
				heart[0] = 0x21;
				let writetype = plus.os.name !== 'Android' ? 'write' : 'writeNoResponse';

				let that = this;
				uni.writeBLECharacteristicValue({
					deviceId: that.blueToothDeviceId,
					serviceId: that.blueToothServiceId,
					characteristicId: that.blueToothCharacteristicId,
					value: heart,
					writeType: writetype,
					success(res) {
						console.log('写入心跳成功');
						that.blueToothHeartCnt = 0;
					},
					fail(err) {
						console.log('写入心跳失败', err);
						that.blueToothHeartCnt++;
						if (that.blueToothHeartCnt > 1) {
							that.restartBlueTooth(true)
						}
					}
				});
			},

			// ==================== 其他方法 ====================

			/**
			 * 清理资源
			 */
			cleanupResources() {
				try {
					clearInterval(this.countdownTimer);
					clearInterval(this.checkBluetoothAdapterIntervel);
					clearInterval(this.intervalId2);
					clearInterval(this.intervalLocate);
					clearInterval(this.blinkInterval);
					clearInterval(this.intervaldoBgTask);
					getApp().globalData.openLadarBluetooth = false;
					getApp().globalData.blebluetoothConnect = false;
					this.removeBluetoothListeners();
					this.stopBluetoothOperations()
					uni.closeBluetoothAdapter({
						success(res) {
							console.log('关闭蓝牙模块', res);
						}
					});
					if (this.reconnectTimer) {
						clearTimeout(this.reconnectTimer);
					}
					if (this.startDiscover) {
						clearTimeout(this.startDiscover);
					}
					if (this.wid) {
						plus.geolocation.clearWatch(this.wid);
						this.wid = null;
					}
					if (this.locationTimer) {
						clearInterval(this.locationTimer);
						this.locationTimer = null;
					}
					this.unpdataUserPosition = false;
					uni.offCompassChange(this.initCompass ? this.initCompass : function() {});
					uni.$off("update");
					uni.$off('closeLead');
					uni.$off("petIcon");
					uni.$off("presentBattary");
					// uni.$off('app-logout-cleanup')
				} catch (error) {
					console.log('清理资源报错', error)
				}

			},

			/**
			 * 清理定时器
			 */
			cleanupTimers() {
				clearInterval(this.countdownTimer);
				clearInterval(this.checkBluetoothAdapterIntervel);
				clearInterval(this.intervalId2);
				clearInterval(this.intervalLocate);
				if (this.wid) {
					plus.geolocation.clearWatch(this.wid);
					this.wid = null;
				}
			},

			/**
			 * 启动定时任务
			 */
			startIntervalTasks() {
				let cnt = 0;
				let that = this;

				this.checkBluetoothAdapterIntervel = setInterval(() => {
					// 计算倒计时
					if (this.locateTime && this.locateTime.length != 5) {
						const now = new Date();
						const target = new Date(this.locateTime);
						const diff = now - target;
						let clocktime = Math.floor(diff / 1000) + 1;

						if (clocktime > 3600 * 24) {
							clocktime = Math.floor(clocktime / 3600 / 24);
							this.loacateClock = '请求中';
						} else if (clocktime > 1800) {
							clocktime = Math.floor(clocktime / 3600);
							this.loacateClock = '定位中';
						} else if (clocktime > 300) {
							clocktime = Math.floor(clocktime / 3600);
							this.loacateClock = '等待中';
						} else if (clocktime > 60) {
							clocktime = Math.floor(clocktime / 60);
							this.loacateClock = '获取中';
						} else if (clocktime > 0) {
							this.loacateClock = clocktime.toString() + '秒前';
						}

						if (this.locateTime === -1) {
							this.loacateClock = '';
						}
					}

					// // 定期任务
					// if (cnt % 17 === 0) {
					// 	this.getPetPositionNew(this.loadobject, false, false);
					// }
					// if (cnt % 7 === 0 && that.loadobject.serialCode.substring(0, 2) === 'ae') {
					// 	const timeSinceLastSeen = Date.now() - this.catScanTimer;
					// 	// 超过30秒没扫描到，认为设备离开
					// 	if (timeSinceLastSeen > this.catLostTimeout) {
					// 		console.log('进入超时断开连接')
					// 		this.bluetoothConnect = false
					// 	}
					// }

					if (cnt % 33 === 0 && !this.railToast) {
						this.checkRail();
					}

					if (cnt % 15 === 0) {
						if (that.bluetoothConnect) {
							that.bluetoothSendHeart();
						}
					}

					if (cnt % 121 === 0) {
						// if (this.stopLadarToast) {
						// 	this.sendLocateMode(this.loadobject.serialCode, 1);
						// } else {
							this.reFresh();
						// }
					}

					if (cnt % 20 === 0) {
						this.getWorkModeNew(this.loadobject.serialCode)
						if (that.sureleading) {
							if (that.bluetoothConnect) {
								that.leadOutCnt = 0;
								that.petDistanceOver = false;
								getApp().globalData.leadOut = false;
							} else {
								that.leadOutCnt++;
								if (that.leadOutCnt === 5) {
									console.log('宠物出牵引范围');
									that.petDistanceOver = true;
									getApp().globalData.leadOut = true;
									that.savePage();
									uni.createPushMessage({
										title: '电子牵引',
										content: '宠物已经跑出牵引范围',
										success() {
											console.log('createPushMessage 成功');
										},
										fail(err) {
											console.log('createPushMessage 失败', err);
										}
									});
								}
							}
						}
					}

					// if (cnt % 40 === 0) {
					// 	this.getDeviceConnectModol();
					// }

					cnt++;
				}, 500);
			},

			/**
			 * 启动位置监听
			 */
			startLocationWatch() {
				let that = this;
				this.wid = plus.geolocation.watchPosition(
					function(res) {
						if (that.widcnt > 30000) {
							that.widcnt = 0;
						}
						if (that.widcnt % 10 === 0) {
							let pos = wgs84_to_gcj02(res.coords.longitude, res.coords.latitude);
							that.phonelocation(pos[1], pos[0]);
						}
						that.widcnt++;
					},
					function(e) {
						console.log('监听位置变化信息失败：' + e.message);
					}, {
						enableHighAccuracy: true,
						geocode: false
					}
				);
			},
			startLocationUpdate() {
				let that = this;
				if (this.locationTimer) {
					clearInterval(this.locationTimer);
					this.locationTimer = null;
				}
				// 使用定时获取，避免监听不触发的问题
				this.locationTimer = setInterval(() => {
					plus.geolocation.getCurrentPosition(
						(res) => {
							// 检查精度
							let pos = wgs84_to_gcj02(res.coords.longitude, res.coords.latitude);
							that.phonelocation(pos[1], pos[0]);
							that.lastValidLocation = {
								lat: pos[1],
								lng: pos[0],
								accuracy: res.coords.accuracy,
								time: Date.now()
							};
						},
						(e) => {
							console.log('定时获取位置失败:', e.message);
							// 如果有上次有效位置且未过期（5分钟内），继续使用
							if (that.lastValidLocation &&
								(Date.now() - that.lastValidLocation.time < 300000)) {
								that.phonelocation(that.lastValidLocation.lat, that.lastValidLocation.lng);
							}
						}, {
							enableHighAccuracy: false, // 室内推荐使用false
							timeout: 10000,
							maximumAge: 30000
						}
					);
				}, 10000); // 每10秒获取一次
			},
			/**
			 * 设置事件监听器
			 */
			setupEventListeners() {
				let that = this;

				uni.onCompassChange(this.initCompass);

				uni.$once("petIcon", function(data) {
					console.log('收到合并好的图片路径', data);
					if (data.pid === that.loadobject.pid) {
						that.loadobject.petIcon = data.petIcon;
						that.petAvatar=data.petIcon;
					}
				});

				uni.$once('presentBattary', function(data) {
					console.log('接受到电量变化', data);
					that.loadobject.presentBattary = getApp().globalData.presentBattary;
					that.loadobject.battaryImageSrc = getApp().globalData.battaryImageSrc;
				});
			},
			// ==================== 原有方法保持不变 ====================
			// 这里保留了原有的所有方法，但为了简洁只列出了方法名
			// 实际代码中需要包含这些方法的完整实现

			async checkPermission() {
				try {
					let that = this
					if (plus.os.name === 'iOS') {
						const status = await util.checkIOSLocationPermissionComprehensive();
						console.log('权限状态:', status);

						if (!status.hasPermission) {
							if (status.needRequest) {
								// 尝试请求权限（会自动弹出系统弹窗）
								uni.getLocation({
									type: 'wgs84',
									success: () => {
										console.log('授权成功');
									},
									fail: () => {
										util.showIOSPermissionGuide();
									}
								});
							} else {
								util.showIOSPermissionGuide();
							}
						}
					}
				} catch (error) {
					console.log("permission", error)
				}

			},

			closeOfflineTitle(para) {
				if (para) {
					this.pageStatues = 0;
					uni.navigateTo({
						url: '/pages/setting/service/service'
					})
				} else
					this.showOfflineTitle = false
			},

			clickOffline() {
				this.showOfflineTitle = true
			},
			setStyle() {
				console.log('this.platform ', this.platform)
				this.WindowInfo.pixelRatio = this.WindowInfo.screenWidth / 750
				let pixelRatio = this.WindowInfo.pixelRatio
				if (this.platform === 'iOS') {
					console.log('当前是 iOS 平台');
					this.topType = {
						top: this.marginTopHeight.toString() + 'px'
					}
					this.countdownTopType = {
						// top: (this.marginTopHeight - 190).toString() + 'px',
						top: (this.marginTopHeight - 383 * pixelRatio).toString() + 'px',
						width: this.screenwidth + 'px'
					}
					this.let_right_bottom = this.marginTopHeight - 240 * pixelRatio - 380 * pixelRatio
					console.log('this.let_right_bottom', this.let_right_bottom, this.marginTopHeight)
				} else if (this.platform === 'Android') {
					console.log('当前是 Android 平台');
					this.topType = {
						margin: (this.marginTopHeight.toString()) + 'px 0px 0px 0px'
					}
					this.countdownTopType = {
						// margin: (this.marginTopHeight - 360 * pixelRatio).toString() + 'px 0px 0px 0px',
						width: this.screenwidth + 'px',
						bottom: 270 + 'rpx'
					}
					this.let_right_bottom = this.marginTopHeight - 500 * pixelRatio
					// this.let_right_bottom =350
					console.log('this.marginTopHeight', this.marginTopHeight / pixelRatio, this.let_right_bottom)
					this.mapviz = true;
				}
			},

			addlocateGuild() {
				this.guildImageClickCnt++
				this.GuildSrc = '/static/imgs/locate/locateGuild' + this.guildImageClickCnt.toString() + '.png'
				console.log('this.GuildSrc', this.GuildSrc)
				if (this.guildImageClickCnt === 8) {
					this.isShowGuild = 8
					//第一次进入，没触发重启蓝牙，点击完引导后主动触发一次
					this.restartBlueTooth(true)
					this.moveToPet()
					uni.setStorageSync("isGuild", this.isShowGuild)
				}
