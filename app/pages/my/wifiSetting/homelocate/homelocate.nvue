			stopBluetooth(cb) {
				console.log('进入stopBluetooth')
				uni.closeBLEConnection({
					deviceId: this.blueToothDeviceId,
					success() {
						console.log('断开蓝牙成功')
					}
				})
				uni.stopBluetoothDevicesDiscovery({
					success(res) {
						console.log('停止蓝牙搜索')
					}
				})
				let that = this
				uni.closeBluetoothAdapter({
					success(res) {},
					complete(res) {
						console.log('关闭蓝牙模块', res);
						that.connectCnt = 0
						getApp().globalData.blebluetoothConnect = false
						cb & cb()
					}
				})
			},
			restartBluetooth() {
				console.log('into restart bluetooth')
				let that = this
				that.readFailCnt = 0
				this.stopBluetooth(() => {
					uni.openBluetoothAdapter({
						success(res) {
							console.log('打开蓝牙模块', res);
							that.bluetoothOpening = true
							uni.startBluetoothDevicesDiscovery({
								allowDuplicatesKey: true,
								success: resd => {
									console.log('wifi打开蓝牙搜索成功')
								},
								fail: errd => {
									console.log('wifi打开蓝牙搜索失败', errd)
								}
							})
						},
						fail(e) {
							console.log('打开蓝牙适配失败', e)
							uni.showModal({
								title: "温馨提示",
								content: "打开蓝牙将获得更好的体验"
							})
							// this.titleContent='打开蓝牙将获得更好的体验'
							that.bluetoothConnect = false
							that.bluetoothOpening = false
						}
					})
				})

			},
			callbackBluetoothData(byteBuffer) {
				let that = this
				if (that.communciateType[0] != byteBuffer[0]) {
					//重新写上一条命令
					console.log('重写一条', that.communciateType[0])
					that.BleWrite(that.communciateType).then((success) => {
						if (success) {
							console.log('写入成功');
							// 可以在这里进行其他操作，比如更新UI等  
						}
					}).catch((failure) => {
						if (failure) {
							console.log('写入失败');
							// 可以在这里处理失败的情况，比如显示错误消息等  
						}
					});
					return
				}
				console.log('into callback', byteBuffer)
				if (byteBuffer[0] === 0x10) {
					switch (byteBuffer[1]) {
						case 1:
							console.log("扫描中...");
							let command = fileParse.getStartWiFiScanStatus()
							that.BleWrite(command).then((success) => {
								if (success) {
									console.log('写入成功');
									// 可以在这里进行其他操作，比如更新UI等  
								}
							}).catch((failure) => {
								if (failure) {
									console.log('写入失败');
									// 可以在这里处理失败的情况，比如显示错误消息等  
								}
							});
							break;
						default:
							console.log("启动中...");
							//0.5秒后再次查询第一步
							setTimeout(() => {
								let command = fileParse.getStartWiFiScanStatus()
								that.BleWrite(command).then((success) => {
									if (success) {
										console.log('写入成功');
										// 可以在这里进行其他操作，比如更新UI等  
									}
								}).catch((failure) => {
									if (failure) {
										console.log('写入失败');
										// 可以在这里处理失败的情况，比如显示错误消息等  
									}
								});
							}, 200)
							break;
					}
				} else if (byteBuffer[0] === 0x11) {
					switch (byteBuffer[1]) {
						case 0:
							console.log("没触发scan");
							setTimeout(() => {
								let command = fileParse.getStartWiFiScanStatus()
								that.BleWrite(command).then((success) => {
									if (success) {
										console.log('写入成功');
										// 可以在这里进行其他操作，比如更新UI等  
									}
								}).catch((failure) => {
									if (failure) {
										console.log('写入失败');
										// 可以在这里处理失败的情况，比如显示错误消息等  
									}
								});
							}, 200)
							break;
						case 1:
							console.log("扫描启动中");
							setTimeout(() => {
								let command = fileParse.getStartWiFiScanStatus()
								that.BleWrite(command).then((success) => {
									if (success) {
										console.log('写入成功');
										// 可以在这里进行其他操作，比如更新UI等  
									}
								}).catch((failure) => {
									if (failure) {
										console.log('写入失败');
										// 可以在这里处理失败的情况，比如显示错误消息等  
									}
								});
							}, 200)
							break;
						case 2:
							console.log("正在扫描");
							setTimeout(() => {
								let command = fileParse.getStartWiFiScanStatus()
								that.BleWrite(command).then((success) => {
									if (success) {
										console.log('写入成功');
										// 可以在这里进行其他操作，比如更新UI等  
									}
								}).catch((failure) => {
									if (failure) {
										console.log('写入失败');
										// 可以在这里处理失败的情况，比如显示错误消息等  
									}
								});
							}, 500)
							break;
						case 3:
							console.log("扫描结束，正在加载");
							that.wifiCount = byteBuffer[2]
							console.log('扫描的mac数量为', that.wifiCount)
							//进行下一步 获得数量后一个一个查询
							that.setWiFiList(that.wifiCount)
							that.checkWiFiList()
							break;
						case 15:
							console.log("扫描失败，请稍后重试");
							clearInterval(this.intervalId)
							this.intervalId = null
							setTimeout(() => {
								that.freshing = false
								that.reFresh(150)
							}, 150)
							break;
					}
				} else if (byteBuffer[0] === 0x12) {
					switch (byteBuffer[1]) {
						case 0:
							console.log("查询错误，超过范围");
							setTimeout(() => {
								that.freshing = false
								that.reFresh(150)
							}, 150)
							// //从新查询这一条
							// setTimeout(()=>{
							// 	that.checkWiFiList()
							// },200)
							break;
						default:
							console.log("加载中...");
							//把mac和ssid长度存下来 我需要一个list存放所有的对象
							that.setWifiItem(byteBuffer)
							that.checkWiFiList()
							break
					}
				} else if (byteBuffer[0] === 0x13) {
					switch (byteBuffer[1]) {
						case 0:
							console.log("查询错误，ssid超过范围");
							setTimeout(() => {
								that.freshing = false
								that.reFresh(150)
							}, 150)
							//从新查询这一条
							// setTimeout(()=>{
							// 	that.checkWiFiList()
							// },200)
							break;
						default:
							console.log("加载中...");
							//ssid存下来 我需要一个list存放所有的对象
							that.setWifiItem(byteBuffer)
							that.checkWiFiList()
							//查询下一条
							break;
					}
				}
			},
			setWifiItem(buff) {
				try {
					console.log('into setWifiItem', buff)
					console.log('this.downLoadingWifiList 0', this.downLoadingWifiList)
					let index = buff[1] - 1
					if (buff[0] === 0x12) {
						let ssidlength = buff[9]

						let int8Array = new Int8Array(1); // 创建一个长度为1的Int8Array  
						int8Array[0] = buff[8]; // 尝试将uint8Value赋给int8Array的第一个元素  
						let rssi = int8Array[0]
						// 但实际上，由于uint8Value超出了Int8的正数范围，它会被自动转换为对应的负数  
						let mac = ''
						const hexArr = Array.prototype.map.call(
							new Uint8Array(buff),
							function(bit) {
								return ('00' + bit.toString(16)).slice(-2)
							}
						)
						mac = hexArr[2] + ':' + hexArr[3] + ':' + hexArr[4] + ':' + hexArr[5] + ':' + hexArr[6] + ':' +
							hexArr[7]
						this.downLoadingWifiList[index].mac = mac
						this.downLoadingWifiList[index].rssi = rssi
						this.downLoadingWifiList[index].ssidlength = ssidlength
					} else if (buff[0] === 0x13) {
						let ssid = ''
						let ss1_ss2 = buff[2]
						let namearray = buff.slice(3, buff.length - 1)
						console.log('namearray', namearray)
						ssid = fileParse.bytesToUtf8String(namearray)
						console.log('ssid', ssid)
						if (ss1_ss2 === 1) {
							this.downLoadingWifiList[index].ssid1 = ssid
						} else if (ss1_ss2 == 2) {
							this.downLoadingWifiList[index].ssid2 = ssid
						}
					}
				} catch (e) {
					console.log('set wifi item error', e)
				}

			},
			setWiFiList(count) {
				this.downLoadingWifiList = new Array;
				for (let i = 0; i < count; i++) {
					this.downLoadingWifiList[i] = {
						ssid1: '',
						ssid2: '',
						mac: '',
						rssi: 0,
						ssidlength: 0,
						wifi_location: {
							la: '',
							lo: ''
						}
					};
				}
			},
			mergeWifiList(listA, listB) {
				for (let i = 0; i < listB.length; i++) {
					let find = false
					for (let j = 0; j < listA.length; j++) {
						if (listB[i].wifi_mac === listA[j].wifi_mac) {
							console.log('发现一个重复mac', listB[i].wifi_mac)
							find = true
						}
					}
					if (!find) {
						let item = listB[i]
						listA.push(item)
					}
				}
				console.log('合并前', listA)
				try {
					for (let i = 0; i < listA.length - 1; i++) { // 减少一次外层循环，因为每次至少一个元素会被放到正确的位置
						for (let j = 0; j < listA.length - i - 1; j++) { // 确保 j+1 不会越界
							if (listA[j].strength < listA[j + 1].strength) {
								let item = listA[j];
								listA[j] = listA[j + 1];
								listA[j + 1] = item;
							}
						}
					}
				} catch (e) {
					console.log('merge err', e)
				}

				console.log('合并后', listA)
				return listA
			},
			checkWiFiList() {
				let that = this
				for (let i = 0; i < this.downLoadingWifiList.length; i++) {
					if (this.downLoadingWifiList[i].mac === '') {
						//查询这个mac
						let command = fileParse.getWiFiData(i + 1)
						that.BleWrite(command).then((success) => {
							if (success) {
								console.log('写入成功');
								// 可以在这里进行其他操作，比如更新UI等  
							}
						}).catch((failure) => {
							if (failure) {
								console.log('写入失败');
								// 可以在这里处理失败的情况，比如显示错误消息等  
							}
						});
						return
					}
					// else if (this.downLoadingWifiList[i].ssidlength > 0 && this.downLoadingWifiList[i].ssid1 === '' &&
					// 	this.downLoadingWifiList[i].ssidlength < 16) {
					// 	//查询ssid前半
					// 	let command = fileParse.getWiFiSsid(i + 1, 1)
					// 	that.BleWrite(command).then((success) => {
					// 		if (success) {
					// 			console.log('写入成功');
					// 			// 可以在这里进行其他操作，比如更新UI等  
					// 		}
					// 	}).catch((failure) => {
					// 		if (failure) {
					// 			console.log('写入失败');
					// 			// 可以在这里处理失败的情况，比如显示错误消息等  
					// 		}
					// 	});
					// 	return
					// } 
					// else if (this.downLoadingWifiList[i].ssidlength > 16 && (this.downLoadingWifiList[i].ssid1 === '' ||
					// 		this.downLoadingWifiList[i].ssid2 === '')) {
					// 	//查询ssid后半
					// 	let command = fileParse.getWiFiSsid(i + 1, 1)
					// 	if (this.downLoadingWifiList[i].ssid1 === '') {
					// 		command = fileParse.getWiFiSsid(i + 1, 1)
					// 	} else if (this.downLoadingWifiList[i].ssid2 === '') {
					// 		command = fileParse.getWiFiSsid(i + 1, 2)
					// 	}

					// 	that.BleWrite(command).then((success) => {
					// 		if (success) {
					// 			console.log('写入成功');
					// 			// 可以在这里进行其他操作，比如更新UI等  
					// 		}
					// 	}).catch((failure) => {
					// 		if (failure) {
					// 			console.log('写入失败');
					// 			// 可以在这里处理失败的情况，比如显示错误消息等  
					// 		}
					// 	});
					// 	return
					// }
				}
				//检查数据完毕
				this.showWiFiList = new Array()
				this.wifiMacList = new Array()
				for (let i = 0; i < this.downLoadingWifiList.length; i++) {
					let name = this.downLoadingWifiList[i].ssid1 + this.downLoadingWifiList[i].ssid2
					let item = {
						wifi_ssid: name,
						wifi_mac: this.downLoadingWifiList[i].mac,
						strength: this.downLoadingWifiList[i].rssi,
						wifi_location: {
							la: this.latitude,
							lo: this.longitude
						},
					}
					that.showWiFiList.push(item)
				}
				that.showWiFiList = this.mergeWifiList(that.showWiFiList, that.lastScanWifiList)
				that.lastScanWifiList = that.showWiFiList

				console.log('检查完毕', that.showWiFiList)
				uni.hideLoading()
				this.freshing = false
				this.maxSsid = this.showWiFiList[0].strength - this.getHomeWifiInterval
				if (this.showWiFiList[0].strength < this.getHomeWifiInterval) {
					this.showProgressTitle = true
					this.ssidText = '差'
					this.clickSureChange = false
					this.reFresh(150)
				} else {
					this.ssidText = '优'
					this.showMessage('wifi扫描完成，可以点击确认保存配置')
				}
				if (this.clickSureChange) {
					this.sureChange()
				}
				clearInterval(this.intervalId)
				this.intervalId = null
				plus.nativeUI.closeWaiting();
			},
			BleRead() {
				console.log('into read')
				let Time = new Date();
				let timestemp = Time.getTime();
				let that = this
				uni.readBLECharacteristicValue({
					deviceId: this.blueToothDeviceId, // 蓝牙设备 deviceId
					serviceId: "0000FFE0-0000-1000-8000-00805F9B34FB", // 蓝牙服务uuid
					characteristicId: "0000FFE1-0000-1000-8000-00805F9B34FB",
					success(res) {
						let Time2 = new Date();
						let timestemp2 = Time2.getTime() - timestemp;
						console.log('我读一个信息时间', timestemp2);
					},
					fail(res) {
						console.log('readBLECharacteristicValue fail:', res)
						setTimeout(() => {
							if (that.bluetoothConnect)
								that.BleRead()
							that.readFailCnt++
							if (that.readFailCnt >= 10)
								that.checkBluetoothAdapter()
						}, 100)
					},
					complete(res) {
						console.log('read complete', res);
					}
				})
			},
			async BleWrite(instruction) {
				return new Promise((resolve, reject) => {
					try {
						let that = this;
						let writetype = 'writeNoResponse';
						if (plus.os.name != 'Android') {
							writetype = 'write';
						}
						this.communciateType = instruction;
						console.log('写入内容', this.communciateType, that.serviceId, that.blueToothDeviceId);
						uni.writeBLECharacteristicValue({
							deviceId: that.blueToothDeviceId, // 蓝牙设备 deviceId  
							serviceId: "0000FFE0-0000-1000-8000-00805F9B34FB", // 蓝牙服务uuid  
							characteristicId: "0000FFE1-0000-1000-8000-00805F9B34FB", // 蓝牙特征值的 (即 writeId)  
							value: instruction, // 这里的value是ArrayBuffer类型  
							writeType: writetype,
							success(res) {
								console.log('写入指令发送成功', res);
								setTimeout(() => {
									that.BleRead();
								}, 500);
								resolve(true); // 写入成功，返回true  
							},
							fail(err) {
								console.log('写入指令发送失败', err);
								//发送失败的情况 蓝牙断开  
								//如果蓝牙断开 就显示一下然后关闭fresh状态  
								if (err.code === 10004) {
									that.bluetoothConnect = false
								}
								if (!that.bluetoothConnect) {
									// uni.showToast({
									// 	title: '蓝牙连接断开了',
									// 	icon: 'loading' // 注意：这里应该是字符串'loading'，而不是变量Loading  
									// });
									that.freshing = false;
								}

								reject(false); // 写入失败，返回false  
							},
							complete(c) {
								console.log('接口调用结束', c);
							}
						});
					} catch (e) {
						console.log('err', e);
						reject(false); // 发生错误，返回false  
					}
				});
			},
			returnParent() {
				getApp().backParents();
			},
			scanWifi() {
				console.log('into scan wifi')
				this.scanwificnt++
				let command = fileParse.getStartWiFiScan()
				this.BleWrite(command).then((success) => {
					if (success) {
						console.log('写入成功');
						if (!this.freshing) {
							let cnt = 1
							this.intervalId = setInterval(() => {
								cnt++
								if (cnt > 144) {
									//扫描超时
									this.freshing = false
									// clearInterval(this.intervalId)
									// this.closeHelp()
								}
								this.ladarRotateAngle += 40;
								if (this.ladarRotateAngle >= 360)
									this.ladarRotateAngle = 0;
							}, 200)
							this.freshing = true
						}
					} else {
						console.log('写入失败', command)
					}
				}).catch((failure) => {
					if (failure) {
						console.log('写入失败');
						// 可以在这里处理失败的情况，比如显示错误消息等  
					}
				});
			},
			reFresh(time) {
				console.log('into refresh', this.bluetoothConnect)
				if (this.bluetoothConnect) {
					if (!this.freshing) {
						this.scanWifi()
						setTimeout(() => {
							this.showMessage('正在扫描附近WiFi')
						}, 2000)
					} else {
						this.showMessage('正在扫描附近WiFi')
					}
				} else {
					uni.showToast({
						title: "蓝牙未连接",
						icon: 'loading'
					})
					uni.showToast({
						title: "尝试重启蓝牙",
						icon: 'loading'
					})
					this.restartBluetooth()
					// if (this.bluetoothOpening === false) {
					// 	uni.showToast({
					// 		title: "尝试重启蓝牙",
					// 		icon: 'loading'
					// 	})
					// 	this.restartBluetooth()
					// }
					console.log('蓝牙未连接，连接后再刷新')
				}

			},
			sureChange() {
				this.clickSureChange = true
				let that = this
				if (this.showWiFiList.length > 0) {
					if (this.showWiFiList[0].strength < this.getHomeWifiInterval) {
						this.reFresh(150)
						return
					}
					let wifilis = new Array();
					this.wifiMacList = new Array()
					let strengthList = new Array()
					let length = this.showWiFiList.length
					if (length > 2)
						length = 2
					for (let i = 1; i < length; i++) {
						let mac = this.showWiFiList[i].wifi_mac
						let strength = this.showWiFiList[i].strength
						if (strength > this.getHomeWifiInterval) {
							this.wifiMacList.push(mac)
							strengthList.push(strength)
						}
					}
					let item = {
						version: 2,
						wifi_ssid: '家庭wifi',
						wifi_mac: this.showWiFiList[0].wifi_mac,
						strength: this.showWiFiList[0].strength,
						wifi_location: {
							la: this.center.la,
							lo: this.center.lo
						},
						wifi_macList: this.wifiMacList,
						wifi_strength: strengthList
					}
					wifilis.push(item)
					console.log('我点击了确认提交', wifilis)
					try {
						//把wifi和经纬度提交服务器
						let url = getApp().globalData.internet + getApp().globalData.setHomeWifi + '/' + this.serialCode;
						uni.request({
							url: url, //仅为示例，并非真实接口地址。
							method: 'POST',
							data: JSON.stringify(wifilis),
							header: {
								'Content-Type': 'application/json' //重点
							},
							success: (res) => {
								logger.info('require wifi list success', JSON.stringify(res))
								if (res.data.code === 200) {
									uni.showToast({
										title: '设置完成',
										icon: 'success'
									})
									setTimeout(() => {
										if (this.rute === "add") {
											uni.navigateBack({
												delta: 4
											});
										} else {
											this.returnParent()
										}
									}, 1000)
								} else {
									uni.showToast({
										icon: 'none',
										title: res.data.msg
									})
								}
							},
							fail: ((err) => {
								logger.info('require wifi list fail', JSON.stringify(err))
								uni.showToast({
									icon: 'none',
									title: "请求未成功，请稍后在试"
								})
							})
						});
					} catch (e) {
						console.log('提交异常', e)
					}
				} else {
					that.showMessage('正在保存当前点位请勿拖动地图')
					setTimeout(() => {
						if (that.bluetoothConnect === true) {
							that.showMessage('正在获取数据，请不要离开')
						}
					}, 5000)
					// this.closeHelp()
				}
			},
			showMessage(text) {
				if (this.showProgressTitle) {
					if (text === '正在扫描附近WiFi') {
						this.titleContent = text + ',请将设备移动到信号源附近'
					} else {
						this.titleContent = text
					}
				} else {
					uni.hideLoading()
					if (getApp().globalData.settingWifiBluetooth)
						uni.showLoading({
							title: text,
						});
				}
			},
			regionchange() {
				let that = this
				this._mapContext.getScale({
					success: (res) => {
						// console.log('获取缩放尺度',res)
						let index = Math.trunc(res.scale) - 3
						// console.log('index',index)
						that.scaleShow = that.scaleArray[index]
						// console.log('that.mapScale',that.scaleShow)
					},
					fail: (err) => {

					}
				})
				this._mapContext.getCenterLocation({
					success: function(res) {
						// console.log('res.longitude', res.longitude);
						// console.log('res.latitude', res.latitude);
						that.center.la = res.latitude
						that.center.lo = res.longitude
						//根据经纬度获取详细地理名
						let str =
							'https://restapi.amap.com/v3/geocode/regeo?key=9f8eb22902ff76102e32ba52c7dee1e6&radius=2000&extensions=all&batch=false&roadlevel=0&location=' +
							res.longitude + ',' + res.latitude
						uni.request({
							url: str,
							data: {},
							method: 'GET',
							success: res => {
								this.toMapping = false;
								// console.log('res.data.', res)
								if (res.data.status === '1') {
									if (res.data.regeocode.pois.length > 0) {
										// var name = res.data.regeocode.roads[0].name;
										var pois = res.data.regeocode.pois;
										var item = pois[0];
										for (var i = 1; i < pois.length; i++) {
											if (parseFloat(pois[i].distance) < parseFloat(item
													.distance)) {
												item = pois[i];
												// console.log('min distance', pois[i].distance, pois[
												// 	i].address)
											}
										}
										let name = item.name
										if (name.length > 18)
											name = name.substring(0, 15) + "...";
										that.locateName = name + '附近';
										// console.log('name', that.locateName);
										// console.log('res.data.regeocode.roads[0]', res.data)
									} else {
										uni.showToast({
											icon: 'none',
											title: '未找到地理位置'
										})
									}

								}
							},
							fail: res => {

								this.toMapping = false;
								console.log('获取标记位置失败', res);
								uni.showToast({
									icon: 'none',
									title: '未找到地理位置，可稍后重试'
								})
							},
						})
					},
					fail: function(err) {
						console.error(err);
					}
				});

			}
		}
	}
</script>

<style>
	@import "/assets/css/seetings-row.css";

	.map {

		flex: 1;
	}

	.scale-border {
		text-align: center;
		margin-top: 15px;
		height: 10%;
		border-bottom: 2px solid #0d0d0d;
		border-left: 2px solid #0d0d0d;
		border-right: 2px solid #0d0d0d;
	}

	.mask {
		position: fixed;
		bottom: 0;
		right: 0;
		left: 0;
		top: 0;
		z-index: 100;
		background-color: rgba(0, 0, 0, 0.6);
	}

	.drawtoast {
		display: flex;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		justify-content: center;
	}

	.myButton {
		width: 80px;
		background-color: rgba(255, 87, 51, 1);
		;
		border-radius: 25rpx;
		height: 40px;
		/* font-family: jinshan; */
	}

	.disabledButton {
		width: 80px;
		background-color: gray;
		border-radius: 25rpx;
		height: 40px;
		/* font-family: jinshan; */
		cursor: not-allowed;
		/* 禁止点击的鼠标指针样式 */
		pointer-events: none;
		/* 禁用所有指针事件，使按钮不可点击 */
	}

	.rotate-background {
		position: absolute;
		/* top: 20rpx; */
	}
</style>