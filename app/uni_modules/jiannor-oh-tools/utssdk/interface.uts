}

// 请求全局权限开关函数类型
// switchType: 0-相机，1-麦克风，2-位置
export type RequestGlobalSwitch = (switchType : number, options ?: RequestGlobalSwitchOptions) => void

// 位置服务状态变化回调结果
export type OnLocationEnabledChangeCallbackResult = {
	/**
	 * 位置服务是否启用
	 */
	enabled : boolean
	/**
	 * 错误信息
	 */
	errMsg ?: string
}

// 位置服务状态变化参数
export type OnLocationEnabledChangeOptions = {
	/**
	 * 成功回调
	 */
	success ?: (res : CommonCallbackResult) => void
	/**
	 * 失败回调
	 */
	fail ?: (res : any) => void
	/**
	 * 完成回调
	 */
