}

// 位置服务状态变化监听器函数类型
export type OnLocationEnabledChangeCallback = (result : OnLocationEnabledChangeCallbackResult) => void
export type OnLocationEnabledChangeErrorCallback = (result : CommonCallbackResult) => void

// 位置服务状态变化监听函数类型
export type OnLocationEnabledChange = (callback : OnLocationEnabledChangeCallback) => void
export type OffLocationEnabledChange = (callback ?: OnLocationEnabledChangeCallback) => void
export type OnLocationEnabledChangeError = (callback : OnLocationEnabledChangeErrorCallback) => void
export type OffLocationEnabledChangeError = (callback ?: OnLocationEnabledChangeErrorCallback) => void

// 检查位置服务是否启用参数
export type IsLocationEnabledCallbackResult = {
	/**
	 * 成功回调
	 */
	success ?: (res : boolean) => void
	/**
	 * 失败回调
	 */
