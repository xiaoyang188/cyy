			adjustZoomLevel(distance) {
				// 默认缩放级别 
				let zoomLevel = 4

				if (distance < 1000) { // 假设距离小于1000米时，使用较高缩放级别  
					zoomLevel = 17;
				} else if (distance < 5000) { // 假设距离在1000米到5000米之间  
					zoomLevel = 14;
				} else if (distance < 10000) {
					zoomLevel = 11;
				} else if (distance < 50000) {
					zoomLevel = 10;
				} else if (distance < 100000) {
					zoomLevel = 9;
				} else if (distance < 150000) {
					zoomLevel = 7;
				} else if (distance < 200000) {
					zoomLevel = 5;
				}
				// 根据需要继续添加更多的条件  
				return zoomLevel;
			},
